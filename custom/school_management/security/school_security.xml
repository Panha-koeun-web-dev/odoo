        <record id="rule_school_student_student" model="ir.rule">
            <field name="name">Student: Read Own Record Only</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_student'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_school_student_teacher" model="ir.rule">
