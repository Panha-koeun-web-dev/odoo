<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- PAPERFORMAT: Standard A4 Portrait for Payment Receipts   -->
    <!-- 210mm x 297mm, 10mm top/bottom, 12mm left/right margins   -->
    <!-- ========================================================= -->
    <record id="paperformat_student_receipt" model="report.paperformat">
        <field name="name">Student Payment Receipt (A4 Portrait)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="page_height">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- ========================================================= -->
    <!-- REPORT ACTIONS: Year Payment, Single Fee, and Student      -->
    <!-- ========================================================= -->
    <record id="action_report_student_year_payment_receipt" model="ir.actions.report">
        <field name="name">Official Payment Receipt (A4)</field>
        <field name="model">school.student.year.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_payment_receipt</field>
        <field name="report_file">school_management.report_payment_receipt</field>
        <field name="print_report_name">'Receipt-%s-%s' % (object.receipt_number or ('PAY%04d' % object.id), (object.student_id.name or 'Student').replace(' ', '_'))</field>
        <field name="binding_model_id" ref="model_school_student_year_payment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="school_management.paperformat_student_receipt"/>
    </record>

    <record id="action_report_student_fee_receipt" model="ir.actions.report">
        <field name="name">Official Payment Receipt (A4)</field>
        <field name="model">school.fee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_payment_receipt</field>
        <field name="report_file">school_management.report_payment_receipt</field>
        <field name="print_report_name">'Receipt-%s-%s' % (object.receipt_number or ('FEE%04d' % object.id), (object.student_id.name or 'Student').replace(' ', '_'))</field>
        <field name="binding_model_id" ref="model_school_fee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="school_management.paperformat_student_receipt"/>
    </record>

    <record id="action_report_student_receipt" model="ir.actions.report">
        <field name="name">Student Payment Receipt (A4)</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_payment_receipt</field>
        <field name="report_file">school_management.report_payment_receipt</field>
        <field name="print_report_name">'Receipt-%s-%s' % (object.student_id or ('STU%04d' % object.id), (object.name or 'Student').replace(' ', '_'))</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="school_management.paperformat_student_receipt"/>
    </record>

    <!-- ========================================================= -->
    <!-- MAIN RECEIPT TEMPLATE: Modern Institutional Financial A4  -->
    <!-- ========================================================= -->
    <template id="report_payment_receipt">
        <t t-call="web.html_container">
            <style><![CDATA[
                @page {
                    size: A4 portrait;
                    margin: 0;
                }
                * {
                    box-sizing: border-box;
                    margin: 0;
                    padding: 0;
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }
                html, body {
                    margin: 0 !important;
                    padding: 0 !important;
                    background: #ffffff !important;
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
                    font-size: 8.5pt !important;
                    color: #0f172a !important;
                    line-height: 1.45 !important;
                }
                .container, .container-fluid, #wrapwrap, main {
                    padding: 0 !important;
                    margin: 0 !important;
                    width: 100% !important;
                    max-width: 100% !important;
                }
                .article, .receipt-canvas {
                    width: 186mm !important;
                    max-width: 186mm !important;
                    margin: 0 auto !important;
                    padding: 4mm 2mm !important;
                    page-break-inside: avoid !important;
                    break-inside: avoid !important;
                    page-break-after: avoid !important;
                }

                /* =========================================================
                   1. HEADER: Professional Institutional Header
                   ========================================================= */
                .hdr-table {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin-bottom: 16px;
                }
                .hdr-left {
                    vertical-align: top;
                    text-align: left;
                }
                .hdr-right {
                    vertical-align: top;
                    text-align: right;
                }
                .hdr-logo {
                    max-height: 44px;
                    max-width: 140px;
                    display: inline-block;
                    margin-bottom: 5px;
                }
                .hdr-inst-title {
                    font-size: 12pt;
                    font-weight: 800;
                    color: #0f172a;
                    letter-spacing: -0.2px;
                    text-transform: uppercase;
                    line-height: 1.2;
                }
                .hdr-inst-subtitle {
                    font-size: 7.5pt;
                    font-weight: 700;
                    color: #1e40af;
                    letter-spacing: 0.6px;
                    text-transform: uppercase;
                    margin-top: 2px;
                }
                .hdr-inst-contact {
                    font-size: 7.5pt;
                    color: #64748b;
                    margin-top: 3px;
                    line-height: 1.35;
                }

                /* Header Right: OFFICIAL PAYMENT RECEIPT */
                .doc-main-title {
                    font-size: 16pt;
                    font-weight: 900;
                    color: #0f172a;
                    letter-spacing: -0.3px;
                    text-transform: uppercase;
                    line-height: 1.1;
                }
                .doc-sub-badge {
                    display: inline-block;
                    margin-top: 3px;
                    font-size: 7.5pt;
                    font-weight: 700;
                    color: #1e40af;
                    letter-spacing: 0.8px;
                    text-transform: uppercase;
                }
                .doc-meta-list {
                    margin-top: 8px;
                    font-size: 8pt;
                    color: #475569;
                    line-height: 1.5;
                }
                .doc-voucher-pill {
                    font-family: monospace;
                    font-weight: 800;
                    color: #1e40af;
                    font-size: 9pt;
                    white-space: nowrap !important;
                }

                /* =========================================================
                   2. TOTAL PAYMENT CARD (Subtle, Airy & Prominent)
                   ========================================================= */
                .hero-payment-card {
                    width: 100%;
                    border: 1px solid #e2e8f0;
                    border-radius: 6px;
                    background: #f8fafc;
                    padding: 12px 18px;
                    margin-bottom: 18px;
                }
                .hero-payment-tbl {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .hero-amount-label {
                    font-size: 7.5pt;
                    font-weight: 800;
                    color: #64748b;
                    letter-spacing: 0.8px;
                    text-transform: uppercase;
                    margin-bottom: 2px;
                }
                .hero-amount-number {
                    font-size: 26pt;
                    font-weight: 900;
                    color: #0f172a;
                    letter-spacing: -0.8px;
                    line-height: 1;
                }
                .hero-amount-currency {
                    font-size: 12pt;
                    font-weight: 600;
                    color: #64748b;
                    margin-left: 6px;
                }
                .hero-subtext {
                    font-size: 8pt;
                    color: #475569;
                    margin-top: 4px;
                }
                .hero-badge-paid {
                    display: inline-block;
                    padding: 7px 22px;
                    border-radius: 999px;
                    font-size: 9.5pt;
                    font-weight: 800;
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                    background: #dcfce7;
                    color: #15803d;
                    border: 1px solid #86efac;
                    white-space: nowrap !important;
                }
                .hero-balance-cleared {
                    font-size: 8.5pt;
                    color: #16a34a;
                    font-weight: 700;
                    margin-top: 5px;
                    white-space: nowrap !important;
                }

                /* =========================================================
                   3. STUDENT INFORMATION & PARTICULARS (Spacious Grid)
                   ========================================================= */
                .details-grid-tbl {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 12px 0;
                    table-layout: fixed;
                    margin-bottom: 18px;
                }
                .details-col-card {
                    vertical-align: top;
                    background: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 6px;
                    padding: 10px 14px;
                }
                .section-header-title {
                    font-size: 7.5pt;
                    font-weight: 800;
                    color: #1e40af;
                    letter-spacing: 0.7px;
                    text-transform: uppercase;
                    border-bottom: 1px solid #f1f5f9;
                    padding-bottom: 5px;
                    margin-bottom: 8px;
                    white-space: nowrap !important;
                }
                .info-row-tbl {
                    width: 100%;
                    border-collapse: collapse;
                }
                .info-row-tbl td {
                    padding: 3px 0;
                    vertical-align: top;
                }
                .info-key {
                    width: 44%;
                    font-size: 7.5pt;
                    font-weight: 600;
                    color: #64748b;
                    white-space: nowrap !important;
                }
                .info-val {
                    width: 56%;
                    padding-left: 6px;
                    font-size: 8.5pt;
                    font-weight: 700;
                    color: #0f172a;
                    word-break: break-word;
                }
                .info-val-mono {
                    font-family: monospace;
                    font-weight: 800;
                    color: #1e40af;
                    font-size: 8.5pt;
                    white-space: nowrap !important;
                }

                /* =========================================================
                   4. PAYMENT DETAILS TABLE (Ledger Style, Not Spreadsheet)
                   ========================================================= */
                .ledger-card {
                    width: 100%;
                    border: 1px solid #e2e8f0;
                    border-radius: 6px;
                    overflow: hidden;
                    margin-bottom: 18px;
                }
                .ledger-table {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .ledger-table th {
                    background: #f8fafc;
                    border-bottom: 1px solid #e2e8f0;
                    padding: 8px 10px;
                    font-size: 7.5pt;
                    font-weight: 800;
                    color: #475569;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    text-align: left;
                    white-space: nowrap !important;
                }
                .ledger-table th.th-right {
                    text-align: right;
                }
                .ledger-table th.th-center {
                    text-align: center;
                }
                .ledger-table td {
                    padding: 12px 10px;
                    font-size: 8.5pt;
                    vertical-align: middle;
                    border-bottom: 1px solid #f8fafc;
                }
                .row-item-title {
                    font-weight: 700;
                    color: #0f172a;
                    font-size: 9pt;
                }
                .row-item-desc {
                    font-size: 7.5pt;
                    color: #64748b;
                    margin-top: 2px;
                }
                .row-status-pill {
                    display: inline-block;
                    padding: 2px 10px;
                    border-radius: 999px;
                    font-size: 7pt;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                    background: #dcfce7;
                    color: #15803d;
                    border: 1px solid #bbf7d0;
                    white-space: nowrap !important;
                }

                /* =========================================================
                   5, 6, 7. SUMMARY, ACKNOWLEDGMENT & BARCODE
                   ========================================================= */
                .bottom-grid-tbl {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 14px 0;
                    table-layout: fixed;
                    margin-bottom: 20px;
                }
                .policy-card {
                    vertical-align: top;
                    padding-right: 8px;
                }
                .policy-title {
                    font-size: 7.5pt;
                    font-weight: 800;
                    color: #1e40af;
                    letter-spacing: 0.7px;
                    text-transform: uppercase;
                    margin-bottom: 5px;
                    white-space: nowrap !important;
                }
                .policy-body {
                    font-size: 7.5pt;
                    color: #64748b;
                    line-height: 1.5;
                }
                .barcode-block {
                    margin-top: 14px;
                }
                .barcode-img {
                    max-width: 180px;
                    height: 24px;
                    display: block;
                }
                .barcode-string {
                    font-family: monospace;
                    font-size: 7pt;
                    font-weight: 700;
                    color: #64748b;
                    letter-spacing: 1.5px;
                    margin-top: 3px;
                    white-space: nowrap !important;
                }

                /* Payment Summary Card */
                .summary-card {
                    vertical-align: top;
                    background: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 6px;
                    padding: 10px 14px;
                }
                .totals-tbl {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 8pt;
                }
                .totals-tbl td {
                    padding: 3px 0;
                }
                .t-label {
                    color: #64748b;
                    font-weight: 500;
                    text-align: left;
                    white-space: nowrap !important;
                }
                .t-val {
                    color: #0f172a;
                    font-weight: 600;
                    text-align: right;
                    white-space: nowrap !important;
                }
                .t-row-total {
                    border-top: 1px solid #cbd5e1;
                    border-bottom: 1px solid #cbd5e1;
                }
                .t-row-total td {
                    padding: 6px 0 !important;
                }
                .t-total-label {
                    font-size: 8.5pt;
                    font-weight: 800;
                    color: #0f172a;
                    letter-spacing: 0.3px;
                    white-space: nowrap !important;
                }
                .t-total-val {
                    font-size: 11pt;
                    font-weight: 800;
                    color: #1e40af;
                    text-align: right;
                    white-space: nowrap !important;
                }
                .t-row-paid td {
                    color: #15803d !important;
                    font-weight: 700 !important;
                    padding-top: 5px !important;
                    white-space: nowrap !important;
                }
                .t-row-bal td {
                    padding-top: 5px !important;
                    font-weight: 800 !important;
                    white-space: nowrap !important;
                }
                .badge-cleared {
                    font-size: 7pt;
                    background: #dcfce7;
                    color: #15803d;
                    padding: 1px 6px;
                    border-radius: 4px;
                    font-weight: 800;
                    margin-left: 4px;
                    border: 1px solid #86efac;
                    vertical-align: 1px;
                }

                /* =========================================================
                   8. SIGNATURE SECTION & OFFICIAL SEAL
                   ========================================================= */
                .sign-section-tbl {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin-bottom: 16px;
                }
                .sign-col {
                    vertical-align: bottom;
                    text-align: center;
                }
                .sign-line {
                    border-top: 1px solid #94a3b8;
                    width: 140px;
                    margin: 0 auto 5px auto;
                }
                .sign-role {
                    font-size: 7pt;
                    font-weight: 800;
                    color: #0f172a;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    white-space: nowrap !important;
                }
                .sign-sub {
                    font-size: 6.5pt;
                    color: #64748b;
                    margin-top: 2px;
                    white-space: nowrap !important;
                }
                .cashier-script {
                    font-family: "Brush Script MT", "Dancing Script", cursive;
                    font-size: 18px;
                    color: #1e40af;
                    height: 28px;
                    line-height: 28px;
                    text-align: center;
                }

                /* =========================================================
                   9. FOOTER: Professional Clean 1-Line Security Notice
                   ========================================================= */
                .footer-rule {
                    border-top: 1px solid #e2e8f0;
                    padding-top: 8px;
                }
                .footer-tbl {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 7pt;
                    color: #94a3b8;
                }
                .ft-left {
                    text-align: left;
                    white-space: nowrap !important;
                }
                .ft-mid {
                    text-align: center;
                    white-space: nowrap !important;
                }
                .ft-right {
                    text-align: right;
                    font-weight: 700;
                    color: #1e40af;
                    white-space: nowrap !important;
                }
            ]]></style>

            <t t-foreach="receipts" t-as="r">
                <div class="article receipt-canvas" t-att-data-oe-model="r.get('model_name')" t-att-data-oe-id="r.get('doc_id')">

                    <!-- =========================================================
                         1. HEADER
                         ========================================================= -->
                    <table class="hdr-table">
                        <colgroup>
                            <col style="width: 52%;"/>
                            <col style="width: 48%;"/>
                        </colgroup>
                        <tr>
                            <!-- Left: Logo & Organization Info -->
                            <td class="hdr-left">
                                <div t-if="r.get('logo_uri')">
                                    <img t-att-src="r['logo_uri']" class="hdr-logo" alt="PNC Logo"/>
                                </div>
                                <div class="hdr-inst-title" t-esc="r.get('inst_name') or inst_name or company.name or 'Passerelles Numériques Cambodia'"/>
                                <div class="hdr-inst-subtitle">Office of the Bursar &amp; Financial Services</div>
                                <div class="hdr-inst-contact">
                                    <div><t t-esc="r.get('inst_addr') or inst_addr"/></div>
                                    <div>Tel: <t t-esc="r.get('inst_phone') or inst_phone"/> · Email: <t t-esc="r.get('inst_email') or inst_email"/></div>
                                </div>
                            </td>

                            <!-- Right: OFFICIAL PAYMENT RECEIPT -->
                            <td class="hdr-right">
                                <div class="doc-main-title">OFFICIAL PAYMENT RECEIPT</div>
                                <div class="doc-sub-badge">Bursar Treasury Official Receipt</div>
                                <div class="doc-meta-list">
                                    <div>Voucher No: <span class="doc-voucher-pill" t-esc="r.get('receipt_number')"/></div>
                                    <div>Date Issued: <strong><t t-esc="r.get('receipt_date')"/></strong></div>
                                    <div>Payment Method: <strong><t t-esc="r.get('payment_method') or 'Cash'"/></strong></div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- =========================================================
                         2. TOTAL PAYMENT CARD (Subtle, Airy & Prominent)
                         ========================================================= -->
                    <div class="hero-payment-card">
                        <table class="hero-payment-tbl">
                            <colgroup>
                                <col style="width: 60%;"/>
                                <col style="width: 40%;"/>
                            </colgroup>
                            <tr>
                                <td>
                                    <div class="hero-amount-label">TOTAL AMOUNT PAID</div>
                                    <div>
                                        <span class="hero-amount-number" t-esc="r.get('paid_amount_display')"/>
                                        <span class="hero-amount-currency">USD</span>
                                    </div>
                                    <div class="hero-subtext">
                                        Payment Confirmed: <strong><t t-esc="r.get('receipt_date')"/></strong> via <strong><t t-esc="r.get('payment_method') or 'Cash'"/></strong>
                                    </div>
                                </td>
                                <td style="text-align: right; vertical-align: middle;">
                                    <div class="hero-badge-paid">
                                        ✔ <t t-esc="r.get('status_label') or 'PAID IN FULL'"/>
                                    </div>
                                    <div class="hero-balance-cleared" t-if="r.get('is_zero_balance')">
                                        ● Remaining Balance: $0.00 (Cleared)
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- =========================================================
                         3. STUDENT INFORMATION & TRANSACTION PARTICULARS
                         ========================================================= -->
                    <table class="details-grid-tbl">
                        <colgroup>
                            <col style="width: 50%;"/>
                            <col style="width: 50%;"/>
                        </colgroup>
                        <tr>
                            <!-- Student Info Card -->
                            <td class="details-col-card">
                                <div class="section-header-title">STUDENT INFORMATION</div>
                                <table class="info-row-tbl">
                                    <tr>
                                        <td class="info-key">Student Name:</td>
                                        <td class="info-val" t-esc="r.get('student_name')"/>
                                    </tr>
                                    <tr>
                                        <td class="info-key">Student ID:</td>
                                        <td class="info-val-mono" t-esc="r.get('student_code')"/>
                                    </tr>
                                    <tr>
                                        <td class="info-key">Class / Cohort:</td>
                                        <td class="info-val" t-esc="r.get('class_name') or 'QA Test Class'"/>
                                    </tr>
                                    <tr>
                                        <td class="info-key">Contact Email:</td>
                                        <td class="info-val">
                                            <t t-if="r.get('student_email')"><t t-esc="r.get('student_email')"/></t>
                                            <t t-elif="r.get('student_phone')"><t t-esc="r.get('student_phone')"/></t>
                                            <t t-else="">hello@gmail.com</t>
                                        </td>
                                    </tr>
                                </table>
                            </td>

                            <!-- Particulars Card -->
                            <td class="details-col-card">
                                <div class="section-header-title">PAYMENT PARTICULARS</div>
                                <table class="info-row-tbl">
                                    <tr>
                                        <td class="info-key">Voucher Reference:</td>
                                        <td class="info-val-mono" t-esc="r.get('receipt_number')"/>
                                    </tr>
                                    <tr>
                                        <td class="info-key">Academic Year:</td>
                                        <td class="info-val" t-esc="r.get('academic_year') or '2026'"/>
                                    </tr>
                                    <tr>
                                        <td class="info-key">Payment Channel:</td>
                                        <td class="info-val"><t t-esc="r.get('payment_method') or 'Cash'"/></td>
                                    </tr>
                                    <tr>
                                        <td class="info-key">Clearance Status:</td>
                                        <td class="info-val" style="color: #15803d; white-space: nowrap !important;">✔ Verified &amp; Cleared</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- =========================================================
                         4. PAYMENT DETAILS TABLE (Clean Ledger, Not Spreadsheet)
                         ========================================================= -->
                    <div class="ledger-card">
                        <table class="ledger-table">
                            <colgroup>
                                <col style="width: 6%;"/>
                                <col style="width: 44%;"/>
                                <col style="width: 20%;"/>
                                <col style="width: 14%;"/>
                                <col style="width: 16%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="th-center">#</th>
                                    <th>Item Description &amp; Particulars</th>
                                    <th class="th-center">Academic Term</th>
                                    <th class="th-center">Status</th>
                                    <th class="th-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="r.get('line_items', [])" t-as="item">
                                    <tr>
                                        <td style="text-align: center; color: #94a3b8; font-weight: 600;"><t t-esc="item.get('index') or (item_index + 1)"/></td>
                                        <td>
                                            <div class="row-item-title" t-esc="item.get('name')"/>
                                            <div class="row-item-desc" t-if="item.get('sub_text')" t-esc="item.get('sub_text')"/>
                                        </td>
                                        <td style="text-align: center; color: #475569;" t-esc="item.get('period') or r.get('academic_year') or '2026'"/>
                                        <td style="text-align: center;">
                                            <span class="row-status-pill">
                                                <t t-esc="item.get('status_label') or ('Paid' if item.get('status') == 'paid' else 'Pending')"/>
                                            </span>
                                        </td>
                                        <td style="text-align: right; font-weight: 700; color: #0f172a;" t-esc="item.get('amount_display')"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- =========================================================
                         5, 6, 7. PAYMENT SUMMARY, ACKNOWLEDGMENT & BARCODE
                         ========================================================= -->
                    <table class="bottom-grid-tbl">
                        <colgroup>
                            <col style="width: 48%;"/>
                            <col style="width: 52%;"/>
                        </colgroup>
                        <tr>
                            <!-- Left: Policy & Barcode -->
                            <td class="policy-card">
                                <div class="policy-title">ACKNOWLEDGMENT &amp; OFFICIAL POLICY</div>
                                <div class="policy-body">
                                    This receipt constitutes valid legal proof of payment for the specified academic charges. Please retain this document for semester course registration and graduation clearance. All fees paid are subject to institutional bursar regulations.
                                </div>
                                <div class="barcode-block" t-if="r.get('barcode_uri')">
                                    <img t-att-src="r['barcode_uri']" class="barcode-img" alt="Barcode Verification"/>
                                    <div class="barcode-string" t-esc="r.get('barcode_text')"/>
                                </div>
                            </td>

                            <!-- Right: Payment Summary -->
                            <td class="summary-card">
                                <table class="totals-tbl">
                                    <colgroup>
                                        <col style="width: 62%;"/>
                                        <col style="width: 38%;"/>
                                    </colgroup>
                                    <tr>
                                        <td class="t-label">Subtotal:</td>
                                        <td class="t-val" t-esc="r.get('subtotal_display')"/>
                                    </tr>
                                    <tr>
                                        <td class="t-label">Adjustment:</td>
                                        <td class="t-val" t-esc="r.get('adjustment_display') or '$ 0.00'"/>
                                    </tr>
                                    <tr>
                                        <td class="t-label">Discount:</td>
                                        <td class="t-val" t-esc="r.get('discount_display') or '$ 0.00'"/>
                                    </tr>
                                    <tr class="t-row-total">
                                        <td class="t-total-label">TOTAL BILLED:</td>
                                        <td class="t-total-val" t-esc="r.get('total_display')"/>
                                    </tr>
                                    <tr class="t-row-paid">
                                        <td>Amount Paid (<t t-esc="r.get('payment_method') or 'Cash'"/>):</td>
                                        <td style="text-align: right;" t-esc="r.get('paid_amount_display')"/>
                                    </tr>
                                    <tr class="t-row-bal">
                                        <td style="color: #0f172a;">Remaining Balance:</td>
                                        <td style="text-align: right; color: #15803d; font-size: 9pt;">
                                            <t t-esc="r.get('balance_display')"/>
                                            <span t-if="r.get('is_zero_balance')" class="badge-cleared">CLEARED</span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- =========================================================
                         8. SIGNATURE SECTION & OFFICIAL SEAL
                         ========================================================= -->
                    <table class="sign-section-tbl">
                        <colgroup>
                            <col style="width: 35%;"/>
                            <col style="width: 30%;"/>
                            <col style="width: 35%;"/>
                        </colgroup>
                        <tr>
                            <!-- Payee Signature -->
                            <td class="sign-col">
                                <div style="height: 28px;"/>
                                <div class="sign-line"/>
                                <div class="sign-role">STUDENT / PAYEE</div>
                                <div class="sign-sub">Signature &amp; Date</div>
                            </td>

                            <!-- Official Seal (Crisp SVG) -->
                            <td class="sign-col" style="vertical-align: middle;">
                                <svg width="70" height="70" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: 0 auto;">
                                    <circle cx="50" cy="50" r="47" stroke="#0f172a" stroke-width="1.2" fill="#f8fafc"/>
                                    <circle cx="50" cy="50" r="42" stroke="#1e40af" stroke-width="1" stroke-dasharray="2 1.5" fill="none"/>
                                    <circle cx="50" cy="50" r="34" fill="#0f172a"/>
                                    <path d="M50 26 L52.5 33.5 L60.5 34.5 L54.5 39 L56.5 47 L50 42.5 L43.5 47 L45.5 39 L39.5 34.5 L47.5 33.5 Z" fill="#38bdf8"/>
                                    <text x="50" y="56" text-anchor="middle" fill="#ffffff" font-size="6.5" font-weight="800" font-family="Arial, sans-serif">BURSAR</text>
                                    <text x="50" y="64" text-anchor="middle" fill="#38bdf8" font-size="5" font-weight="700" font-family="Arial, sans-serif">TREASURY</text>
                                    <text x="50" y="71" text-anchor="middle" fill="#94a3b8" font-size="4" font-family="Arial, sans-serif">OFFICIAL RECEIPT</text>
                                </svg>
                                <div style="font-size: 6.5pt; font-weight: 700; color: #64748b; text-transform: uppercase; margin-top: 3px;">OFFICIAL SEAL</div>
                            </td>

                            <!-- Administrator Signature -->
                            <td class="sign-col">
                                <div class="cashier-script">
                                    <t t-esc="r.get('cashier') or 'Administrator'"/>
                                </div>
                                <div class="sign-line"/>
                                <div class="sign-role">AUTHORIZED CASHIER</div>
                                <div class="sign-sub">Office of the Bursar</div>
                            </td>
                        </tr>
                    </table>

                    <!-- =========================================================
                         9. FOOTER
                         ========================================================= -->
                    <div class="footer-rule">
                        <table class="footer-tbl">
                            <colgroup>
                                <col style="width: 34%;"/>
                                <col style="width: 36%;"/>
                                <col style="width: 30%;"/>
                            </colgroup>
                            <tr>
                                <td class="ft-left">
                                    Voucher: <strong style="color: #0f172a;" t-esc="r.get('receipt_number')"/> · Student ID: <strong style="color: #0f172a;" t-esc="r.get('student_code')"/>
                                </td>
                                <td class="ft-mid">
                                    Official Payment Receipt - Issued by <t t-esc="r.get('inst_name') or inst_name or company.name"/>
                                </td>
                                <td class="ft-right">
                                    ORIGINAL — STUDENT COPY
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
