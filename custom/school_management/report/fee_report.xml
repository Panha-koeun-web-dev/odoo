<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_school_fee" model="ir.actions.report">
        <field name="name">Fee Report</field>
        <field name="model">school.fee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.fee_report</field>
        <field name="report_file">school_management.fee_report</field>
        <field name="binding_model_id" ref="model_school_fee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="fee_report">
        <t t-call="web.html_container">
            <t t-call="school_management.fee_report_document"/>
        </t>
    </template>

    <template id="fee_report_document">
        <t t-if="not background_image">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center o_fee_report o_fee_report_missing_bg">
                        <h3>Report background image could not be loaded.</h3>
                    </div>
                </div>
            </t>
        </t>
        <t t-else="">
            <div t-att-class="'header o_company_%d_layout' % (company.id or 0)">
                <div class="container">
                    <div class="row o_report_layout_header o_school_report o_school_report_header align-items-center py-2">
                        <div class="col-4">
                            <img t-if="background_image" t-att-src="background_image"
                                 class="o_school_report_logo o_school_report_logo_large" alt="School logo"/>
                            <img t-elif="has_company_logo" t-att-src="company_logo"
                                 class="o_school_report_logo o_school_report_logo_large" alt="Company logo"/>
                        </div>
                        <div class="col-4 text-center">
                            <h1 class="h3 mb-0 o_school_report_title o_fee_report_brand">
                                School Management System
                            </h1>
                            <div t-if="company.name" class="mt-1 o_school_report_subtitle">
                                <span t-esc="company.name"/>
                            </div>
                            <div class="mt-1 o_fee_report_type">
                                Official Fee Statement
                            </div>
                        </div>
                        <div class="col-4 text-right">
                            <div class="o_school_report_label">FEE REPORT</div>
                            <div t-if="company.email" class="o_school_report_contact" t-esc="company.email"/>
                            <div t-if="company.phone" class="o_school_report_contact" t-esc="company.phone"/>
                            <div t-if="company.website" class="o_school_report_contact" t-esc="company.website"/>
                        </div>
                    </div>
                </div>
            </div>

            <div class="article o_report_layout_standard o_table_standard"
                 t-att-class="'article o_report_layout_standard o_table_standard o_school_report o_fee_report o_company_%d_layout' % (company.id or 0)"
                 t-att-data-oe-model="'school.fee'"
                 t-att-data-oe-id="docs and docs.ids[:1][0]"
                 t-att-data-oe-lang="docs and docs.env.context.get('lang') or 'en_US'">
                <div class="page container py-4">
                    <div class="row mb-2">
                        <div class="col-12 d-flex justify-content-between align-items-end">
                            <div>
                                <h3 class="mb-1 o_school_report_section_title">Fee Report</h3>
                                <div class="o_school_report_muted">
                                    Compiled for the current academic period ·
                                    <span t-esc="total_fees"/> fee record(s)
                                </div>
                            </div>
                            <div class="text-right o_fee_report_generated">
                                Generated on <span t-esc="generated_on"/> by <span t-esc="user.name"/>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered o_school_report_table o_fee_report_table">
                        <thead>
                            <tr class="o_fee_head">
                                <th width="3%">#</th>
                                <th>Student</th>
                                <th>Student ID</th>
                                <th>Class</th>
                                <th>Fee Type</th>
                                <th class="text-right">Amount</th>
                                <th class="text-right">Paid</th>
                                <th class="text-right">Balance</th>
                                <th>Due Date</th>
                                <th>Paid Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="fee_rows" t-as="row">
                                <tr t-attf-class="{{ 'o_fee_overdue' if row.get('status_value') == 'overdue' else '' }}">
                                    <td t-esc="row_index + 1"/>
                                    <td t-esc="row.get('student_name')"/>
                                    <td t-esc="row.get('student_id') or ''"/>
                                    <td t-esc="row.get('class_name') or ''"/>
                                    <td t-esc="row.get('fee_type') or ''"/>
                                    <td class="text-right" t-esc="format_number(row.get('amount'))"/>
                                    <td class="text-right" t-esc="format_number(row.get('paid_amount'))"/>
                                    <td class="text-right" t-esc="format_number(row.get('balance'))"/>
                                    <td t-esc="row.get('due_date') or ''"/>
                                    <td t-esc="row.get('paid_date') or ''"/>
                                    <td class="text-center">
                                        <span t-attf-class="badge {{ 'bg-success' if row.get('status_value') == 'paid' else 'bg-warning' if row.get('status_value') == 'pending' else 'bg-danger' if row.get('status_value') == 'overdue' else 'bg-info' }}">
                                            <t t-esc="row.get('status')"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="o_fee_totals">
                                <td colspan="5">Total</td>
                                <td class="text-right" t-esc="total_amount"/>
                                <td class="text-right" t-esc="total_paid"/>
                                <td class="text-right" t-esc="total_balance"/>
                                <td colspan="3"/>
                            </tr>
                        </tfoot>
                    </table>

                    <div t-foreach="fee_rows" t-as="row" t-if="row.get('notes')" class="o_fee_notes_block">
                        <div class="o_fee_notes">
                            <strong>Notes (<span t-esc="row.get('student_name')"/>):</strong>
                            <div class="o_fee_notes_text"><span t-esc="row.get('notes')"/></div>
                        </div>
                    </div>

                    <div class="row mt-4 o_fee_signature">
                        <div class="col-6">
                            <div class="o_fee_signature_line">
                                Authorized Signature
                            </div>
                        </div>
                        <div class="col-6 text-right">
                            <div class="o_fee_signature_line">
                                Date
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div t-att-class="'footer o_company_%d_layout' % (company.id or 0)">
                <div class="container">
                    <div class="o_footer_content o_fee_report o_fee_report_footer d-flex justify-content-between align-items-center py-2">
                        <div>
                            <t t-if="has_company_logo"><span t-esc="company.name"/> · </t>
                            Fee Report
                        </div>
                        <div class="text-right">
                            Page <span class="page"/> of <span class="topage"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
