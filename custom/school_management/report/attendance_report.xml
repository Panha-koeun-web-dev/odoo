<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_school_attendance" model="ir.actions.report">
        <field name="name">Attendance Report</field>
        <field name="model">school.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.attendance_report</field>
        <field name="report_file">school_management.attendance_report</field>
        <field name="binding_model_id" ref="model_school_attendance"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="attendance_report">
        <t t-call="web.html_container">
            <t t-call="school_management.attendance_report_document"/>
        </t>
    </template>

    <template id="attendance_report_document">
        <t t-call="web.external_layout">
            <div class="page o_school_report o_attendance_report">
                <div class="row o_school_report_header">
                    <div class="col-2">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             class="o_school_report_logo" alt="School Logo"/>
                    </div>
                    <div class="col-10 text-center">
                        <h2 class="o_school_report_title">School Management System</h2>
                        <div t-if="company.name" class="o_school_report_subtitle">Company: <span t-esc="company.name"/></div>
                        <h3 class="o_school_report_section_title mt-1">Attendance Report</h3>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-12">
                        <strong>Total attendance records: </strong><span t-esc="total_records"/>
                    </div>
                </div>

                <table class="table table-sm table-bordered o_school_report_table">
                    <thead>
                        <tr class="o_school_report_table_head">
                            <th>#</th>
                            <th>Student</th>
                            <th>Student ID</th>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="attendance_rows" t-as="row">
                            <tr>
                                <td t-esc="row_index + 1"/>
                                <td t-esc="row.get('student_name')"/>
                                <td t-esc="row.get('student_id') or ''"/>
                                <td t-esc="row.get('class_name') or ''"/>
                                <td t-esc="row.get('date') or ''"/>
                                <td>
                                    <span t-attf-class="badge {{ 'bg-success' if row.get('status_value') == 'present' else 'bg-danger' if row.get('status_value') == 'absent' else 'bg-warning' if row.get('status_value') == 'late' else 'bg-info' }}">
                                        <t t-esc="row.get('status')"/>
                                    </span>
                                </td>
                                <td t-esc="row.get('notes') or ''"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row mt-2">
                    <div class="col-12">
                        <h5 class="o_school_report_summary_title">Summary</h5>
                        <table class="table table-sm table-bordered o_school_report_table">
                            <tbody>
                                <tr>
                                    <td class="o_school_report_summary_label">Present</td>
                                    <td t-esc="status_counts.get('present', 0)"/>
                                    <td class="o_school_report_summary_label">Absent</td>
                                    <td t-esc="status_counts.get('absent', 0)"/>
                                    <td class="o_school_report_summary_label">Late</td>
                                    <td t-esc="status_counts.get('late', 0)"/>
                                    <td class="o_school_report_summary_label">Excused</td>
                                    <td t-esc="status_counts.get('excused', 0)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="o_school_report_footer_note">
                    Generated on <span t-esc="generated_on"/> by <span t-esc="user.name"/>.
                </div>
            </div>
        </t>
    </template>
</odoo>
