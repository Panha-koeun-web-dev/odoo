<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_school_attendance" model="ir.actions.report">
        <field name="name">Attendance Report</field>
        <field name="model">school.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.attendance_report</field>
        <field name="report_file">school_management.attendance_report</field>
        <field name="binding_model_id" ref="model_school_attendance"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="attendance_report">
        <t t-call="web.html_container">
            <t t-call="school_management.attendance_report_document"/>
        </t>
    </template>

    <template id="attendance_report_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row" style="border-bottom: 3px solid #1a4d7c; padding-bottom: 8px; margin-bottom: 14px;">
                    <div class="col-2">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="School Logo"/>
                    </div>
                    <div class="col-10 text-center">
                        <h2 style="margin: 0; color: #1a4d7c; font-weight: bold;">School Management System</h2>
                        <div t-if="company.name" style="color: #555; font-size: 13px;">Company: <span t-esc="company.name"/></div>
                        <h3 style="margin: 4px 0 0; color: #333;">Attendance Report</h3>
                    </div>
                </div>

                <div class="row" style="margin-bottom: 12px;">
                    <div class="col-12">
                        <strong>Total attendance records: </strong><span t-esc="total_records"/>
                    </div>
                </div>

                <table class="table table-sm table-bordered" style="font-size: 11px;">
                    <thead>
                        <tr style="background-color: #1a4d7c; color: #fff;">
                            <th>#</th>
                            <th>Student</th>
                            <th>Student ID</th>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="attendance_rows" t-as="row">
                            <tr>
                                <td t-esc="row_index + 1"/>
                                <td t-esc="row.get('student_name')"/>
                                <td t-esc="row.get('student_id') or ''"/>
                                <td t-esc="row.get('class_name') or ''"/>
                                <td t-esc="row.get('date') or ''"/>
                                <td>
                                    <span t-attf-class="badge {{ 'bg-success' if row.get('status_value') == 'present' else 'bg-danger' if row.get('status_value') == 'absent' else 'bg-warning' if row.get('status_value') == 'late' else 'bg-info' }}">
                                        <t t-esc="row.get('status')"/>
                                    </span>
                                </td>
                                <td t-esc="row.get('notes') or ''"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row" style="margin-top: 12px;">
                    <div class="col-12">
                        <h5 style="color: #1a4d7c; margin: 0 0 6px;">Summary</h5>
                        <table class="table table-sm table-bordered" style="font-size: 11px;">
                            <tbody>
                                <tr>
                                    <td style="font-weight: bold; background: #f0f4f8; width: 20%;">Present</td>
                                    <td t-esc="status_counts.get('present', 0)"/>
                                    <td style="font-weight: bold; background: #f0f4f8; width: 20%;">Absent</td>
                                    <td t-esc="status_counts.get('absent', 0)"/>
                                    <td style="font-weight: bold; background: #f0f4f8; width: 20%;">Late</td>
                                    <td t-esc="status_counts.get('late', 0)"/>
                                    <td style="font-weight: bold; background: #f0f4f8; width: 20%;">Excused</td>
                                    <td t-esc="status_counts.get('excused', 0)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="margin-top: 22px; border-top: 1px solid #ccc; padding-top: 8px; font-size: 11px; color: #777;">
                    Generated on <span t-esc="generated_on"/> by <span t-esc="user.name"/>.
                </div>
            </div>
        </t>
    </template>
</odoo>
