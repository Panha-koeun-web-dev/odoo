        </record>
        <record id="class_2" model="school.class">
            <field name="name">Grade 11</field>
            <field name="section">A</field>
            <field name="teacher_id" ref="teacher_2"/>
            <field name="room">Room 201</field>
            <field name="capacity">40</field>
        </record>

        <!-- Students -->
        <record id="student_1" model="school.student">
            <field name="name">Dara Randy</field>
            <field name="student_id">S001</field>
