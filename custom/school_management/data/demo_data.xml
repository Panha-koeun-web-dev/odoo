<odoo>
    <data noupdate="1">
        <!-- Subjects -->
        <record id="subject_math" model="school.subject">
            <field name="name">Mathematics</field>
            <field name="code">MATH01</field>
            <field name="description">Basic Mathematics</field>
        </record>
        <record id="subject_science" model="school.subject">
            <field name="name">Science</field>
            <field name="code">SCI01</field>
            <field name="description">General Science</field>
        </record>
        <record id="subject_english" model="school.subject">
            <field name="name">English</field>
            <field name="code">ENG01</field>
            <field name="description">English Language</field>
        </record>
        <record id="subject_khmer" model="school.subject">
            <field name="name">Khmer</field>
            <field name="code">KHM01</field>
            <field name="description">Khmer Language</field>
        </record>

        <!-- Teachers -->
        <record id="teacher_1" model="school.teacher">
            <field name="name">Sok Vanna</field>
            <field name="employee_id">T001</field>
            <field name="gender">male</field>
            <field name="email">vanna@school.com</field>
            <field name="phone">012345678</field>
        </record>
        <record id="teacher_2" model="school.teacher">
            <field name="name">Chan Sophea</field>
            <field name="employee_id">T002</field>
            <field name="gender">female</field>
            <field name="email">sophea@school.com</field>
            <field name="phone">012345679</field>
        </record>

        <!-- Classes -->
        <record id="class_1" model="school.class">
            <field name="name">Grade 10</field>
            <field name="section">A</field>
            <field name="teacher_id" ref="teacher_1"/>
            <field name="room">Room 101</field>
