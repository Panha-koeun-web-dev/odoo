        <record id="student_2" model="school.student">
            <field name="name">Kim Chanly</field>
            <field name="student_id">S002</field>
            <field name="gender">female</field>
            <field name="date_of_birth">2007-08-20</field>
            <field name="class_id" ref="class_1"/>
            <field name="parent_name">Kim Bopha</field>
            <field name="parent_phone">098765433</field>
        </record>
    </data>
</odoo>