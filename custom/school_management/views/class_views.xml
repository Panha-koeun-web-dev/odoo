<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" class="btn-outline-primary" icon="fa-file-excel-o" display="always" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                </header>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="section"/>
                <field name="major_id"/>
                <field name="current_term_id" widget="badge" optional="show"/>
                <field name="room"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="capacity_progress" string="Capacity %"/>
                <field name="payment_year" optional="show"/>
                <field name="total_payment" widget="monetary" optional="show"/>
                <field name="total_payment_collected" widget="monetary" optional="hide"/>
                <field name="total_payment_balance" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_export_xlsx" type="object" string="XLSX"
                        class="btn-sm btn-outline-success" icon="fa-file-excel-o"
                        title="Export this class report to Excel" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_class_kanban" model="ir.ui.view">
        <field name="name">school.class.kanban</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="false">
                <field name="name"/>
                <field name="section"/>
                <field name="major_id"/>
                <field name="current_term_id"/>
                <field name="room"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="capacity_progress"/>
                <field name="total_payment"/>
                <field name="payment_collection_rate"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <span class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter bg-primary">
                                        <i class="fa fa-university" title="Class"/>
                                    </span>
                                </span>
                                <div>
                                    <strong class="o_kanban_record_title d-block">
                                        <field name="name"/>
                                        <t t-if="record.section.raw"> - <field name="section"/></t>
                                    </strong>
                                    <span class="text-muted"><i class="fa fa-map-marker me-1" title="Room"/><field name="room"/></span>
                                </div>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="text-muted">
                                    <i class="fa fa-user-circle-o me-1" title="Class teacher"/>Class Teacher:
                                    <field name="teacher_id" placeholder="Not assigned"/>
                                </div>
                                <t t-if="record.current_term_id.raw_value">
                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-calendar me-1 text-info" title="Current Term"/>Term:
                                        <field name="current_term_id"/>
                                    </div>
                                </t>
                            </div>
                            <div class="oe_kanban_footer mt-2">
                                <field name="capacity_progress" widget="progressbar"
                                       progress="capacity_progress > 100 ? 100 : capacity_progress" string="Capacity"/>
                                <div class="text-muted text-end">
                                    <field name="student_count"/> / <field name="capacity"/> students
                                </div>
                                <t t-if="record.total_payment.raw > 0">
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                        <span class="text-muted small"><i class="fa fa-money me-1"/>Tuition: <field name="total_payment"/></span>
                                        <span class="badge bg-light text-primary"><field name="payment_collection_rate"/>% Paid</span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_term_schedule_wizard" string="Plan Term Schedule" type="object" class="btn-primary" icon="fa-calendar-plus-o" groups="school_management.group_school_admin"/>
                    <button name="action_open_assign_wizard" string="Assign Staff &amp; Curriculum" type="object" class="btn-primary" icon="fa-graduation-cap" groups="school_management.group_school_admin"/>
                    <button name="action_take_attendance" string="Take Attendance" type="object" class="btn-primary" icon="fa-calendar-check-o" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_request_teacher_permission" string="Request Leave from Class" type="object" class="btn-outline-warning" icon="fa-calendar-minus-o" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_generate_year_payments" string="Apply Class Payment to All Students" type="object" class="btn-primary" icon="fa-refresh" invisible="not total_payment" groups="school_management.group_school_admin"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object" class="btn-outline-primary" icon="fa-file-excel-o" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_timetable" type="object" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="timetable_count"/></span>
                                <span class="o_stat_text">Timetable</span>
                            </div>
                        </button>
                        <button name="action_view_teacher_permissions" type="object" class="oe_stat_button" icon="fa-calendar-minus-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="permission_count"/></span>
                                <span class="o_stat_text">Teacher Leaves</span>
                            </div>
                        </button>
                        <button name="action_view_year_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="year_payment_count"/></span>
                                <span class="o_stat_text">Year Payments</span>
                            </div>
                        </button>
                        <button name="action_view_teaching_assignments" type="object" class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="teaching_assignment_count"/> Subs</span>
                                <span class="o_stat_text">Curriculum</span>
                            </div>
                        </button>
                        <button name="action_view_holidays" type="object" class="oe_stat_button" icon="fa-star">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="holiday_count"/></span>
                                <span class="o_stat_text">Holidays</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Class Name"/>
                        </h1>
                    </div>
                    <group class="mt-3">
                        <group string="Class Details">
                            <field name="code"/>
                            <field name="section"/>
                            <field name="major_id"/>
                            <field name="payment_year" string="Academic Year" placeholder="e.g. 2026-2027"/>
                            <field name="room"/>
                            <field name="teacher_id"/>
                            <field name="current_term_id" options="{'no_create': True}"/>
                            <field name="term_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity"/>
                            <field name="student_count" readonly="1"/>
                            <field name="capacity_progress" readonly="1" widget="progressbar"
                                   progress="capacity_progress > 100 ? 100 : capacity_progress" string="Capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students" name="students">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="text-muted mb-0"><i class="fa fa-users me-1" title="Students"/> Enrolled Students in this Class</h6>
                            </div>
                            <field name="student_ids" readonly="1">
                                <list decoration-danger="study_status == 'stopped'" decoration-muted="not active">
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="study_status" widget="badge"
                                           decoration-success="study_status == 'studying'"
                                           decoration-danger="study_status == 'stopped'"/>
                                    <field name="gender" widget="badge" optional="show"/>
                                    <field name="phone" optional="show"/>
                                    <field name="total_year_amount" string="Class Tuition" widget="monetary" sum="Total Tuition"/>
                                    <field name="total_year_paid" string="Paid" widget="monetary" sum="Total Paid"/>
                                    <field name="total_year_balance" string="Balance" widget="monetary" sum="Total Due"/>
                                    <field name="year_payment_status" widget="badge"
                                           decoration-success="year_payment_status == 'paid'"
                                           decoration-danger="year_payment_status == 'overdue'"
                                           decoration-warning="year_payment_status == 'partial'"
                                           decoration-info="year_payment_status == 'pending'"
                                           decoration-muted="year_payment_status == 'no_record'"/>
                                    <button name="action_open_stop_study_wizard" type="object" string="Stop" icon="fa-ban"
                                            title="Stop / Kick Student" class="text-danger" invisible="study_status == 'stopped'" groups="school_management.group_school_admin"/>
                                    <button name="action_continue_study" type="object" string="Continue" icon="fa-play"
                                            title="Continue Study" class="text-success" invisible="study_status != 'stopped'" groups="school_management.group_school_admin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timetable / Schedule" name="timetable">
                            <div class="d-flex align-items-center justify-content-between mb-3 p-2 bg-light rounded border">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary fs-6 px-3 py-2">
                                        <i class="fa fa-calendar me-1" title="Calendar"/> <field name="timetable_count"/> Sessions
                                    </span>
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                        <i class="fa fa-star me-1" title="Holidays"/> <field name="holiday_count"/> Holidays
                                    </span>
                                    <span class="text-muted small">Weekly class schedule and calendar</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button name="action_view_timetable" type="object"
                                            string="Open Class Timetable &amp; Calendar"
                                            class="btn btn-primary btn-sm"
                                            icon="fa-calendar"/>
                                    <button name="action_view_holidays" type="object"
                                            string="Class Holidays Calendar"
                                            class="btn btn-outline-warning btn-sm"
                                            icon="fa-star"/>
                                    <button name="action_view_master_timetable" type="object"
                                            string="Full School Master Timetable"
                                            class="btn btn-outline-secondary btn-sm"
                                            icon="fa-globe"/>
                                </div>
                            </div>
                            <field name="timetable_ids" context="{'default_class_id': id, 'default_room': room, 'default_teacher_id': teacher_id}">
                                <list editable="bottom" default_order="day_of_week, start_time">
                                    <field name="term_id" widget="badge" optional="show"/>
                                    <field name="day_of_week" widget="badge"
                                           decoration-info="day_of_week in ('0', '1', '2')"
                                           decoration-primary="day_of_week in ('3', '4')"
                                           decoration-warning="day_of_week in ('5', '6')"/>
                                    <field name="period" widget="badge"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="room"/>
                                    <field name="start_datetime" column_invisible="True"/>
                                    <field name="end_datetime" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment / Tuition" name="payments">
                            <!-- Financial Summary KPI Cards -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Class Tuition per Student</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50">Standard for this Class</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-info text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Total Expected</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment_expected" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50"><field name="year_payment_count"/> Student(s)</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-success text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Total Collected</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment_collected" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50"><field name="payment_collection_rate"/>% Paid</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-danger text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Total Balance</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50">Outstanding Due</small>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <group string="Class Tuition &amp; Installments Configuration">
                                <group string="Academic Year &amp; Total Tuition">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="payment_year" placeholder="e.g. 2024-2025"/>
                                    <field name="total_payment" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="year_start"/>
                                    <field name="year_end"/>
                                </group>
                                <group string="Installments Breakdown &amp; Deadlines">
                                    <field name="installment_1_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="installment_1_due_date"/>
                                    <field name="installment_2_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="installment_2_due_date"/>
                                    <field name="payment_deadline"/>
                                </group>
                            </group>

                            <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                                <div>
                                    <h5 class="mb-0 fw-bold">Student Payment Records (<field name="payment_year" readonly="1"/>)</h5>
                                    <small class="text-muted">Students follow this class payment schedule, or can have a custom deadline set specifically for them.</small>
                                </div>
                                <div>
                                    <button name="action_generate_year_payments" string="Apply Class Payment to All Students"
                                            type="object" class="btn btn-sm btn-primary" icon="fa-refresh" invisible="not total_payment" groups="school_management.group_school_admin"/>
                                </div>
                            </div>
                            <field name="year_payment_ids" readonly="1">
                                <list decoration-danger="overall_status == 'overdue' or deadline_status == 'overdue'"
                                      decoration-success="overall_status == 'paid'"
                                      decoration-warning="overall_status == 'partial' or deadline_status == 'today'"
                                      decoration-muted="overall_status == 'pending'">
                                    <field name="student_id"/>
                                    <field name="year"/>
                                    <field name="total_amount" string="Class Fee" sum="Total Expected"/>
                                    <field name="total_paid" sum="Total Paid"/>
                                    <field name="total_balance" sum="Total Balance"/>
                                    <field name="installment_1_amount" string="Inst 1" optional="show"/>
                                    <field name="installment_1_status" widget="badge" optional="show"/>
                                    <field name="installment_1_due_date" optional="show"/>
                                    <field name="installment_2_amount" string="Inst 2" optional="show"/>
                                    <field name="installment_2_status" widget="badge" optional="show"/>
                                    <field name="installment_2_due_date" optional="show"/>
                                    <field name="next_deadline" optional="show"/>
                                    <field name="deadline_status" widget="badge"
                                           decoration-success="deadline_status == 'paid'"
                                           decoration-danger="deadline_status == 'overdue'"
                                           decoration-warning="deadline_status == 'today'"
                                           decoration-info="deadline_status == 'upcoming'"
                                           optional="show"/>
                                    <field name="is_custom_deadline" widget="boolean_toggle" string="Custom Schedule" optional="show"/>
                                    <field name="overall_status" widget="badge"/>
                                    <button name="action_open_deadline_wizard" type="object" string="Set Deadline"
                                            class="btn-sm btn-outline-primary" icon="fa-calendar-check-o"
                                            title="Set specific deadline schedule for this student" groups="school_management.group_school_admin"/>
                                    <button name="action_pay_installment_1" type="object" string="Pay Inst 1"
                                            class="btn-sm btn-outline-success" invisible="installment_1_status == 'paid'" groups="school_management.group_school_admin"/>
                                    <button name="action_pay_installment_2" type="object" string="Pay Inst 2"
                                            class="btn-sm btn-outline-success" invisible="installment_2_status == 'paid'" groups="school_management.group_school_admin"/>
                                    <button name="action_sync_from_class" type="object" string="Sync"
                                            icon="fa-refresh" title="Sync this student's payment with class" class="btn-sm btn-link text-primary" groups="school_management.group_school_admin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids"/>
                        </page>
                        <page string="Curriculum &amp; Teaching Staff" name="subjects">
                            <div class="card border rounded-3 bg-light-subtle mt-3 mb-3 shadow-none">
                                <div class="card-body p-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <div class="d-flex align-items-center px-3 py-1 bg-white rounded-pill border shadow-sm">
                                                <i class="fa fa-book text-primary me-2" title="Subjects"/>
                                                <span class="text-muted small me-1">Subjects:</span>
                                                <span class="fw-bold text-dark"><field name="teaching_assignment_count"/></span>
                                            </div>
                                            <div class="d-flex align-items-center px-3 py-1 bg-white rounded-pill border shadow-sm">
                                                <i class="fa fa-clock-o text-info me-2" title="Weekly Hours"/>
                                                <span class="text-muted small me-1">Class Load:</span>
                                                <span class="fw-bold text-dark"><field name="total_weekly_class_hours" widget="float_time"/></span>
                                            </div>
                                            <div class="d-flex align-items-center px-3 py-1 bg-white rounded-pill border shadow-sm">
                                                <i class="fa fa-calendar-check-o text-secondary me-2" title="Timetable"/>
                                                <span class="text-muted small me-1">Weekly Periods:</span>
                                                <span class="fw-bold text-dark"><field name="total_weekly_class_sessions"/></span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <button name="action_sync_subjects_to_students" type="object"
                                                    string="Sync Subjects to Enrolled Students" icon="fa-refresh"
                                                    class="btn btn-primary btn-sm px-3 shadow-sm text-nowrap" groups="school_management.group_school_admin"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <field name="teaching_assignment_ids" context="{'default_class_id': id}">
                                <list editable="bottom"
                                      decoration-success="schedule_status == 'fully_scheduled'"
                                      decoration-warning="schedule_status == 'under_scheduled'"
                                      decoration-danger="schedule_status == 'over_scheduled'"
                                      decoration-muted="schedule_status == 'not_scheduled'">
                                    <field name="subject_id" options="{'no_create': True}"/>
                                    <field name="teacher_id" options="{'no_create': True}"/>
                                    <field name="weekly_hours" widget="float_time" sum="Total Hours"/>
                                    <field name="weekly_sessions" sum="Total Sessions"/>
                                    <field name="scheduled_hours" widget="float_time"/>
                                    <field name="scheduled_sessions"/>
                                    <field name="student_count" string="Students"/>
                                    <field name="schedule_status" widget="badge"
                                           decoration-success="schedule_status == 'fully_scheduled'"
                                           decoration-warning="schedule_status == 'under_scheduled'"
                                           decoration-danger="schedule_status == 'over_scheduled'"
                                           decoration-muted="schedule_status == 'not_scheduled'"/>
                                    <button name="action_view_timetable" type="object"
                                            icon="fa-calendar" title="View Timetable Slots"
                                            class="btn-sm btn-link text-secondary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="payment_year"/>
                <field name="current_term_id"/>
                <field name="major_id"/>
                <field name="teacher_id"/>
                <field name="room"/>
                <separator/>
                <filter string="Year 2026-2027" name="filter_year_2026_2027" domain="[('payment_year', '=', '2026-2027')]"/>
                <filter string="Year 2025-2026" name="filter_year_2025_2026" domain="[('payment_year', '=', '2025-2026')]"/>
                <filter string="Year 2024-2025" name="filter_year_2024_2025" domain="[('payment_year', '=', '2024-2025')]"/>
                <separator/>
                <filter string="Class Teacher" name="group_teacher" domain="[]" context="{'group_by':'teacher_id'}"/>
                <filter string="Section" name="group_section" domain="[]" context="{'group_by':'section'}"/>
                <filter string="Major" name="group_major" domain="[]" context="{'group_by':'major_id'}"/>
                <filter string="Current Term" name="group_term" domain="[]" context="{'group_by':'current_term_id'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'payment_year'}"/>
            </search>
        </field>
    </record>

    <record id="action_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_class_search"/>
    </record>
</odoo>
