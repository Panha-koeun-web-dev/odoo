<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="section"/>
                <field name="major_id"/>
                <field name="room"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="capacity_progress" string="Capacity %"/>
                <field name="payment_year" optional="show"/>
                <field name="total_payment" widget="monetary" optional="show"/>
                <field name="total_payment_collected" widget="monetary" optional="hide"/>
                <field name="total_payment_balance" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_class_kanban" model="ir.ui.view">
        <field name="name">school.class.kanban</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="false">
                <field name="name"/>
                <field name="section"/>
                <field name="major_id"/>
                <field name="room"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="capacity_progress"/>
                <field name="total_payment"/>
                <field name="payment_collection_rate"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <span class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter bg-primary">
                                        <i class="fa fa-university" title="Class"/>
                                    </span>
                                </span>
                                <div>
                                    <strong class="o_kanban_record_title d-block">
                                        <field name="name"/>
                                        <t t-if="record.section.raw"> - <field name="section"/></t>
                                    </strong>
                                    <span class="text-muted"><i class="fa fa-map-marker me-1" title="Room"/><field name="room"/></span>
                                </div>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="text-muted">
                                    <i class="fa fa-user-circle-o me-1" title="Class teacher"/>Class Teacher:
                                    <field name="teacher_id" placeholder="Not assigned"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer mt-2">
                                <field name="capacity_progress" widget="progressbar"
                                       progress="capacity_progress > 100 ? 100 : capacity_progress" string="Capacity"/>
                                <div class="text-muted text-end">
                                    <field name="student_count"/> / <field name="capacity"/> students
                                </div>
                                <t t-if="record.total_payment.raw > 0">
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                        <span class="text-muted small"><i class="fa fa-money me-1"/>Tuition: <field name="total_payment"/></span>
                                        <span class="badge bg-light text-primary"><field name="payment_collection_rate"/>% Paid</span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_take_attendance" string="Take Attendance" type="object" class="btn-primary" icon="fa-calendar-check-o"/>
                    <button name="action_generate_year_payments" string="Apply Class Payment to All Students" type="object" class="btn-primary" icon="fa-refresh" invisible="not total_payment"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_year_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="year_payment_count"/></span>
                                <span class="o_stat_text">Year Payments</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Class Name"/>
                        </h1>
                    </div>
                    <group class="mt-3">
                        <group string="Class Details">
                            <field name="code"/>
                            <field name="section"/>
                            <field name="major_id"/>
                            <field name="room"/>
                            <field name="teacher_id"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity"/>
                            <field name="student_count" readonly="1"/>
                            <field name="capacity_progress" readonly="1" widget="progressbar"
                                   progress="capacity_progress > 100 ? 100 : capacity_progress" string="Capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students" name="students">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="text-muted mb-0"><i class="fa fa-users me-1" title="Students"/> Enrolled Students in this Class</h6>
                            </div>
                            <field name="student_ids" readonly="1">
                                <list decoration-danger="study_status == 'stopped'" decoration-muted="not active">
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="study_status" widget="badge"
                                           decoration-success="study_status == 'studying'"
                                           decoration-danger="study_status == 'stopped'"/>
                                    <field name="gender" widget="badge" optional="show"/>
                                    <field name="phone" optional="show"/>
                                    <field name="total_year_amount" string="Class Tuition" widget="monetary" sum="Total Tuition"/>
                                    <field name="total_year_paid" string="Paid" widget="monetary" sum="Total Paid"/>
                                    <field name="total_year_balance" string="Balance" widget="monetary" sum="Total Due"/>
                                    <field name="year_payment_status" widget="badge"
                                           decoration-success="year_payment_status == 'paid'"
                                           decoration-danger="year_payment_status == 'overdue'"
                                           decoration-warning="year_payment_status == 'partial'"
                                           decoration-info="year_payment_status == 'pending'"
                                           decoration-muted="year_payment_status == 'no_record'"/>
                                    <button name="action_open_stop_study_wizard" type="object" string="Stop" icon="fa-ban"
                                            title="Stop / Kick Student" class="text-danger" invisible="study_status == 'stopped'"/>
                                    <button name="action_continue_study" type="object" string="Continue" icon="fa-play"
                                            title="Continue Study" class="text-success" invisible="study_status != 'stopped'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment / Tuition" name="payments">
                            <!-- Financial Summary KPI Cards -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Class Tuition per Student</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50">Standard for this Class</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-info text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Total Expected</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment_expected" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50"><field name="year_payment_count"/> Student(s)</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-success text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Total Collected</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment_collected" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50"><field name="payment_collection_rate"/>% Paid</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="card border-0 shadow-sm h-100 bg-danger text-white">
                                        <div class="card-body text-center p-3">
                                            <div class="text-uppercase text-white-50 small fw-bold">Total Balance</div>
                                            <h3 class="fw-bold mb-0"><field name="total_payment_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                            <small class="text-white-50">Outstanding Due</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center" role="status">
                                <i class="fa fa-info-circle fa-lg me-2 text-primary" title="Information"/>
                                <span>Configure payment for this class below. Every student enrolled in this class will automatically follow this payment schedule unless a specific custom deadline schedule is set for them.</span>
                            </div>

                            <group string="Class Tuition &amp; Installments Configuration">
                                <group string="Academic Year &amp; Total Tuition">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="payment_year" placeholder="e.g. 2024-2025"/>
                                    <field name="total_payment" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="year_start"/>
                                    <field name="year_end"/>
                                </group>
                                <group string="Installments Breakdown &amp; Deadlines">
                                    <field name="installment_1_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="installment_1_due_date"/>
                                    <field name="installment_2_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="installment_2_due_date"/>
                                    <field name="payment_deadline"/>
                                </group>
                            </group>

                            <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                                <div>
                                    <h5 class="mb-0 fw-bold">Student Payment Records (<field name="payment_year" readonly="1"/>)</h5>
                                    <small class="text-muted">Students follow this class payment schedule, or can have a custom deadline set specifically for them.</small>
                                </div>
                                <div>
                                    <button name="action_generate_year_payments" string="Apply Class Payment to All Students"
                                            type="object" class="btn btn-sm btn-primary" icon="fa-refresh" invisible="not total_payment"/>
                                </div>
                            </div>
                            <field name="year_payment_ids" readonly="1">
                                <list decoration-danger="overall_status == 'overdue' or deadline_status == 'overdue'"
                                      decoration-success="overall_status == 'paid'"
                                      decoration-warning="overall_status == 'partial' or deadline_status == 'today'"
                                      decoration-muted="overall_status == 'pending'">
                                    <field name="student_id"/>
                                    <field name="year"/>
                                    <field name="total_amount" string="Class Fee" sum="Total Expected"/>
                                    <field name="total_paid" sum="Total Paid"/>
                                    <field name="total_balance" sum="Total Balance"/>
                                    <field name="installment_1_amount" string="Inst 1" optional="show"/>
                                    <field name="installment_1_status" widget="badge" optional="show"/>
                                    <field name="installment_1_due_date" optional="show"/>
                                    <field name="installment_2_amount" string="Inst 2" optional="show"/>
                                    <field name="installment_2_status" widget="badge" optional="show"/>
                                    <field name="installment_2_due_date" optional="show"/>
                                    <field name="next_deadline" optional="show"/>
                                    <field name="deadline_status" widget="badge"
                                           decoration-success="deadline_status == 'paid'"
                                           decoration-danger="deadline_status == 'overdue'"
                                           decoration-warning="deadline_status == 'today'"
                                           decoration-info="deadline_status == 'upcoming'"
                                           optional="show"/>
                                    <field name="is_custom_deadline" widget="boolean_toggle" string="Custom Schedule" optional="show"/>
                                    <field name="overall_status" widget="badge"/>
                                    <button name="action_open_deadline_wizard" type="object" string="Set Deadline"
                                            class="btn-sm btn-outline-primary" icon="fa-calendar-check-o"
                                            title="Set specific deadline schedule for this student"/>
                                    <button name="action_pay_installment_1" type="object" string="Pay Inst 1"
                                            class="btn-sm btn-outline-success" invisible="installment_1_status == 'paid'"/>
                                    <button name="action_pay_installment_2" type="object" string="Pay Inst 2"
                                            class="btn-sm btn-outline-success" invisible="installment_2_status == 'paid'"/>
                                    <button name="action_sync_from_class" type="object" string="Sync"
                                            icon="fa-refresh" title="Sync this student's payment with class" class="btn-sm btn-link text-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids"/>
                        </page>
                        <page string="Subjects" name="subjects">
                            <field name="subject_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="payment_year"/>
                <field name="major_id"/>
                <field name="teacher_id"/>
                <field name="room"/>
                <separator/>
                <filter string="Class Teacher" name="group_teacher" domain="[]" context="{'group_by':'teacher_id'}"/>
                <filter string="Section" name="group_section" domain="[]" context="{'group_by':'section'}"/>
                <filter string="Major" name="group_major" domain="[]" context="{'group_by':'major_id'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'payment_year'}"/>
            </search>
        </field>
    </record>

    <record id="action_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_class_search"/>
    </record>
</odoo>
