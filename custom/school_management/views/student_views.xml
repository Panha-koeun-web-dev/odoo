<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list decoration-info="age &lt; 13" decoration-muted="not active" editable="bottom" multi_edit="1">
                <field name="student_id"/>
                <field name="photo" widget="image" class="o_image_64_cover" options="{'no_attachment_counter': True}"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="gender" widget="badge"/>
                <field name="date_of_birth" optional="show"/>
                <field name="age" optional="hide"/>
                <field name="email" optional="hide"/>
                <field name="phone" optional="show"/>
                <field name="parent_phone" optional="hide"/>
                <field name="enrollment_date" optional="show"/>
                <field name="absent_count" string="Absent Days" optional="show"
                       widget="badge" decoration-danger="absent_count &gt; 0"/>
                <field name="attendance_rate" string="Att. Rate %" optional="show"/>
                <field name="study_start_date" optional="hide"/>
                <field name="study_end_date" optional="hide"/>
                <field name="study_period" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="photo"/>
                <field name="gender"/>
                <field name="parent_phone"/>
                <field name="age"/>
                <field name="absent_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-if="record.photo.raw" t-attf-src="data:image/png;base64,#{record.photo.raw}"
                                     class="o_image_64_cover" alt="Student Photo"/>
                                <span t-else="" class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter">S</span>
                                </span>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted">
                                    <i class="fa fa-id-badge me-1" title="Student ID"/>
                                    <field name="student_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/>
                                    <field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-phone me-1" title="Parent phone"/>
                                    <field name="parent_phone"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <field name="gender" widget="badge"/>
                                <span t-attf-class="badge bg-light text-dark ms-1">
                                    <i class="fa fa-user-o me-1" title="Age"/><t t-esc="record.age.raw"/> yrs
                                </span>
                                <span t-if="record.absent_count.raw &gt; 0" class="badge bg-danger text-white ms-1" title="Days Absent">
                                    <i class="fa fa-user-times me-1"/><t t-esc="record.absent_count.raw"/> Absent
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_attendance" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="attendance_count"/></span>
                                <span class="o_stat_text">Attendance</span>
                            </div>
                        </button>
                        <button name="open_absent_attendance" type="object" class="oe_stat_button" icon="fa-user-times">
                            <div class="o_stat_info">
                                <span class="o_stat_value text-danger"><field name="absent_count"/></span>
                                <span class="o_stat_text text-danger">Days Absent</span>
                            </div>
                        </button>
                        <button name="open_grades" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <div class="o_stat_info"><span class="o_stat_text">Grades</span></div>
                        </button>
                        <button name="open_fees" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info"><span class="o_stat_text">Fees</span></div>
                        </button>
                        <button name="open_enrollments" type="object" class="oe_stat_button" icon="fa-user-plus">
                            <div class="o_stat_info"><span class="o_stat_text">Enrollments</span></div>
                        </button>
                        <button name="open_major_enrollments" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <div class="o_stat_info"><span class="o_stat_text">Majors</span></div>
                        </button>
                        <button name="action_generate_certificate" type="object" class="oe_stat_button" icon="fa-trophy">
                            <div class="o_stat_info"><span class="o_stat_text">Certificate</span></div>
                        </button>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <field name="photo" widget="image" class="oe_avatar"/>
                        </div>
                        <div class="col-10">
                            <div class="oe_title">
                                <h1>
                                    <field name="name" placeholder="Student Name"/>
                                </h1>
                            </div>
                            <div class="mt-2">
                                <field name="gender" widget="badge" bg_color="gender == 'male' ? 'bg-teal-200 text-teal-900' : gender == 'female' ? 'bg-pink-200 text-pink-900' : 'bg-purple-200 text-purple-900'"/>
                                <span class="text-muted ms-1">ID: <field name="student_id" class="d-inline"/></span>
                            </div>
                        </div>
                    </div>
                    <group string="Personal Information">
                        <group>
                            <field name="date_of_birth"/>
                            <field name="age" string="Age" readonly="1"/>
                            <field name="gender"/>
                            <field name="address"/>
                        </group>
                        <group string="Academic Information">
                            <field name="class_id"/>
                            <field name="enrollment_date"/>
                            <field name="study_start_date"/>
                            <field name="study_end_date"/>
                            <field name="study_period" readonly="1"/>
                            <field name="major_ids" widget="many2many_tags"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parent / Guardian" name="parent">
                            <group string="Contact Details">
                                <group>
                                    <field name="parent_name"/>
                                    <field name="parent_phone"/>
                                </group>
                                <group>
                                    <field name="parent_email"/>
                                    <field name="user_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Attendance" name="attendance">
                            <!-- Daily Attendance Action Bar -->
                            <div class="p-3 mb-3 border rounded bg-light">
                                <div class="row align-items-center">
                                    <div class="col-md-5">
                                        <div class="d-flex align-items-center gap-2">
                                            <strong>Today's Status:</strong>
                                            <field name="today_attendance_status" widget="badge"
                                                   decoration-success="today_attendance_status == 'present'"
                                                   decoration-danger="today_attendance_status == 'absent'"
                                                   decoration-warning="today_attendance_status == 'late'"
                                                   decoration-info="today_attendance_status == 'excused'"
                                                   decoration-muted="today_attendance_status == 'not_marked'"/>
                                        </div>
                                    </div>
                                    <div class="col-md-7 text-md-end mt-2 mt-md-0">
                                        <div class="btn-group" role="group">
                                            <button name="action_mark_present_today" type="object" string="Mark Present Today" class="btn btn-sm btn-outline-success" icon="fa-check"/>
                                            <button name="action_mark_absent_today" type="object" string="Mark Absent Today" class="btn btn-sm btn-outline-danger" icon="fa-times"/>
                                            <button name="action_mark_late_today" type="object" string="Mark Late Today" class="btn btn-sm btn-outline-warning" icon="fa-clock-o"/>
                                            <button name="action_mark_excused_today" type="object" string="Mark Excused Today" class="btn btn-sm btn-outline-secondary" icon="fa-envelope-o"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Attendance Summary Stats -->
                            <div class="row g-3 mb-3 text-center">
                                <div class="col-md-2 col-6">
                                    <div class="p-2 border rounded bg-white shadow-sm">
                                        <div class="text-muted small">Total Recorded</div>
                                        <h3 class="fw-bold mb-0 text-dark"><field name="attendance_count"/></h3>
                                        <small class="text-muted">Days</small>
                                    </div>
                                </div>
                                <div class="col-md-2 col-6">
                                    <div class="p-2 border rounded bg-white shadow-sm border-danger">
                                        <div class="text-danger small fw-bold">Absent Days</div>
                                        <h3 class="fw-bold mb-0 text-danger"><field name="absent_count"/></h3>
                                        <small class="text-danger">Missed</small>
                                    </div>
                                </div>
                                <div class="col-md-2 col-6">
                                    <div class="p-2 border rounded bg-white shadow-sm border-success">
                                        <div class="text-success small fw-bold">Present Days</div>
                                        <h3 class="fw-bold mb-0 text-success"><field name="present_count"/></h3>
                                        <small class="text-success">Attended</small>
                                    </div>
                                </div>
                                <div class="col-md-2 col-6">
                                    <div class="p-2 border rounded bg-white shadow-sm border-warning">
                                        <div class="text-warning small fw-bold">Late Days</div>
                                        <h3 class="fw-bold mb-0 text-warning"><field name="late_count"/></h3>
                                        <small class="text-muted">Tardy</small>
                                    </div>
                                </div>
                                <div class="col-md-2 col-6">
                                    <div class="p-2 border rounded bg-white shadow-sm">
                                        <div class="text-muted small">Excused</div>
                                        <h3 class="fw-bold mb-0 text-secondary"><field name="excused_count"/></h3>
                                        <small class="text-muted">Leave</small>
                                    </div>
                                </div>
                                <div class="col-md-2 col-6">
                                    <div class="p-2 border rounded bg-white shadow-sm border-primary">
                                        <div class="text-primary small fw-bold">Attendance Rate</div>
                                        <h3 class="fw-bold mb-0 text-primary"><field name="attendance_rate"/>%</h3>
                                        <small class="text-muted">Overall</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Attendance History -->
                            <field name="attendance_ids" nolabel="1">
                                <list editable="bottom" default_order="date desc"
                                      decoration-success="status == 'present'"
                                      decoration-danger="status == 'absent'"
                                      decoration-warning="status == 'late'"
                                      decoration-muted="status == 'excused'">
                                    <field name="date"/>
                                    <field name="class_id" optional="show" readonly="1"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'present'"
                                           decoration-danger="status == 'absent'"
                                           decoration-warning="status == 'late'"
                                           decoration-muted="status == 'excused'"/>
                                    <field name="notes" placeholder="Reason for absence or remarks..."/>
                                </list>
                            </field>
                        </page>
                        <page string="Grades" name="grades">
                            <field name="grade_ids"/>
                        </page>
                        <page string="Fees" name="fees">
                            <field name="fee_ids"/>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids"/>
                        </page>
                        <page string="Major Enrollments" name="major_enrollments">
                            <field name="major_enrollment_ids"/>
                        </page>
                        <page string="Certificates" name="certificates">
                            <field name="certificate_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="email"/>
                <filter name="filter_male" string="Male" domain="[('gender','=','male')]" help="Only male students"/>
                <filter name="filter_female" string="Female" domain="[('gender','=','female')]" help="Only female students"/>
                <separator/>
                <filter name="filter_has_absent" string="Has Absences" domain="[('absent_count', '&gt;', 0)]"/>
                <filter name="filter_high_absent" string="High Absences (&gt;= 3)" domain="[('absent_count', '&gt;=', 3)]"/>
                <filter name="filter_absent_today" string="Absent Today" domain="[('attendance_ids.date', '=', context_today().strftime('%Y-%m-%d')), ('attendance_ids.status', '=', 'absent')]"/>
                <separator/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Major" name="group_major" domain="[]" context="{'group_by':'major_ids'}"/>
                <filter string="Gender" name="group_gender" domain="[]" context="{'group_by':'gender'}"/>
                <filter string="Enrollment Date" name="group_enroll" domain="[]" context="{'group_by':'enrollment_date'}"/>
            </search>
        </field>
    </record>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_student_search"/>
    </record>

    <record id="action_bulk_enroll_students" model="ir.actions.server">
        <field name="name">Bulk Enroll</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[(4, ref('school_management.group_school_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_enroll()</field>
    </record>

    <record id="action_print_students_certificate" model="ir.actions.server">
        <field name="name">Print Certificate</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[(4, ref('school_management.group_school_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_print_student_certificates()</field>
    </record>
</odoo>
