<odoo>
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="parent_phone"/>
                <field name="enrollment_date"/>
            </list>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Student Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="student_id"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                        </group>
                        <group string="Academic Information">
                            <field name="class_id"/>
                            <field name="enrollment_date"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parent/Guardian" name="parent">
                            <group>
                                <field name="parent_name"/>
                                <field name="parent_phone"/>
                                <field name="parent_email"/>
                                <field name="address"/>
                            </group>
                        </page>
                        <page string="Fees" name="fees">
                            <field name="fee_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <filter name="filter_male" string="Male" domain="[('gender','=','male')]"/>
                <filter name="filter_female" string="Female" domain="[('gender','=','female')]"/>
                <separator/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Gender" name="group_gender" domain="[]" context="{'group_by':'gender'}"/>
            </search>
        </field>
    </record>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_search"/>
    </record>
</odoo>
