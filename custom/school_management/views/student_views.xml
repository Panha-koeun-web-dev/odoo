<odoo>
    <!-- ======================= STOP STUDY WIZARD FORM ======================= -->
    <record id="view_school_student_stop_wizard_form" model="ir.ui.view">
        <field name="name">school.student.stop.wizard.form</field>
        <field name="model">school.student.stop.wizard</field>
        <field name="arch" type="xml">
            <form string="Stop Student Study">
                <div class="alert alert-warning mb-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                    Stopping this student will change their status to <strong>Stopped Studying</strong> and exclude them from daily attendance taking. You can resume their studies anytime using the <strong>Continue Study</strong> button.
                </div>
                <group>
                    <field name="student_id" readonly="1"/>
                    <field name="stop_date"/>
                    <field name="reason_type"/>
                    <field name="stop_reason" placeholder="Provide reason or remarks for stopping study / kicking student..."/>
                </group>
                <footer>
                    <button string="Confirm Stop Study" name="action_confirm_stop" type="object" class="btn-danger" icon="fa-ban"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list decoration-info="age &lt; 13" decoration-muted="not active" decoration-danger="study_status == 'stopped'" editable="bottom" multi_edit="1">
                <field name="student_id"/>
                <field name="photo" widget="image" class="o_image_64_cover" options="{'no_attachment_counter': True}"/>
                <field name="name"/>
                <field name="study_status" widget="badge"
                       decoration-success="study_status == 'studying'"
                       decoration-danger="study_status == 'stopped'"/>
                <field name="class_id"/>
                <field name="class_total_payment" widget="monetary" optional="hide"/>
                <field name="year_payment_status" widget="badge" optional="show"
                       decoration-success="year_payment_status == 'paid'"
                       decoration-danger="year_payment_status == 'overdue'"
                       decoration-warning="year_payment_status == 'partial'"
                       decoration-info="year_payment_status == 'pending'"/>
                <field name="gender" widget="badge" optional="show"/>
                <field name="date_of_birth" optional="hide"/>
                <field name="age" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="parent_phone" optional="hide"/>
                <field name="enrollment_date" optional="show"/>
                <field name="absent_count" string="Absent Days" optional="show"
                       widget="badge" decoration-danger="absent_count &gt; 0"/>
                <field name="attendance_rate" string="Att. Rate %" optional="show"/>
                <field name="study_start_date" optional="hide"/>
                <field name="study_end_date" optional="hide"/>
                <field name="study_period" optional="show"/>
                <field name="stop_date" optional="hide"/>
                <field name="stop_reason" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="active" optional="hide"/>
                <button name="action_open_stop_study_wizard" type="object" string="Stop Study" icon="fa-ban"
                        title="Stop / Kick Student" class="text-danger" invisible="study_status == 'stopped'"
                        groups="school_management.group_school_admin"/>
                <button name="action_continue_study" type="object" string="Continue Study" icon="fa-play"
                        title="Continue / Resume Study" class="text-success" invisible="study_status != 'stopped'"
                        groups="school_management.group_school_admin"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="class_total_payment"/>
                <field name="photo"/>
                <field name="gender"/>
                <field name="parent_phone"/>
                <field name="age"/>
                <field name="absent_count"/>
                <field name="year_payment_status"/>
                <field name="study_status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-if="record.photo.raw" t-attf-src="data:image/png;base64,#{record.photo.raw}"
                                     class="o_image_64_cover" alt="Student Photo"/>
                                <span t-else="" class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter">S</span>
                                </span>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted">
                                    <i class="fa fa-id-badge me-1" title="Student ID"/>
                                    <field name="student_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/>
                                    <field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-phone me-1" title="Parent phone"/>
                                    <field name="parent_phone"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <field name="gender" widget="badge"/>
                                <field name="study_status" widget="badge" class="ms-1"
                                       decoration-success="study_status == 'studying'"
                                       decoration-danger="study_status == 'stopped'"/>
                                <span t-attf-class="badge bg-light text-dark ms-1">
                                    <i class="fa fa-user-o me-1" title="Age"/><t t-esc="record.age.raw"/> yrs
                                </span>
                                <span t-if="record.absent_count.raw &gt; 0" class="badge bg-danger text-white ms-1" title="Days Absent">
                                    <i class="fa fa-user-times me-1"/><t t-esc="record.absent_count.raw"/> Absent
                                </span>
                                <t t-if="record.year_payment_status.raw and record.year_payment_status.raw != 'no_record'">
                                    <field name="year_payment_status" widget="badge" class="ms-1"
                                           decoration-success="year_payment_status == 'paid'"
                                           decoration-danger="year_payment_status == 'overdue'"
                                           decoration-warning="year_payment_status == 'partial'"
                                           decoration-info="year_payment_status == 'pending'"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_user" type="object"
                            string="Create Login Account" class="btn-primary" icon="fa-user-plus"
                            invisible="user_id"
                            groups="school_management.group_school_admin"/>
                    <button name="action_reset_user_password" type="object"
                            string="Reset Password" class="btn-secondary" icon="fa-key"
                            invisible="not user_id"
                            groups="school_management.group_school_admin"/>
                    <button name="action_open_stop_study_wizard" type="object"
                            string="Stop Study (Kick)" class="btn-danger" icon="fa-ban"
                            invisible="study_status == 'stopped'"
                            groups="school_management.group_school_admin"/>
                    <button name="action_continue_study" type="object"
                            string="Continue Study" class="btn-success" icon="fa-play"
                            invisible="study_status != 'stopped'"
                            groups="school_management.group_school_admin"/>
                    <button name="action_sync_year_payment_from_class" type="object"
                            string="Sync Payment Schedule" class="btn-secondary" icon="fa-refresh"
                            invisible="not class_id"
                            groups="school_management.group_school_admin"/>
                    <field name="study_status" widget="statusbar" statusbar_visible="studying,stopped"/>
                </header>
                <sheet>
                    <!-- Visual alert banner when student is stopped -->
                    <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-3" role="alert" invisible="study_status != 'stopped'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-ban fa-2x text-danger me-3" title="Stopped Student"/>
                            <div>
                                <h5 class="alert-heading mb-0 text-danger fw-bold">Student Has Stopped Studying</h5>
                                <div class="text-muted small mt-1">
                                    Status: <strong>Stopped</strong> since <field name="stop_date" readonly="1" class="d-inline fw-bold"/>.
                                    <span invisible="not stop_reason"> Reason: <field name="stop_reason" readonly="1" class="d-inline"/></span>
                                </div>
                            </div>
                        </div>
                        <button name="action_continue_study" type="object" string="Resume Study" class="btn btn-success ms-3" icon="fa-play" groups="school_management.group_school_admin"/>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="open_attendance" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="attendance_count"/></span>
                                <span class="o_stat_text">Attendance</span>
                            </div>
                        </button>
                        <button name="open_absent_attendance" type="object" class="oe_stat_button" icon="fa-user-times">
                            <div class="o_stat_info">
                                <span class="o_stat_value text-danger"><field name="absent_count"/></span>
                                <span class="o_stat_text text-danger">Days Absent</span>
                            </div>
                        </button>
                        <button name="open_grades" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <div class="o_stat_info"><span class="o_stat_text">Grades</span></div>
                        </button>
                        <button name="open_fees" type="object" class="oe_stat_button" icon="fa-money" groups="school_management.group_school_admin">
                            <div class="o_stat_info"><span class="o_stat_text">Fees</span></div>
                        </button>
                        <button name="open_enrollments" type="object" class="oe_stat_button" icon="fa-user-plus" groups="school_management.group_school_admin">
                            <div class="o_stat_info"><span class="o_stat_text">Enrollments</span></div>
                        </button>
                        <button name="open_major_enrollments" type="object" class="oe_stat_button" icon="fa-graduation-cap" groups="school_management.group_school_admin">
                            <div class="o_stat_info"><span class="o_stat_text">Majors</span></div>
                        </button>
                        <button name="action_generate_certificate" type="object" class="oe_stat_button" icon="fa-trophy" groups="school_management.group_school_admin">
                            <div class="o_stat_info"><span class="o_stat_text">Certificate</span></div>
                        </button>
                        <button name="open_year_payments" type="object" class="oe_stat_button" icon="fa-calendar" groups="school_management.group_school_admin,school_management.group_school_student">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="year_payment_count"/></span>
                                <span class="o_stat_text">Year Payments</span>
                            </div>
                        </button>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <field name="photo" widget="image" class="oe_avatar"/>
                        </div>
                        <div class="col-10">
                            <div class="oe_title">
                                <h1>
                                    <field name="name" placeholder="Student Name"/>
                                </h1>
                            </div>
                            <div class="mt-2">
                                <field name="gender" widget="badge" bg_color="gender == 'male' ? 'bg-teal-200 text-teal-900' : gender == 'female' ? 'bg-pink-200 text-pink-900' : 'bg-purple-200 text-purple-900'"/>
                                <span class="text-muted ms-1">ID: <field name="student_id" class="d-inline"/></span>
                                <field name="study_status" widget="badge" class="ms-2"
                                       decoration-success="study_status == 'studying'"
                                       decoration-danger="study_status == 'stopped'"/>
                            </div>
                        </div>
                    </div>
                    <group string="Personal Information">
                        <group>
                            <field name="date_of_birth"/>
                            <field name="age" string="Age" readonly="1"/>
                            <field name="gender"/>
                            <field name="address"/>
                            <field name="user_id" string="User Account" groups="school_management.group_school_admin"/>
                        </group>
                        <group string="Academic Information">
                            <field name="currency_id" invisible="1"/>
                            <field name="study_status" widget="badge"
                                   decoration-success="study_status == 'studying'"
                                   decoration-danger="study_status == 'stopped'"/>
                            <field name="stop_date" invisible="study_status != 'stopped'"/>
                            <field name="stop_reason" invisible="study_status != 'stopped'"/>
                            <field name="recontinue_date" invisible="not recontinue_date"/>
                            <field name="class_id"/>
                            <field name="class_total_payment" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not class_id"/>
                            <field name="enrollment_date"/>
                            <field name="study_start_date"/>
                            <field name="study_end_date"/>
                            <field name="study_period" readonly="1"/>
                            <field name="major_ids" widget="many2many_tags"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parent / Guardian" name="parent">
                            <group string="Contact Details">
                                <group>
                                    <field name="parent_name"/>
                                    <field name="parent_phone"/>
                                </group>
                                <group>
                                    <field name="parent_email"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <separator/>
                <filter string="Studying" name="studying" domain="[('study_status', '=', 'studying')]"/>
                <filter string="Stopped Studying" name="stopped" domain="[('study_status', '=', 'stopped')]"/>
                <separator/>
                <filter string="Male" name="male" domain="[('gender', '=', 'male')]"/>
                <filter string="Female" name="female" domain="[('gender', '=', 'female')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by': 'class_id'}"/>
                <filter string="Study Status" name="group_study_status" domain="[]" context="{'group_by': 'study_status'}"/>
                <filter string="Gender" name="group_gender" domain="[]" context="{'group_by': 'gender'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= WINDOW ACTION ======================= -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_student_search"/>
        <field name="context">{'search_default_studying': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student record!
            </p>
        </field>
    </record>
</odoo>
