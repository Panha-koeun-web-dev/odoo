<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_subject_tree" model="ir.ui.view">
        <field name="name">school.subject.tree</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" widget="badge"/>
                <field name="name"/>
                <field name="teacher_ids" widget="many2many_tags" optional="show"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Subject Name"/>
                        </h1>
                    </div>
                    <group class="mt-3">
                        <group string="Subject Details">
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="Assigned Teachers" class="mt-3">
                        <field name="teacher_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_subject_search" model="ir.ui.view">
        <field name="name">school.subject.search</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Teacher" name="group_teacher" domain="[]" context="{'group_by':'teacher_ids'}"/>
            </search>
        </field>
    </record>

    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subject_search"/>
    </record>
</odoo>
