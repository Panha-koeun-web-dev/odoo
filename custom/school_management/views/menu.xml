    <menuitem id="menu_school_academic_parent" name="Academics"
              parent="menu_school_root" sequence="30"/>
    <menuitem id="menu_school_class" name="Classes"
              parent="menu_school_academic_parent"
              action="action_class" sequence="10"/>
    <menuitem id="menu_school_subject" name="Subjects"
              parent="menu_school_academic_parent"
              action="action_subject" sequence="20"/>
    <menuitem id="menu_school_major" name="Majors"
              parent="menu_school_academic_parent"
              action="action_major" sequence="30"/>
    <menuitem id="menu_school_major_enrollment_parent" name="Major Enrollment"
              parent="menu_school_academic_parent"
              sequence="40"/>
    <menuitem id="menu_school_major_enrollment" name="All Major Enrollments"
              parent="menu_school_major_enrollment_parent"
              action="action_major_enrollment" sequence="10"/>

