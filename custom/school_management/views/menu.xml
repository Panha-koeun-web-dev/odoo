<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_school_root"
              name="School"
              web_icon="school_management,static/description/icon.png"
              groups="school_management.group_school_admin,school_management.group_school_teacher,school_management.group_school_student"
              sequence="20"/>

    <!-- ================= 1. Dashboard ================= -->
    <menuitem id="menu_school_dashboard"
              name="Dashboard"
              parent="menu_school_root"
              action="action_school_dashboard"
              groups="school_management.group_school_admin,school_management.group_school_teacher"
              sequence="5"/>

    <!-- ================= 2. Students ================= -->
    <record id="menu_school_student_parent" model="ir.ui.menu">
        <field name="name">Students</field>
        <field name="parent_id" ref="menu_school_root"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('school_management.group_school_admin'), ref('school_management.group_school_teacher')])]"/>
    </record>
    <record id="menu_school_student" model="ir.ui.menu">
        <field name="name">Student Profiles</field>
        <field name="parent_id" ref="menu_school_student_parent"/>
        <field name="action" ref="action_student"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('school_management.group_school_admin'), ref('school_management.group_school_teacher')])]"/>
    </record>
    <record id="menu_school_enrollment" model="ir.ui.menu">
        <field name="name">Enrollments &amp; Weekly Subjects</field>
        <field name="parent_id" ref="menu_school_student_parent"/>
        <field name="action" ref="action_enrollment"/>
        <field name="sequence">15</field>
        <field name="group_ids" eval="[(6, 0, [ref('school_management.group_school_admin'), ref('school_management.group_school_teacher')])]"/>
    </record>
    <record id="menu_school_student_subject" model="ir.ui.menu">
        <field name="name">Weekly Study Subjects</field>
        <field name="parent_id" ref="menu_school_student_parent"/>
        <field name="action" ref="action_school_student_subject"/>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[(6, 0, [ref('school_management.group_school_admin'), ref('school_management.group_school_teacher')])]"/>
    </record>
    <record id="menu_school_student_permission" model="ir.ui.menu">
        <field name="name">Student Permissions</field>
        <field name="parent_id" ref="menu_school_student_parent"/>
        <field name="action" ref="action_school_permission_student"/>
        <field name="sequence">25</field>
        <field name="group_ids" eval="[(6, 0, [ref('school_management.group_school_admin'), ref('school_management.group_school_teacher')])]"/>
    </record>
    <menuitem id="menu_school_student_export_xlsx"
              name="Export Students (XLSX)"
              parent="menu_school_student_parent"
              action="action_school_report_student_xlsx"
              groups="school_management.group_school_admin,school_management.group_school_teacher"
              sequence="30"/>

    <!-- ================= 3. Teachers ================= -->
    <menuitem id="menu_school_teacher_parent"
              name="Teachers"
              parent="menu_school_root"
              groups="school_management.group_school_admin,school_management.group_school_teacher"
              sequence="20"/>
    <menuitem id="menu_school_teacher"
              name="Teacher Profiles"
              parent="menu_school_teacher_parent"
              action="action_teacher"
              groups="school_management.group_school_admin,school_management.group_school_teacher"
              sequence="10"/>
    <menuitem id="menu_school_teacher_assign_wizard"
              name="Assign Subjects &amp; Students"
              parent="menu_school_teacher_parent"
              action="action_school_assign_subject_wizard"
              groups="school_management.group_school_admin,school_management.group_school_teacher"
