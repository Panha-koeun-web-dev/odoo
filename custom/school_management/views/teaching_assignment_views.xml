<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_school_teaching_assignment_search" model="ir.ui.view">
        <field name="name">school.teaching.assignment.search</field>
        <field name="model">school.teaching.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Teaching Assignments">
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Fully Scheduled" name="fully_scheduled" domain="[('schedule_status', '=', 'fully_scheduled')]"/>
                <filter string="Under Scheduled" name="under_scheduled" domain="[('schedule_status', '=', 'under_scheduled')]"/>
                <filter string="Not Scheduled" name="not_scheduled" domain="[('schedule_status', '=', 'not_scheduled')]"/>
                <separator/>
                <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                <filter string="Schedule Status" name="group_status" context="{'group_by': 'schedule_status'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_school_teaching_assignment_list" model="ir.ui.view">
        <field name="name">school.teaching.assignment.list</field>
        <field name="model">school.teaching.assignment</field>
        <field name="arch" type="xml">
            <list string="Teacher Weekly Teaching Assignments"
                  decoration-success="schedule_status == 'fully_scheduled'"
                  decoration-warning="schedule_status == 'under_scheduled'"
                  decoration-danger="schedule_status == 'over_scheduled'"
                  decoration-muted="schedule_status == 'not_scheduled'">
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="weekly_hours" widget="float_time"/>
                <field name="weekly_sessions"/>
                <field name="scheduled_hours" widget="float_time"/>
                <field name="scheduled_sessions"/>
                <field name="student_count" string="Students"/>
                <field name="schedule_status" widget="badge"
                       decoration-success="schedule_status == 'fully_scheduled'"
                       decoration-warning="schedule_status == 'under_scheduled'"
                       decoration-danger="schedule_status == 'over_scheduled'"
                       decoration-muted="schedule_status == 'not_scheduled'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_school_teaching_assignment_kanban" model="ir.ui.view">
        <field name="name">school.teaching.assignment.kanban</field>
        <field name="model">school.teaching.assignment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="teacher_id">
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="weekly_hours"/>
                <field name="scheduled_hours"/>
                <field name="schedule_status"/>
                <field name="student_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="o_kanban_record_title fs-6">
                                <field name="subject_id"/>
                            </strong>
                            <field name="schedule_status" widget="badge"
                                   decoration-success="schedule_status == 'fully_scheduled'"
                                   decoration-warning="schedule_status == 'under_scheduled'"
                                   decoration-danger="schedule_status == 'over_scheduled'"
                                   decoration-muted="schedule_status == 'not_scheduled'"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-users me-1" title="Class"/> Class: <field name="class_id"/>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span><i class="fa fa-clock-o me-1" title="Weekly Hours"/> Target: <field name="weekly_hours"/>h/wk</span>
                            <span><i class="fa fa-calendar me-1" title="Scheduled Hours"/> Sched: <field name="scheduled_hours"/>h</span>
                            <span><i class="fa fa-graduation-cap me-1" title="Enrolled Students"/> <field name="student_count"/> students</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_school_teaching_assignment_form" model="ir.ui.view">
        <field name="name">school.teaching.assignment.form</field>
        <field name="model">school.teaching.assignment</field>
        <field name="arch" type="xml">
            <form string="Weekly Teaching Assignment">
                <header>
                    <button name="action_open_schedule_wizard" type="object"
                            string="Quick Schedule Session" class="btn-primary" icon="fa-calendar-plus-o"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="student_count"/></span>
                                <span class="o_stat_text">Students Taught</span>
                            </div>
                        </button>
                        <button name="action_view_timetable" type="object" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="scheduled_sessions"/></span>
                                <span class="o_stat_text">Timetable Slots</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="display_name" string="Assignment"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Core Information">
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="subject_id" options="{'no_create': True}"/>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Weekly Teaching Workload">
                            <field name="weekly_hours" widget="float_time"/>
                            <field name="weekly_sessions"/>
                            <field name="scheduled_hours" widget="float_time" readonly="1"/>
                            <field name="scheduled_sessions" readonly="1"/>
                            <field name="schedule_status" widget="badge"
                                   decoration-success="schedule_status == 'fully_scheduled'"
                                   decoration-warning="schedule_status == 'under_scheduled'"
                                   decoration-danger="schedule_status == 'over_scheduled'"
                                   decoration-muted="schedule_status == 'not_scheduled'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students Enrolled in Class" name="students">
                            <field name="student_ids" readonly="1">
                                <list string="Students">
                                    <field name="student_id" string="Student ID"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="phone"/>
                                    <field name="study_status" widget="badge"
                                           decoration-success="study_status == 'studying'"
                                           decoration-danger="study_status == 'stopped'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Syllabus" name="notes">
                            <field name="notes" placeholder="Specify weekly curriculum milestones, syllabus topics, and expectations..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- ======================= ACTION ======================= -->
    <record id="action_school_teaching_assignment" model="ir.actions.act_window">
        <field name="name">Teaching Assignments</field>
        <field name="res_model">school.teaching.assignment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_school_teaching_assignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign subjects and weekly teaching loads for teachers!
            </p>
            <p>
                Define which subjects each teacher must instruct for each class and specify expected weekly hours and sessions.
            </p>
        </field>
    </record>
</odoo>
