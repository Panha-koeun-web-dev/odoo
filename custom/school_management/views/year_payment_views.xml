<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_student_year_payment_list" model="ir.ui.view">
        <field name="name">school.student.year.payment.list</field>
        <field name="model">school.student.year.payment</field>
        <field name="arch" type="xml">
            <list decoration-danger="overall_status == 'overdue' or deadline_status == 'overdue'"
                  decoration-success="overall_status == 'paid'"
                  decoration-warning="overall_status == 'partial' or deadline_status == 'today'"
                  decoration-muted="overall_status == 'pending'">
                <field name="student_id"/>
                <field name="class_id" optional="show"/>
                <field name="year"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="total_paid" sum="Total Paid"/>
                <field name="total_balance" sum="Total Balance"/>
                
                <!-- Deadline Schedule Columns -->
                <field name="next_deadline" optional="show"/>
                <field name="days_until_deadline" optional="hide"/>
                <field name="deadline_status" widget="badge"
                       decoration-success="deadline_status == 'paid'"
                       decoration-danger="deadline_status == 'overdue'"
                       decoration-warning="deadline_status == 'today'"
                       decoration-info="deadline_status == 'upcoming'"
                       optional="show"/>
                <field name="is_custom_deadline" widget="boolean_toggle" string="Custom Schedule" optional="show"/>

                <!-- Installment 1 -->
                <field name="installment_1_amount" sum="Inst. 1 Amount" optional="hide"/>
                <field name="installment_1_paid_amount" sum="Inst. 1 Paid" optional="hide"/>
                <field name="installment_1_balance" sum="Inst. 1 Balance" optional="hide"/>
                <field name="installment_1_status" widget="badge" optional="show"/>
                <field name="installment_1_due_date" optional="show"/>
                
                <!-- Installment 2 -->
                <field name="installment_2_amount" sum="Inst. 2 Amount" optional="hide"/>
                <field name="installment_2_paid_amount" sum="Inst. 2 Paid" optional="hide"/>
                <field name="installment_2_balance" sum="Inst. 2 Balance" optional="hide"/>
                <field name="installment_2_status" widget="badge" optional="show"/>
                <field name="installment_2_due_date" optional="show"/>
                <field name="payment_deadline" optional="hide"/>

                <field name="overall_status" widget="badge"/>
                <field name="payment_method" optional="hide"/>
                <field name="receipt_number" optional="hide"/>
                
                <button name="action_open_deadline_wizard" type="object" string="Set Deadline"
                        class="btn-sm btn-outline-primary" icon="fa-calendar-check-o" title="Set specific payment deadline schedule"/>
                <button name="action_pay_installment_1" type="object" string="Pay Inst. 1"
                        class="btn-primary" icon="fa-money"
                        invisible="installment_1_status == 'paid' or installment_1_amount == 0"/>
                <button name="action_pay_installment_2" type="object" string="Pay Inst. 2"
                        class="btn-primary" icon="fa-money"
                        invisible="installment_2_status == 'paid' or installment_2_amount == 0"/>
                <button name="action_sync_from_class" type="object" string="Sync Class"
                        icon="fa-refresh" title="Sync payment schedule from assigned class" class="btn-sm btn-link text-primary"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_student_year_payment_kanban" model="ir.ui.view">
        <field name="name">school.student.year.payment.kanban</field>
        <field name="model">school.student.year.payment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="overall_status">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="year"/>
                <field name="total_amount"/>
                <field name="total_paid"/>
                <field name="total_balance"/>
                <field name="overall_status"/>
                <field name="next_deadline"/>
                <field name="deadline_status"/>
                <field name="is_custom_deadline"/>
                <field name="installment_1_amount"/>
                <field name="installment_1_paid_amount"/>
                <field name="installment_1_balance"/>
                <field name="installment_1_status"/>
                <field name="installment_1_due_date"/>
                <field name="installment_2_amount"/>
                <field name="installment_2_paid_amount"/>
                <field name="installment_2_balance"/>
                <field name="installment_2_status"/>
                <field name="installment_2_due_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                    <h6 class="mb-0 fw-bold"><field name="student_id"/></h6>
                                    <field name="overall_status" widget="badge"/>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row mb-2">
                                        <div class="col-6">
                                            <small class="text-muted">Academic Year</small>
                                            <div class="fw-bold"><field name="year"/></div>
                                        </div>
                                        <div class="col-6 text-end">
                                            <small class="text-muted">Class</small>
                                            <div class="fw-bold"><field name="class_id"/></div>
                                        </div>
                                    </div>

                                    <!-- Deadline Info in Kanban -->
                                    <div class="p-2 mb-2 rounded bg-light border-start border-3 border-primary">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <small class="text-muted d-block">Next Deadline</small>
                                                <span class="fw-bold"><field name="next_deadline"/></span>
                                            </div>
                                            <div>
                                                <field name="deadline_status" widget="badge"
                                                       decoration-success="deadline_status == 'paid'"
                                                       decoration-danger="deadline_status == 'overdue'"
                                                       decoration-warning="deadline_status == 'today'"
                                                       decoration-info="deadline_status == 'upcoming'"/>
                                            </div>
                                        </div>
                                        <t t-if="record.is_custom_deadline.raw_value">
                                            <span class="badge bg-warning text-dark mt-1" style="font-size: 0.7rem;"><i class="fa fa-clock-o me-1"/>Custom Schedule</span>
                                        </t>
                                    </div>
                                    
                                    <hr class="my-2"/>
                                    
                                    <!-- Installment 1 Card -->
                                    <t t-if="record.installment_1_amount.raw > 0">
                                        <div class="mb-3 p-2 bg-light rounded">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small class="text-muted fw-bold">Installment 1</small>
                                                <field name="installment_1_status" widget="badge"/>
                                            </div>
                                            <div class="row text-center">
                                                <div class="col-4">
                                                    <small class="text-muted d-block">Amount</small>
                                                    <span class="fw-bold"><field name="installment_1_amount"/></span>
                                                </div>
                                                <div class="col-4">
                                                    <small class="text-muted d-block">Paid</small>
                                                    <span class="text-success fw-bold"><field name="installment_1_paid_amount"/></span>
                                                </div>
                                                <div class="col-4">
                                                    <small class="text-muted d-block">Balance</small>
                                                    <span class="text-danger fw-bold"><field name="installment_1_balance"/></span>
                                                </div>
                                            </div>
                                            <div class="text-muted small mt-1">
                                                <i class="fa fa-calendar me-1"/>Due: <field name="installment_1_due_date"/>
                                            </div>
                                        </div>
                                    </t>
                                    
                                    <!-- Installment 2 Card -->
                                    <t t-if="record.installment_2_amount.raw > 0">
                                        <div class="mb-3 p-2 bg-light rounded">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small class="text-muted fw-bold">Installment 2</small>
                                                <field name="installment_2_status" widget="badge"/>
                                            </div>
                                            <div class="row text-center">
                                                <div class="col-4">
                                                    <small class="text-muted d-block">Amount</small>
                                                    <span class="fw-bold"><field name="installment_2_amount"/></span>
                                                </div>
                                                <div class="col-4">
                                                    <small class="text-muted d-block">Paid</small>
                                                    <span class="text-success fw-bold"><field name="installment_2_paid_amount"/></span>
                                                </div>
                                                <div class="col-4">
                                                    <small class="text-muted d-block">Balance</small>
                                                    <span class="text-danger fw-bold"><field name="installment_2_balance"/></span>
                                                </div>
                                            </div>
                                            <div class="text-muted small mt-1">
                                                <i class="fa fa-calendar me-1"/>Due: <field name="installment_2_due_date"/>
                                            </div>
                                        </div>
                                    </t>
                                    
                                    <!-- Total Summary -->
                                    <div class="p-2 bg-primary-subtle rounded">
                                        <div class="row text-center">
                                            <div class="col-4">
                                                <small class="text-muted d-block">Total</small>
                                                <span class="fw-bold"><field name="total_amount"/></span>
                                            </div>
                                            <div class="col-4">
                                                <small class="text-muted d-block">Paid</small>
                                                <span class="text-success fw-bold"><field name="total_paid"/></span>
                                            </div>
                                            <div class="col-4">
                                                <small class="text-muted d-block">Balance</small>
                                                <span class="text-danger fw-bold"><field name="total_balance"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_student_year_payment_form" model="ir.ui.view">
        <field name="name">school.student.year.payment.form</field>
        <field name="model">school.student.year.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_deadline_wizard" type="object" string="Set Specific Deadline"
                            class="btn-primary" icon="fa-calendar-check-o"/>
                    <button name="action_pay_installment_1" type="object" string="Pay Installment 1"
                            class="btn-secondary" icon="fa-money"
                            invisible="installment_1_status == 'paid' or installment_1_amount == 0"/>
                    <button name="action_pay_installment_2" type="object" string="Pay Installment 2"
                            class="btn-secondary" icon="fa-money"
                            invisible="installment_2_status == 'paid' or installment_2_amount == 0"/>
                    <button name="action_reset_to_class_deadline" type="object" string="Reset to Class Schedule"
                            class="btn-outline-secondary" icon="fa-undo"
                            invisible="not is_custom_deadline"
                            confirm="Are you sure you want to reset this student's deadlines back to the class defaults?"/>
                    <button name="action_sync_from_class" type="object" string="Sync from Class"
                            class="btn-link text-primary" icon="fa-refresh"
                            invisible="not class_id"/>
                    <field name="overall_status" widget="statusbar"
                           statusbar_visible="pending,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" placeholder="Student"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="year" string="" placeholder="Academic Year"/> - <field name="class_id" string="" placeholder="Class"/>
                        </h4>
                    </div>

                    <!-- Deadline Schedule Highlight Box -->
                    <div class="card mb-4 border-info shadow-sm" style="background-color: #f8fbff; border-left: 5px solid #0d6efd !important;">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="d-flex align-items-center flex-wrap gap-3">
                                    <div>
                                        <span class="text-muted small d-block">Deadline Status</span>
                                        <field name="deadline_status" widget="badge"
                                               decoration-success="deadline_status == 'paid'"
                                               decoration-danger="deadline_status == 'overdue'"
                                               decoration-warning="deadline_status == 'today'"
                                               decoration-info="deadline_status == 'upcoming'"/>
                                    </div>
                                    <div class="border-start ps-3">
                                        <span class="text-muted small d-block">Next Due Date</span>
                                        <span class="fw-bold fs-6 text-primary"><field name="next_deadline" readonly="1"/></span>
                                    </div>
                                    <div class="border-start ps-3" invisible="deadline_status in ('paid', 'no_deadline')">
                                        <span class="text-muted small d-block">Days Remaining</span>
                                        <span class="fw-bold fs-6"><field name="days_until_deadline" readonly="1"/> day(s)</span>
                                    </div>
                                    <div class="border-start ps-3">
                                        <span class="text-muted small d-block">Schedule Mode</span>
                                        <span class="badge bg-warning text-dark" invisible="not is_custom_deadline"><i class="fa fa-user me-1"/>Custom Student Schedule</span>
                                        <span class="badge bg-secondary" invisible="is_custom_deadline"><i class="fa fa-users me-1"/>Following Class Schedule</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button name="action_open_deadline_wizard" type="object" string="Configure Deadlines"
                                            class="btn btn-sm btn-primary" icon="fa-pencil"/>
                                    <button name="action_reset_to_class_deadline" type="object" string="Reset to Class"
                                            class="btn btn-sm btn-outline-secondary" icon="fa-undo"
                                            invisible="not is_custom_deadline"/>
                                </div>
                            </div>
                            <div class="mt-2 text-muted small" invisible="not deadline_notes">
                                <i class="fa fa-info-circle me-1 text-primary"/><strong>Schedule Notes:</strong> <field name="deadline_notes" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Summary Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                                <div class="card-body text-center">
                                    <div class="text-uppercase text-white-50 small fw-bold">Total Amount</div>
                                    <h2 class="fw-bold mb-0"><field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                                <div class="card-body text-center">
                                    <div class="text-uppercase text-white-50 small fw-bold">Total Paid</div>
                                    <h2 class="fw-bold mb-0"><field name="total_paid" widget="monetary" options="{'currency_field': 'currency_id'}"/></h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 bg-danger text-white">
                                <div class="card-body text-center">
                                    <div class="text-uppercase text-white-50 small fw-bold">Total Balance</div>
                                    <h2 class="fw-bold mb-0"><field name="total_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/></h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- Installment 1 Page -->
                        <page string="Installment 1" name="installment_1" invisible="installment_1_amount == 0">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="fa fa-calendar me-2" title="Schedule"/>Schedule &amp; Deadline</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Amount</span>
                                                <field name="installment_1_amount" class="fw-bold fs-5 text-primary"/>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Deadline / Due Date</span>
                                                <field name="installment_1_due_date"/>
                                                <small class="text-muted d-block">Admin can set or modify this student's installment 1 deadline.</small>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Status</span>
                                                <field name="installment_1_status" widget="badge" class="fs-6"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="fa fa-check-circle me-2" title="Payment Details"/>Payment Details</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Paid Amount</span>
                                                <field name="installment_1_paid_amount" class="form-control-plaintext fw-bold fs-5 text-success"/>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Balance</span>
                                                <field name="installment_1_balance" class="form-control-plaintext fw-bold fs-5 text-danger"/>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Paid Date</span>
                                                <field name="installment_1_paid_date" class="form-control-plaintext fw-bold"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button name="action_pay_installment_1" type="object" string="Pay Installment 1"
                                        class="btn btn-primary btn-lg" icon="fa-money"
                                        invisible="installment_1_status == 'paid'"/>
                            </div>
                        </page>

                        <!-- Installment 2 Page -->
                        <page string="Installment 2" name="installment_2" invisible="installment_2_amount == 0">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="fa fa-calendar me-2" title="Schedule"/>Schedule &amp; Deadline</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Amount</span>
                                                <field name="installment_2_amount" class="fw-bold fs-5 text-primary"/>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Deadline / Due Date</span>
                                                <field name="installment_2_due_date"/>
                                                <small class="text-muted d-block">Admin can set or modify this student's installment 2 deadline.</small>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Status</span>
                                                <field name="installment_2_status" widget="badge" class="fs-6"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="fa fa-check-circle me-2" title="Payment Details"/>Payment Details</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Paid Amount</span>
                                                <field name="installment_2_paid_amount" class="form-control-plaintext fw-bold fs-5 text-success"/>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Balance</span>
                                                <field name="installment_2_balance" class="form-control-plaintext fw-bold fs-5 text-danger"/>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label fw-bold">Paid Date</span>
                                                <field name="installment_2_paid_date" class="form-control-plaintext fw-bold"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button name="action_pay_installment_2" type="object" string="Pay Installment 2"
                                        class="btn btn-primary btn-lg" icon="fa-money"
                                        invisible="installment_2_status == 'paid'"/>
                            </div>
                        </page>

                        <!-- Deadline Schedule Configuration Page -->
                        <page string="Deadline Schedule" name="deadline_schedule">
                            <group string="Specific Deadline Schedule Configuration">
                                <group>
                                    <field name="is_custom_deadline" widget="boolean_toggle"/>
                                    <field name="payment_deadline"/>
                                    <field name="deadline_notes" placeholder="e.g. Granted 15-day extension for installment 2"/>
                                </group>
                                <group>
                                    <field name="installment_1_due_date" string="Installment 1 Deadline"/>
                                    <field name="installment_2_due_date" string="Installment 2 Deadline"/>
                                    <field name="next_deadline" readonly="1"/>
                                    <field name="days_until_deadline" readonly="1"/>
                                </group>
                            </group>
                            <div class="d-flex gap-2 mt-3">
                                <button name="action_open_deadline_wizard" type="object" string="Set Specific Deadline (Wizard)" class="btn btn-primary" icon="fa-calendar"/>
                                <button name="action_reset_to_class_deadline" type="object" string="Reset to Class Defaults" class="btn btn-secondary" icon="fa-undo" invisible="not is_custom_deadline"/>
                            </div>
                        </page>

                        <!-- General Info Page -->
                        <page string="General Information" name="general">
                            <group string="Academic Year &amp; Class">
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="year"/>
                                    <field name="year_start"/>
                                    <field name="year_end"/>
                                </group>
                                <group>
                                    <field name="class_id"/>
                                    <button name="action_sync_from_class" type="object" string="Sync from Class" class="btn btn-sm btn-link" icon="fa-refresh" invisible="not class_id"/>
                                </group>
                            </group>
                            <group string="Payment Details">
                                <group>
                                    <field name="payment_method"/>
                                    <field name="receipt_number"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes"/>
                            </group>
                        </page>

                        <!-- Related Fees Page -->
                        <page string="Related Fees" name="fees">
                            <button name="action_view_fees" type="object" string="View All Fees" class="btn-outline-primary" icon="fa-external-link"/>
                            <field name="student_id" invisible="1"/>
                            <field name="fee_ids" nolabel="1" readonly="1">
                                <list decoration-danger="status == 'overdue'" decoration-success="status == 'paid'"
                                      decoration-warning="status == 'partial'" decoration-muted="status == 'pending'">
                                    <field name="fee_type" widget="badge"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="paid_amount" sum="Paid"/>
                                    <field name="balance" sum="Balance"/>
                                    <field name="due_date"/>
                                    <field name="status" widget="badge"/>
                                    <field name="paid_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_student_year_payment_search" model="ir.ui.view">
        <field name="name">school.student.year.payment.search</field>
        <field name="model">school.student.year.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="year"/>
                <field name="class_id"/>
                <filter name="filter_paid" string="Fully Paid" domain="[('overall_status','=','paid')]"/>
                <filter name="filter_partial" string="Partially Paid" domain="[('overall_status','=','partial')]"/>
                <filter name="filter_pending" string="Pending" domain="[('overall_status','=','pending')]"/>
                <filter name="filter_overdue" string="Overdue Payment" domain="[('overall_status','=','overdue')]"/>
                <separator/>
                <filter name="filter_deadline_overdue" string="Deadline Overdue" domain="[('deadline_status','=','overdue')]"/>
                <filter name="filter_deadline_today" string="Due Today" domain="[('deadline_status','=','today')]"/>
                <filter name="filter_deadline_upcoming" string="Upcoming Deadline" domain="[('deadline_status','=','upcoming')]"/>
                <filter name="filter_custom_deadline" string="Custom Student Schedule" domain="[('is_custom_deadline','=',True)]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Year" name="group_year" domain="[]" context="{'group_by':'year'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Overall Status" name="group_status" domain="[]" context="{'group_by':'overall_status'}"/>
                <filter string="Deadline Status" name="group_deadline_status" domain="[]" context="{'group_by':'deadline_status'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= DEADLINE WIZARD VIEW ======================= -->
    <record id="view_student_year_payment_deadline_wizard" model="ir.ui.view">
        <field name="name">school.student.year.payment.deadline.wizard.form</field>
        <field name="model">school.student.year.payment.deadline.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Specific Payment Deadline Schedule">
                <sheet>
                    <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center" role="status">
                        <i class="fa fa-info-circle fa-lg me-2 text-primary" title="Information"/>
                        <div>
                            Set custom payment deadlines for the selected student(s). Once marked as <strong>Custom Schedule</strong>, class-wide updates will not overwrite this student's schedule.
                        </div>
                    </div>

                    <!-- Single Student Info Header -->
                    <div class="card bg-light border-0 mb-3 p-3" invisible="student_count != 1">
                        <div class="row">
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Student</span>
                                <h5 class="fw-bold mb-0 text-primary"><field name="single_student_name" readonly="1"/></h5>
                                <small class="text-muted">Class: <field name="single_class_name" readonly="1"/> | Academic Year: <field name="single_year" readonly="1"/></small>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <span class="text-muted small d-block">Remaining Balance to Pay</span>
                                <h4 class="fw-bold mb-0 text-danger">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="single_balance" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Multi Student Notice -->
                    <div class="alert alert-warning py-2 px-3 mb-3" role="status" invisible="student_count &lt;= 1">
                        <i class="fa fa-users me-1"/>You are setting the deadline schedule for <strong><field name="student_count" readonly="1"/></strong> students simultaneously.
                    </div>

                    <group string="Deadline Schedule Configuration">
                        <group string="Installment Deadlines">
                            <field name="installment_1_due_date"/>
                            <field name="installment_2_due_date"/>
                        </group>
                        <group string="Final Settlement &amp; Settings">
                            <field name="payment_deadline"/>
                            <field name="is_custom_deadline" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="Reason / Notes">
                        <field name="deadline_notes" nolabel="1" placeholder="e.g. Special installment agreement, approved extension until end of month"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_deadlines" string="Save &amp; Apply Schedule" type="object" class="btn-primary" icon="fa-check"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Contextual Action to Set Deadlines in Bulk from List View -->
    <record id="action_bulk_set_payment_deadline" model="ir.actions.act_window">
        <field name="name">Set Deadline Schedule</field>
        <field name="res_model">school.student.year.payment.deadline.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_school_student_year_payment"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ======================= PAY WIZARD VIEW ======================= -->
    <record id="view_student_year_payment_pay_wizard" model="ir.ui.view">
        <field name="name">school.student.year.payment.pay.wizard.form</field>
        <field name="model">school.student.year.payment.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Installment">
                <group string="Payment Details">
                    <group>
                        <field name="year_payment_id" invisible="1"/>
                        <field name="installment" invisible="1"/>
                    </group>
                    <group>
                        <field name="amount" required="1"/>
                        <field name="paid_date" required="1"/>
                    </group>
                    <group>
                        <field name="payment_method" required="1"/>
                        <field name="receipt_number"/>
                    </group>
                    <group>
                        <field name="notes" colspan="2"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Payment" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ======================= ACTIONS ======================= -->
    <record id="action_student_year_payment" model="ir.actions.act_window">
        <field name="name">Student Year Payments</field>
        <field name="res_model">school.student.year.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_student_year_payment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage student annual tuition, installment deadlines, and payment schedules.
            </p>
            <p>
                Each student's payment schedule automatically follows their class configuration, or can have a custom deadline schedule set specifically by the admin.
            </p>
        </field>
    </record>
</odoo>
