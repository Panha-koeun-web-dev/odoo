<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_school_term_tree" model="ir.ui.view">
        <field name="name">school.term.list</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <list string="Academic Terms (3 Terms / Year)" decoration-success="state == 'active'" decoration-muted="state == 'finished'" decoration-info="state == 'draft'">
                <field name="name" string="Academic Term" decoration-bf="1"/>
                <field name="academic_year" decoration-bf="1"/>
                <field name="term_number" widget="badge"
                       decoration-info="term_number == 'term_1'"
                       decoration-primary="term_number == 'term_2'"
                       decoration-warning="term_number == 'term_3'"/>
                <field name="date_start" string="Start Date"/>
                <field name="date_end" string="End Date"/>
                <field name="duration_months" string="Duration (Mo.)" optional="show"/>
                <field name="duration_weeks" string="Duration (Wks)" optional="hide"/>
                <field name="class_count" string="Classes" optional="show"/>
                <field name="timetable_count" string="Sessions" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'finished'"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_school_term_kanban" model="ir.ui.view">
        <field name="name">school.term.kanban</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <kanban class="o_school_term_kanban" sample="1">
                <field name="name"/>
                <field name="academic_year"/>
                <field name="term_number"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_months"/>
                <field name="state"/>
                <field name="color"/>
                <field name="class_count"/>
                <field name="timetable_count"/>
                <templates>
                    <t t-name="card" class="o_term_card flex-column">
                        <!-- Header: Term Number & Status Ribbon -->
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <span class="badge rounded-pill text-bg-light border">
                                <i class="fa fa-graduation-cap me-1 text-primary" title="Academic Year"/>
                                <field name="academic_year"/>
                            </span>
                            <span class="badge" t-attf-class="{{ record.state.raw_value == 'active' ? 'text-bg-success' : (record.state.raw_value == 'finished' ? 'text-bg-secondary' : 'text-bg-info') }}">
                                <i t-attf-class="fa me-1 {{ record.state.raw_value == 'active' ? 'fa-play-circle' : (record.state.raw_value == 'finished' ? 'fa-check-circle' : 'fa-clock-o') }}" title="Status"/>
                                <field name="state"/>
                            </span>
                        </div>

                        <!-- Term Title -->
                        <div class="fw-bold fs-5 text-truncate mb-1">
                            <field name="name"/>
                        </div>

                        <!-- Date Period Banner (3 Months) -->
                        <div class="small text-muted mb-3">
                            <i class="fa fa-calendar-o me-1 text-info" title="Period"/>
                            <field name="date_start"/> <i class="fa fa-arrow-right mx-1 small" title="to"/> <field name="date_end"/>
                            <span class="badge rounded-pill text-bg-secondary ms-1">3 Months</span>
                        </div>

                        <!-- KPI Counters -->
                        <div class="d-flex justify-content-between align-items-center bg-light rounded p-2 mb-3">
                            <div class="text-center flex-fill border-end">
                                <div class="fs-6 fw-bold text-primary"><field name="class_count"/></div>
                                <div class="small text-muted">Classes</div>
                            </div>
                            <div class="text-center flex-fill">
                                <div class="fs-6 fw-bold text-success"><field name="timetable_count"/></div>
                                <div class="small text-muted">Sessions</div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-auto d-flex gap-2" groups="school_management.group_school_admin">
                            <button type="object" name="action_open_schedule_wizard" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="fa fa-calendar-plus-o me-1" title="Plan"/>Plan Schedule
                            </button>
                            <t t-if="record.state.raw_value == 'active'">
                                <button type="object" name="action_finish_term" class="btn btn-sm btn-outline-warning">
                                    <i class="fa fa-flag-checkered me-1" title="Finish"/>Finish Term
                                </button>
                            </t>
                            <t t-if="record.state.raw_value == 'finished'">
                                <button type="object" name="action_create_next_term" class="btn btn-sm btn-outline-success">
                                    <i class="fa fa-forward me-1" title="Next"/>Next Term
                                </button>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_school_term_form" model="ir.ui.view">
        <field name="name">school.term.form</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <form string="Academic Term">
                <header>
                    <button name="action_start_term" string="Start Term" type="object" class="btn-primary" invisible="state != 'draft'" groups="school_management.group_school_admin"/>
                    <button name="action_open_schedule_wizard" string="Plan / Roll Over Schedule" type="object" class="btn-primary" icon="fa-calendar-plus-o" groups="school_management.group_school_admin"/>
                    <button name="action_finish_term" string="Finish Term &amp; Prepare Next" type="object" class="btn-warning" invisible="state != 'active'" icon="fa-flag-checkered" groups="school_management.group_school_admin"/>
                    <button name="action_create_next_term" string="Create Next Term" type="object" class="btn-success" invisible="state != 'finished'" icon="fa-forward" groups="school_management.group_school_admin"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="school_management.group_school_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,finished"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_timetable" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="timetable_count" string="Timetable Sessions" widget="statinfo"/>
                        </button>
                        <button name="action_view_classes" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="class_count" string="Enrolled Classes" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Academic Term Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Academic Year 2025-2026 - Term 1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Academic Structure (3 Terms = 1 Year)">
                            <field name="academic_year" placeholder="e.g. 2025-2026" required="1"/>
                            <field name="term_number" required="1"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Term Duration (Standard 3 Months)">
                            <field name="date_start" required="1"/>
                            <field name="date_end" required="1"/>
                            <label for="duration_months" string="Duration"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="duration_months" class="oe_inline"/>
                                <span>Months (</span>
                                <field name="duration_weeks" class="oe_inline"/>
                                <span>Weeks)</span>
                            </div>
                        </group>
                    </group>

                    <group string="Sequence Continuity &amp; Term Rollover">
                        <group>
                            <field name="previous_term_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="next_term_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="timetable" string="Timetable Schedule">
                            <field name="timetable_ids">
                                <list default_order="day_of_week, start_time" create="false" edit="false">
                                    <field name="day_of_week" widget="badge"/>
                                    <field name="period_short" widget="badge"/>
                                    <field name="time_display" string="Time"/>
                                    <field name="start_time" column_invisible="True"/>
                                    <field name="end_time" column_invisible="True"/>
                                    <field name="class_id"/>
                                    <field name="teacher_id"/>
                                    <field name="subject_ids" widget="many2many_tags"/>
                                    <field name="room"/>
                                </list>
                            </field>
                        </page>
                        <page name="classes" string="Participating Classes">
                            <field name="class_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="teacher_id"/>
                                    <field name="student_count"/>
                                    <field name="capacity"/>
                                    <field name="room"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Term Guidelines &amp; Academic Objectives">
                            <field name="notes" placeholder="Enter term syllabus guidelines, midterm exam weeks, holidays, or special objectives..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_school_term_search" model="ir.ui.view">
        <field name="name">school.term.search</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <search string="Search Academic Terms">
                <field name="name"/>
                <field name="academic_year"/>
                <field name="term_number"/>
                <separator/>
                <filter name="filter_active" string="Active Term (Current)" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Upcoming / Draft Terms" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_finished" string="Completed / Finished Terms" domain="[('state', '=', 'finished')]"/>
                <separator/>
                <filter name="filter_term_1" string="Term 1" domain="[('term_number', '=', 'term_1')]"/>
                <filter name="filter_term_2" string="Term 2" domain="[('term_number', '=', 'term_2')]"/>
                <filter name="filter_term_3" string="Term 3" domain="[('term_number', '=', 'term_3')]"/>
                <separator/>
                <filter string="Year 2026-2027" name="filter_year_2026_2027" domain="[('academic_year', '=', '2026-2027')]"/>
                <filter string="Year 2025-2026" name="filter_year_2025_2026" domain="[('academic_year', '=', '2025-2026')]"/>
                <separator/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by': 'academic_year'}"/>
                <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                <filter string="Term Sequence" name="group_term_number" domain="[]" context="{'group_by': 'term_number'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= ACTION ======================= -->
    <record id="action_school_term" model="ir.actions.act_window">
        <field name="name">Academic Terms (3 Terms / Year)</field>
        <field name="res_model">school.term</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_school_term_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Academic Term!
            </p>
            <p>
                In a standard 12-month academic year, students study across 3 terms (3 months each).
                Admins and teachers can plan full schedules per term and effortlessly roll them over to the next term upon completion.
            </p>
        </field>
    </record>

</odoo>
