<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_fee_list" model="ir.ui.view">
        <field name="name">school.fee.list</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'overdue'" decoration-success="status == 'paid'"
                  decoration-warning="status == 'partial'" decoration-muted="status == 'pending'">
                <header>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" class="btn-outline-primary" icon="fa-file-excel-o" display="always" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                </header>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="fee_type" widget="badge"/>
                <field name="amount" sum="Total"/>
                <field name="paid_amount" sum="Paid"/>
                <field name="balance" sum="Balance"/>
                <field name="due_date"/>
                <field name="status" widget="badge"/>
                <button name="action_mark_paid" type="object" string="Mark Paid"
                        class="btn-success" icon="fa-check"
                        invisible="status == 'paid'"
                        groups="school_management.group_school_admin"/>
                <button name="action_print_receipt" type="object" string="Receipt"
                        class="btn-sm btn-outline-secondary" icon="fa-print"
                        invisible="status not in ('paid', 'partial')"
                        title="Print Payment Receipt"/>
                <button name="action_export_xlsx" type="object" string="XLSX"
                        class="btn-sm btn-outline-success" icon="fa-file-excel-o"
                        title="Export this record to Excel" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_fee_kanban" model="ir.ui.view">
        <field name="name">school.fee.kanban</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="fee_type"/>
                <field name="amount"/>
                <field name="paid_amount"/>
                <field name="balance"/>
                <field name="due_date"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="student_id"/></strong>
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Fee type"/><field name="fee_type"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar-o me-1" title="Due date"/>Due: <field name="due_date"/>
                                </div>
                                <div t-if="record.balance.raw">
                                    <span class="text-danger">
                                        <i class="fa fa-exclamation-circle me-1" title="Balance"/>Balance:
                                        <field name="balance"/>
                                    </span>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <span t-attf-class="badge bg-light text-dark me-1">
                                    <i class="fa fa-money me-1" title="Amount"/>
                                    <t t-esc="record.amount.raw"/>
                                </span>
                                <field name="status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_fee_form" model="ir.ui.view">
        <field name="name">school.fee.form</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Mark as Paid"
                            class="btn-primary" icon="fa-check"
                            invisible="status == 'paid'"
                            groups="school_management.group_school_admin"/>
                    <button name="action_print_receipt" type="object" string="Print Receipt"
                            class="btn-secondary" icon="fa-print"
                            invisible="status not in ('paid', 'partial')"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX"
                            class="btn-outline-primary" icon="fa-file-excel-o"
                            title="Export Fee Statement to Excel" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" placeholder="Student"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="fee_type" string=""/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Payment">
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="balance" readonly="1"/>
                            <field name="status" widget="badge" bg_color="status == 'paid' ? 'bg-green-100 text-green-800' : status == 'pending' ? 'bg-yellow-100 text-yellow-800' : status == 'partial' ? 'bg-blue-100 text-blue-800' : 'bg-red-100 text-red-800'"/>
                        </group>
                        <group string="Schedule">
                            <field name="due_date"/>
                            <field name="paid_date"/>
                            <field name="payment_method"/>
                            <field name="receipt_number"/>
                        </group>
                    </group>
                    <group string="Notes" class="mt-3">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_fee_search" model="ir.ui.view">
        <field name="name">school.fee.search</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="fee_type"/>
                <filter name="filter_pending" string="Pending" domain="[('status','=','pending')]"/>
                <filter name="filter_paid" string="Paid" domain="[('status','=','paid')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('status','=','overdue')]"/>
                <filter name="filter_partial" string="Partial" domain="[('status','=','partial')]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Fee Type" name="group_type" domain="[]" context="{'group_by':'fee_type'}"/>
                <filter string="Status" name="group_status" domain="[]" context="{'group_by':'status'}" />
                <filter string="Due Date" name="group_due" domain="[]" context="{'group_by':'due_date'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= ACTION ======================= -->
    <record id="action_fee" model="ir.actions.act_window">
        <field name="name">Fees</field>
        <field name="res_model">school.fee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_fee_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record the first fee!</p>
        </field>
    </record>
</odoo>