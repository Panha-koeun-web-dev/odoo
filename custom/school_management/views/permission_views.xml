<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_school_permission_search" model="ir.ui.view">
        <field name="name">school.permission.search</field>
        <field name="model">school.permission</field>
        <field name="arch" type="xml">
            <search string="Search Permission Requests">
                <field name="name" string="Reference"/>
                <field name="applicant_name" string="Applicant"/>
                <field name="student_id" string="Student"/>
                <field name="student_code" string="Student ID"/>
                <field name="teacher_id" string="Teacher"/>
                <field name="class_id" string="Class"/>
                <field name="permission_type" string="Permission Type"/>
                <field name="approved_by" string="Reviewed By"/>
                <field name="reason" string="Reason"/>

                <separator/>
                <filter string="My Requests" name="my_permissions"
                        domain="['|', '&amp;', ('applicant_type', '=', 'student'), ('student_id.user_id', '=', uid), '&amp;', ('applicant_type', '=', 'teacher'), ('teacher_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Student Requests" name="filter_students" domain="[('applicant_type', '=', 'student')]"/>
                <filter string="Teacher Requests" name="filter_teachers" domain="[('applicant_type', '=', 'teacher')]"/>
                <separator/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Not Approved" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]"/>

                <separator/>
                <filter string="Leave of Absence" name="type_leave" domain="[('permission_type', '=', 'leave')]"/>
                <filter string="Sick Leave" name="type_sick" domain="[('permission_type', '=', 'sick')]"/>
                <filter string="Emergency / Family" name="type_emergency" domain="[('permission_type', '=', 'emergency')]"/>

                <separator/>
                <filter string="Applicant Type" name="group_applicant_type" context="{'group_by': 'applicant_type'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                <filter string="Permission Type" name="group_type" context="{'group_by': 'permission_type'}"/>
                <filter string="Reviewed By" name="group_reviewer" context="{'group_by': 'approved_by'}"/>
                <filter string="Start Date (Month)" name="group_start_date_month" context="{'group_by': 'start_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_school_permission_list" model="ir.ui.view">
        <field name="name">school.permission.list</field>
        <field name="model">school.permission</field>
        <field name="arch" type="xml">
            <list string="Permission &amp; Leave Requests"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'draft'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancel'"
                  sample="1">
                <field name="name" string="Reference" decoration-bf="1"/>
                <field name="applicant_type" widget="badge"
                       decoration-info="applicant_type == 'teacher'"
                       decoration-primary="applicant_type == 'student'"/>
                <field name="applicant_name" string="Applicant"/>
                <field name="student_id" optional="hide"/>
                <field name="teacher_id" optional="hide"/>
                <field name="class_id" optional="show"/>
                <field name="permission_type" string="Type" widget="badge"
                       decoration-info="permission_type == 'leave'"
                       decoration-warning="permission_type == 'sick'"
                       decoration-danger="permission_type == 'emergency'"
                       decoration-muted="permission_type == 'official'"/>
                <field name="session_type" optional="hide"/>
                <field name="start_date" string="From"/>
                <field name="end_date" string="To"/>
                <field name="duration_days" string="Days" decoration-bf="1"/>
                <field name="reason" string="Reason" optional="show"/>
                <field name="approved_by" string="Reviewer" widget="many2one_avatar_user" optional="show"/>
                <field name="approval_date" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_school_permission_form" model="ir.ui.view">
        <field name="name">school.permission.form</field>
        <field name="model">school.permission</field>
        <field name="arch" type="xml">
            <form string="Permission Request">
                <header>
                    <field name="can_approve" invisible="1"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary" icon="fa-check"
                            invisible="not can_approve"/>
                    <button name="action_open_reject_wizard" type="object"
                            string="Not Approve" class="btn-outline-danger" icon="fa-times"
                            invisible="not can_approve"/>
                    <button name="action_cancel" type="object"
                            string="Cancel Request" class="btn-secondary" icon="fa-ban"
                            invisible="state not in ('draft', 'approved')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Pending" class="btn-link"
                            groups="school_management.group_school_admin"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attendance" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                invisible="attendance_count == 0">
                            <field name="attendance_count" widget="statinfo" string="Excused Days"/>
                        </button>
                        <button name="action_view_affected_timetables" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="affected_timetable_count == 0">
                            <field name="affected_timetable_count" widget="statinfo" string="Sessions"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Not Approved" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancel'"/>

                    <div class="oe_title">
                        <span class="o_form_label text-muted">Permission Reference</span>
                        <h1 class="mb-2">
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="applicant_name" readonly="1" class="text-primary"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Applicant Details">
                            <field name="applicant_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="student_id" options="{'no_create': True}"
                                   invisible="applicant_type != 'student'"
                                   required="applicant_type == 'student'"
                                   readonly="state != 'draft'"/>
                            <field name="student_code" invisible="applicant_type != 'student'"/>
                            <field name="teacher_id" options="{'no_create': True}"
                                   invisible="applicant_type != 'teacher'"
                                   required="applicant_type == 'teacher'"
                                   readonly="state != 'draft'"/>
                            <field name="teacher_employee_id" string="Employee ID" invisible="applicant_type != 'teacher'"/>
                            <field name="class_id" options="{'no_create': True}" readonly="1"
                                   invisible="applicant_type != 'student'"/>
                        </group>

                        <group string="Leave Schedule &amp; Duration">
                            <field name="permission_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="session_type" readonly="state != 'draft'"/>
                            <label for="start_date" string="Leave Dates"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="start_date" readonly="state != 'draft'"/>
                                <span>to</span>
                                <field name="end_date" readonly="state != 'draft'"/>
                            </div>
                            <field name="duration_days" readonly="1"/>
                            <label for="start_time" string="Custom Hours" invisible="session_type != 'custom'"/>
                            <div class="d-flex align-items-center gap-2" invisible="session_type != 'custom'">
                                <field name="start_time" widget="float_time" class="oe_inline" readonly="state != 'draft'"/>
                                <span>to</span>
                                <field name="end_time" widget="float_time" class="oe_inline" readonly="state != 'draft'"/>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Reason &amp; Explanation" name="reason">
                            <field name="reason" placeholder="Explain the reason for the requested permission in detail..." readonly="state != 'draft'"/>
                        </page>

                        <page string="Affected Teaching Schedule" name="teaching_schedule" invisible="applicant_type != 'teacher'">
                            <div class="alert alert-info d-flex align-items-center mb-3" role="status">
                                <i class="fa fa-info-circle me-2 fs-5" title="Teaching Notice"/>
                                <div>
                                    Teaching sessions scheduled during this leave period. Administrators should review these sessions to arrange substitute coverage if necessary.
                                </div>
                            </div>
                            <field name="affected_timetable_ids" nolabel="1" readonly="1">
                                <list decoration-info="day_of_week in ('0', '1', '2', '3', '4')"
                                      decoration-warning="day_of_week in ('5', '6')">
                                    <field name="day_of_week" widget="badge"/>
                                    <field name="period_short" widget="badge" string="Period"/>
                                    <field name="time_display" string="Time"/>
                                    <field name="start_time" widget="float_time" optional="hide"/>
                                    <field name="end_time" widget="float_time" optional="hide"/>
                                    <field name="class_id"/>
                                    <field name="subject_id"/>
                                    <field name="room"/>
                                </list>
                            </field>
                        </page>

                        <page string="Supporting Documents" name="documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>

                        <page string="Review &amp; Approval History" name="review" invisible="state == 'draft' and not approved_by">
                            <group>
                                <group string="Decision Info">
                                    <field name="approved_by"/>
                                    <field name="approval_date"/>
                                    <field name="approver_role" widget="badge"/>
                                </group>
                                <group string="Refusal / Non-Approval Note" invisible="state != 'rejected'">
                                    <field name="rejection_reason" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- ======================= CALENDAR VIEW ======================= -->
    <record id="view_school_permission_calendar" model="ir.ui.view">
        <field name="name">school.permission.calendar</field>
        <field name="model">school.permission</field>
        <field name="arch" type="xml">
            <calendar string="Permissions Calendar"
                      date_start="start_date"
                      date_stop="end_date"
                      color="state"
                      mode="month"
                      quick_create="0">
                <field name="applicant_name"/>
                <field name="applicant_type"/>
                <field name="permission_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_school_permission_kanban" model="ir.ui.view">
        <field name="name">school.permission.kanban</field>
        <field name="model">school.permission</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="applicant_type"/>
                <field name="permission_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="o_kanban_record_title fs-6">
                                <field name="applicant_name"/>
                            </strong>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'approved'"
                                   decoration-warning="state == 'draft'"
                                   decoration-danger="state == 'rejected'"
                                   decoration-muted="state == 'cancel'"/>
                        </div>
                        <div class="text-muted small mb-1">
                            <field name="applicant_type" widget="badge"
                                   decoration-info="applicant_type == 'teacher'"
                                   decoration-primary="applicant_type == 'student'"/>
                            <field name="permission_type" widget="badge" class="ms-1"/>
                        </div>
                        <div class="d-flex justify-content-between text-muted small border-top pt-1">
                            <span><i class="fa fa-calendar me-1" title="Dates"/> <field name="start_date"/> - <field name="end_date"/></span>
                            <span><i class="fa fa-clock-o me-1" title="Duration"/> <field name="duration_days"/>d</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= ACTIONS ======================= -->
    <!-- Action 1: All Permissions -->
    <record id="action_school_permission" model="ir.actions.act_window">
        <field name="name">All Permissions</field>
        <field name="res_model">school.permission</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_school_permission_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submit and review permission requests!
            </p>
            <p>
                Students can request permission to administrators and teachers.
                Teachers can request permission to administrators.
            </p>
        </field>
    </record>

    <!-- Action 2: Student Permissions -->
    <record id="action_school_permission_student" model="ir.actions.act_window">
        <field name="name">Student Permissions</field>
        <field name="res_model">school.permission</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_school_permission_search"/>
        <field name="domain">[('applicant_type', '=', 'student')]</field>
        <field name="context">{'default_applicant_type': 'student'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No student permission requests yet!
            </p>
            <p>
                Students can submit leave requests to administrators and teachers.
            </p>
        </field>
    </record>

    <!-- Action 3: Teacher Permissions -->
    <record id="action_school_permission_teacher" model="ir.actions.act_window">
        <field name="name">Teacher Permissions</field>
        <field name="res_model">school.permission</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_school_permission_search"/>
        <field name="domain">[('applicant_type', '=', 'teacher')]</field>
        <field name="context">{'default_applicant_type': 'teacher'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No teacher permission requests yet!
            </p>
            <p>
                Teachers can submit leave and absence requests to administrators.
            </p>
        </field>
    </record>

    <!-- Action 4: Pending Approval -->
    <record id="action_school_permission_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">school.permission</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_school_permission_search"/>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>

    <!-- Action 5: Approved Permissions -->
    <record id="action_school_permission_approved" model="ir.actions.act_window">
        <field name="name">Approved Permissions</field>
        <field name="res_model">school.permission</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_school_permission_search"/>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="context">{'default_state': 'approved'}</field>
    </record>
</odoo>
