<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_certificate_tree" model="ir.ui.view">
        <field name="name">school.certificate.list</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <list class="o_school_list" default_order="issue_date desc, id desc">
                <field name="name" string="Document Ref" decoration-bf="1"/>
                <field name="student_id" string="Student Name" decoration-bf="1"/>
                <field name="student_code" string="Student ID"/>
                <field name="class_id" string="Class"/>
                <field name="term" widget="badge" decoration-info="term in ('semester_1', 'semester_2')" decoration-success="term == 'final'"/>
                <field name="academic_year" string="Academic Year"/>
                <field name="gpa" string="GPA" widget="badge"
                       decoration-success="gpa &gt;= 3.5"
                       decoration-primary="gpa &gt;= 3.0 and gpa &lt; 3.5"
                       decoration-warning="gpa &gt;= 2.0 and gpa &lt; 3.0"
                       decoration-danger="gpa &lt; 2.0"/>
                <field name="class_rank" string="Class Standing" decoration-bf="1"/>
                <field name="attendance_rate" string="Attendance" widget="progressbar"/>
                <field name="academic_standing" widget="badge"
                       decoration-success="academic_standing in ('distinction', 'honors')"
                       decoration-info="academic_standing == 'good'"
                       decoration-warning="academic_standing == 'satisfactory'"
                       decoration-danger="academic_standing == 'probation'"/>
                <field name="certificate_type" widget="badge" optional="show"/>
                <field name="issue_date" string="Issued Date"/>
                <field name="print_state" string="Print Approval" widget="badge"
                       decoration-success="print_state == 'approved'"
                       decoration-warning="print_state == 'pending'"
                       decoration-danger="print_state == 'rejected'"
                       decoration-muted="print_state == 'not_requested'"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'issued'"
                       decoration-muted="status == 'draft'"/>

                <button name="action_request_print" type="object" string="Request Print"
                        class="btn-sm btn-primary" icon="fa-paper-plane"
                        invisible="not can_request_print"/>
                <button name="action_approve_print" type="object" string="Approve Print"
                        class="btn-sm btn-success" icon="fa-check"
                        invisible="not can_approve_print"
                        groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                <button name="action_reject_print" type="object" string="Decline"
                        class="btn-sm btn-outline-danger" icon="fa-times"
                        invisible="not can_approve_print"
                        groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                <button name="action_smart_print" type="object" string="Print PDF"
                        class="btn-sm btn-outline-primary" icon="fa-print" title="Print Official Document PDF"
                        invisible="not can_print"/>
                <button name="action_issue" type="object" string="Issue"
                        class="btn-sm btn-outline-success" icon="fa-check" invisible="status == 'issued'"
                        groups="school_management.group_school_admin"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_certificate_kanban" model="ir.ui.view">
        <field name="name">school.certificate.kanban</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="term">
                <field name="name"/>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="certificate_type"/>
                <field name="term"/>
                <field name="academic_year"/>
                <field name="gpa"/>
                <field name="class_rank"/>
                <field name="academic_standing"/>
                <field name="attendance_rate"/>
                <field name="issue_date"/>
                <field name="status"/>
                <field name="print_state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="o_kanban_avatar">
                                        <span class="o_kanban_avatar_letter bg-primary text-white p-2 rounded-circle">
                                            <i class="fa fa-graduation-cap" title="Transcript"/>
                                        </span>
                                    </span>
                                    <div>
                                        <strong class="o_kanban_record_title fs-6">
                                            <field name="student_id"/>
                                        </strong>
                                        <div class="text-muted small">
                                            <field name="student_code"/> • <field name="class_id"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <field name="print_state" widget="badge"
                                           decoration-success="print_state == 'approved'"
                                           decoration-warning="print_state == 'pending'"
                                           decoration-danger="print_state == 'rejected'"
                                           decoration-muted="print_state == 'not_requested'"/>
                                    <field name="status" widget="badge"/>
                                </div>
                            </div>

                            <!-- Metrics Strip -->
                            <div class="d-flex align-items-center justify-content-between bg-light rounded p-2 my-2 border">
                                <div class="text-center px-1">
                                    <div class="text-muted small">GPA</div>
                                    <strong class="text-primary fs-6"><field name="gpa"/></strong>
                                </div>
                                <div class="text-center px-1 border-start border-end">
                                    <div class="text-muted small">Rank</div>
                                    <strong class="text-warning fs-6"><field name="class_rank"/></strong>
                                </div>
                                <div class="text-center px-1">
                                    <div class="text-muted small">Attendance</div>
                                    <strong class="text-success fs-6"><field name="attendance_rate"/>%</strong>
                                </div>
                            </div>

                            <div class="oe_kanban_footer d-flex align-items-center justify-content-between mt-2">
                                <field name="academic_standing" widget="badge"/>
                                <span class="text-muted small">
                                    <i class="fa fa-calendar me-1" title="Issue Date"/><field name="issue_date"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_certificate_form" model="ir.ui.view">
        <field name="name">school.certificate.form</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="can_request_print" invisible="1"/>
                    <field name="can_approve_print" invisible="1"/>
                    <field name="can_print" invisible="1"/>

                    <!-- Print Request & Approval Action Buttons -->
                    <button name="action_request_print" type="object"
                            string="Request Print" class="btn-primary" icon="fa-paper-plane"
                            invisible="not can_request_print"/>
                    <button name="action_approve_print" type="object"
                            string="Approve Print Request" class="btn-success" icon="fa-check"
                            invisible="not can_approve_print"
                            groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_reject_print" type="object"
                            string="Decline Print Request" class="btn-outline-danger" icon="fa-times"
                            invisible="not can_approve_print"
                            groups="school_management.group_school_admin,school_management.group_school_teacher"/>

                    <!-- Print Document Buttons (Enabled when user can print) -->
                    <button name="action_print_transcript" type="object"
                            string="Print Transcript / Report Card (PDF)" class="btn-primary" icon="fa-file-text-o"
                            invisible="not can_print"/>
                    <button name="action_print_certificate" type="object"
                            string="Print Certificate (PDF)" class="btn-secondary" icon="fa-certificate"
                            invisible="not can_print"/>

                    <button name="action_recompute_metrics" type="object"
                            string="Recalculate Metrics" class="btn-secondary" icon="fa-refresh"
                            groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_issue" type="object"
                            string="Issue Document" class="btn-success" icon="fa-check" invisible="status == 'issued'"
                            groups="school_management.group_school_admin"/>
                    <button name="action_draft" type="object"
                            string="Set to Draft" class="btn-secondary" invisible="status == 'draft'"
                            groups="school_management.group_school_admin"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-graduation-cap" type="object" name="action_recompute_metrics">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="gpa"/> / 4.0</span>
                                <span class="o_stat_text">Term GPA</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-trophy" type="object" name="action_recompute_metrics">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="class_rank"/></span>
                                <span class="o_stat_text">Cohort Rank</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-calendar-check-o" type="object" name="action_recompute_metrics">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="attendance_rate"/>%</span>
                                <span class="o_stat_text">Attendance</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-book" type="object" name="action_recompute_metrics">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="earned_credits"/> / <field name="total_credits"/></span>
                                <span class="o_stat_text">Credits Passed</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <span class="o_form_label text-muted">Academic Record</span>
                        <h1>
                            <field name="student_id" placeholder="Select Student..."/>
                        </h1>
                        <h4 class="text-muted">
                            Document Ref: <field name="name" readonly="1"/>
                        </h4>
                    </div>

                    <!-- Print Approval Status Detail -->
                    <group string="Print Approval Information">
                        <group>
                            <field name="print_state" widget="badge"
                                   decoration-success="print_state == 'approved'"
                                   decoration-warning="print_state == 'pending'"
                                   decoration-danger="print_state == 'rejected'"
                                   decoration-muted="print_state == 'not_requested'"/>
                            <field name="print_requested_date" invisible="not print_requested_date"/>
                        </group>
                        <group>
                            <field name="print_approved_by" invisible="not print_approved_by"/>
                            <field name="print_approval_date" invisible="not print_approval_date"/>
                            <field name="print_rejection_reason" invisible="print_state != 'rejected'"/>
                        </group>
                    </group>

                    <notebook class="mt-3">
                        <!-- TAB 1: ACADEMIC TRANSCRIPT & REPORT CARD -->
                        <page string="Academic Transcript &amp; Report Card" name="academic_transcript">
                            <group>
                                <group string="Term &amp; Program Information">
                                    <field name="certificate_type"/>
                                    <field name="term"/>
                                    <field name="academic_year"/>
                                    <field name="class_id" readonly="1"/>
                                    <field name="student_code" readonly="1"/>
                                    <field name="issue_date"/>
                                </group>
                                <group string="Executive Standing &amp; GPA">
                                    <field name="gpa" readonly="1"/>
                                    <field name="cumulative_gpa" readonly="1"/>
                                    <field name="class_rank" readonly="1"/>
                                    <field name="academic_standing" readonly="1"/>
                                    <field name="total_credits" readonly="1"/>
                                    <field name="earned_credits" readonly="1"/>
                                </group>
                            </group>

                            <group string="Attendance Record">
                                <group>
                                    <field name="attendance_rate" readonly="1"/>
                                    <field name="present_days" readonly="1"/>
                                </group>
                                <group>
                                    <field name="absent_days" readonly="1"/>
                                    <field name="late_days" readonly="1"/>
                                </group>
                            </group>

                            <group string="Faculty Assessment &amp; Signatories">
                                <field name="homeroom_teacher_id"/>
                                <field name="principal_name"/>
                                <field name="general_remarks" placeholder="Faculty advisor and board remarks regarding student academic progression, conduct, and accomplishments..."/>
                            </group>
                        </page>

                        <!-- TAB 2: CERTIFICATE OPTIONS -->
                        <page string="Certificate &amp; Diploma Options" name="certificate_options">
                            <group>
                                <group string="Certificate Design">
                                    <field name="template"/>
                                    <field name="custom_title" placeholder="e.g. Certificate of Academic Excellence"/>
                                    <field name="custom_prelude" placeholder="e.g. This is to proudly certify that"/>
                                    <field name="custom_statement" placeholder="e.g. having successfully completed the requirements of"/>
                                    <field name="reason" placeholder="Reason / Purpose"/>
                                    <field name="accent_color" placeholder="#1a56db"/>
                                    <field name="show_avg"/>
                                </group>
                                <group string="Signatories">
                                    <field name="signatory_one_name"/>
                                    <field name="signatory_one_title"/>
                                    <field name="signatory_two_name"/>
                                    <field name="signatory_two_title"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: STUDENT PROFILE DETAILS -->
                        <page string="Student Profile Details" name="student_details">
                            <group>
                                <group string="Identity">
                                    <field name="student_code" readonly="1"/>
                                    <field name="gender" readonly="1"/>
                                    <field name="date_of_birth" readonly="1"/>
                                    <field name="age" readonly="1"/>
                                </group>
                                <group string="Contact &amp; Family">
                                    <field name="email" readonly="1"/>
                                    <field name="phone" readonly="1"/>
                                    <field name="parent_name" readonly="1"/>
                                    <field name="parent_phone" readonly="1"/>
                                    <field name="address" readonly="1"/>
                                </group>
                            </group>
                            <group string="Internal Notes">
                                <field name="notes" placeholder="Notes for administrative use..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_certificate_search" model="ir.ui.view">
        <field name="name">school.certificate.search</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="term"/>
                <field name="academic_year"/>
                <filter name="filter_transcripts" string="Transcripts / Report Cards" domain="[('certificate_type','=','transcript')]"/>
                <filter name="filter_certificates" string="Certificates" domain="[('certificate_type','!=','transcript')]"/>
                <separator/>
                <filter name="filter_pending_print" string="Pending Print Approval" domain="[('print_state','=','pending')]"/>
                <filter name="filter_approved_print" string="Approved to Print" domain="[('print_state','=','approved')]"/>
                <filter name="filter_rejected_print" string="Print Declined" domain="[('print_state','=','rejected')]"/>
                <separator/>
                <filter name="filter_issued" string="Issued" domain="[('status','=','issued')]"/>
                <filter name="filter_draft" string="Draft" domain="[('status','=','draft')]"/>
                <separator/>
                <filter name="filter_honors" string="Distinction / Honors" domain="[('academic_standing','in',['distinction', 'honors'])]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Term" name="group_term" domain="[]" context="{'group_by':'term'}"/>
                <filter string="Academic Standing" name="group_standing" domain="[]" context="{'group_by':'academic_standing'}"/>
                <filter string="Print Status" name="group_print_state" domain="[]" context="{'group_by':'print_state'}"/>
                <filter string="Credential Type" name="group_type" domain="[]" context="{'group_by':'certificate_type'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'academic_year'}"/>
                <filter string="Status" name="group_status" domain="[]" context="{'group_by':'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_certificate" model="ir.actions.act_window">
        <field name="name">Transcripts &amp; Report Cards</field>
        <field name="res_model">school.certificate</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_certificate_search"/>
        <field name="context">{'search_default_filter_transcripts': 1}</field>
    </record>
</odoo>
