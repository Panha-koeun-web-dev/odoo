<odoo>
    <!-- ======================= SERVER ACTION: bulk generate ======================= -->
    <!-- Defined BEFORE the list view so the forward "%(xmlid)d" reference resolves. -->
    <record id="action_generate_certificates_all" model="ir.actions.server">
        <field name="name">Generate Certificates For All Students</field>
        <field name="model_id" ref="model_school_certificate"/>
        <field name="binding_model_id" ref="model_school_certificate"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[(4, ref('school_management.group_school_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.generate_certificates_for_all()</field>
    </record>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_certificate_list" model="ir.ui.view">
        <field name="name">school.certificate.list</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'issued'" decoration-info="status == 'draft'">
                <header>
                    <button name="%(action_generate_certificates_all)d" type="action"
                            string="Generate For All Students" class="btn-primary" icon="fa-magic"
                            display="always" groups="school_management.group_school_admin"/>
                    <button name="action_print_certificate" type="object"
                            string="Print" class="btn-secondary" icon="fa-print" display="always"/>
                </header>
                <field name="name"/>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="certificate_type" widget="badge"/>
                <field name="academic_year"/>
                <field name="study_start_date" optional="show"/>
                <field name="study_end_date" optional="show"/>
                <field name="study_period" optional="hide"/>
                <field name="issue_date"/>
                <field name="template" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_certificate_kanban" model="ir.ui.view">
        <field name="name">school.certificate.kanban</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="certificate_type">
                <field name="name"/>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="certificate_type"/>
                <field name="academic_year"/>
                <field name="issue_date"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <span class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter bg-success">
                                        <i class="fa fa-trophy" title="Certificate"/>
                                    </span>
                                </span>
                                <strong class="o_kanban_record_title">
                                    <field name="student_id"/>
                                    <span class="d-block text-muted small">
                                        <field name="name"/>
                                    </span>
                                </strong>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="text-muted">
                                    <i class="fa fa-id-badge me-1" title="Student ID"/><field name="student_code"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/><field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar me-1" title="Issue date"/><field name="issue_date"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-book me-1" title="Academic year"/><field name="academic_year"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <field name="certificate_type" widget="badge"/>
                                <field name="status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_certificate_form" model="ir.ui.view">
        <field name="name">school.certificate.form</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_certificate" type="object"
                            string="Print Certificate" class="btn-primary" icon="fa-print"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_print_certificate" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print Certificate</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" placeholder="Student"/>
                        </h1>
                        <h4 class="text-muted">
                            Certificate <field name="name" readonly="1"/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Certificate Details">
                            <field name="certificate_type"/>
                            <field name="academic_year"/>
                            <field name="study_start_date" readonly="1"/>
                            <field name="study_end_date" readonly="1"/>
                            <field name="study_period" readonly="1"/>
                            <field name="issue_date"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group string="Student Information">
                            <field name="student_code" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="gender" readonly="1"/>
                            <field name="date_of_birth" readonly="1"/>
                            <field name="age" readonly="1"/>
                            <field name="parent_name" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="average_grade" readonly="1"/>
                            <field name="template"/>
                        </group>
                    </group>
                    <group string="Certificate Content" class="mt-3">
                        <field name="reason" placeholder="Reason or purpose printed on the certificate"/>
                    </group>
                    <group string="Customization" class="mt-3">
                        <group>
                            <field name="custom_title" placeholder="e.g. Certificate of Distinction"/>
                            <field name="custom_prelude" placeholder="e.g. This is to proudly certify that"/>
                            <field name="custom_statement" placeholder="e.g. having successfully completed the requirements of"/>
                        </group>
                        <group>
                            <field name="accent_color" placeholder="e.g. #c2185b"/>
                            <field name="show_avg"/>
                        </group>
                        <group string="Signatures">
                            <field name="signatory_one_name"/>
                            <field name="signatory_one_title"/>
                            <field name="signatory_two_name"/>
                            <field name="signatory_two_title"/>
                        </group>
                    </group>
                    <group string="Notes" class="mt-3">
                        <field name="notes" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_certificate_search" model="ir.ui.view">
        <field name="name">school.certificate.search</field>
        <field name="model">school.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <filter name="filter_issued" string="Issued" domain="[('status','=','issued')]"/>
                <filter name="filter_draft" string="Draft" domain="[('status','=','draft')]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Type" name="group_type" domain="[]" context="{'group_by':'certificate_type'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'academic_year'}"/>
            </search>
        </field>
    </record>

    <record id="action_certificate" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">school.certificate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_certificate_search"/>
    </record>
</odoo>
