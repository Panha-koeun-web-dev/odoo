<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_exam_tree" model="ir.ui.view">
        <field name="name">school.exam.tree</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="exam_type" widget="badge"/>
                <field name="date"/>
                <field name="total_marks"/>
                <field name="passing_marks"/>
            </list>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_exam_form" model="ir.ui.view">
        <field name="name">school.exam.form</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Exam Name"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="exam_type" widget="badge" bg_color="exam_type == 'final' ? 'bg-blue-100 text-blue-800' : exam_type == 'midterm' ? 'bg-indigo-100 text-indigo-800' : exam_type == 'quiz' ? 'bg-yellow-100 text-yellow-800' : 'bg-purple-100 text-purple-800'"/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Exam Details">
                            <field name="subject_id"/>
                            <field name="class_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Marking">
                            <field name="total_marks"/>
                            <field name="passing_marks"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Results" class="mt-3">
                        <field name="grade_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_exam_search" model="ir.ui.view">
        <field name="name">school.exam.search</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <filter name="filter_midterm" string="Midterm" domain="[('exam_type','=','midterm')]"/>
                <filter name="filter_final" string="Final" domain="[('exam_type','=','final')]"/>
                <filter name="filter_quiz" string="Quiz" domain="[('exam_type','=','quiz')]"/>
                <separator/>
                <filter string="Subject" name="group_subject" domain="[]" context="{'group_by':'subject_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Type" name="group_type" domain="[]" context="{'group_by':'exam_type'}"/>
                <filter string="Date" name="group_date" domain="[]" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_exam" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">school.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_exam_search"/>
    </record>
</odoo>
