<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_major_tree" model="ir.ui.view">
        <field name="name">school.major.list</field>
        <field name="model">school.major</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="department"/>
                <field name="duration_years"/>
                <field name="student_count"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_major_kanban" model="ir.ui.view">
        <field name="name">school.major.kanban</field>
        <field name="model">school.major</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="department"/>
                <field name="duration_years"/>
                <field name="student_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <span class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter bg-info">
                                        <i class="fa fa-graduation-cap" title="Major"/>
                                    </span>
                                </span>
                                <div>
                                    <strong class="o_kanban_record_title d-block">
                                        <field name="name"/>
                                    </strong>
                                    <span class="text-muted small"><field name="code"/></span>
                                </div>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="text-muted">
                                    <i class="fa fa-building-o me-1"/><field name="department" placeholder="Department"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-clock-o me-1"/><field name="duration_years"/> years
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <span class="text-muted">
                                    <i class="fa fa-users me-1"/><field name="student_count"/> students
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_major_form" model="ir.ui.view">
        <field name="name">school.major.form</field>
        <field name="model">school.major</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Major Name"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="code" placeholder="Code"/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Major Details">
                            <field name="department"/>
                            <field name="duration_years"/>
                            <field name="active"/>
                        </group>
                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="Students">
                        <div class="mb-2">
                            <button name="action_open_major_students" type="object"
                                    string="View Students" class="btn-link" icon="fa-users"/>
                        </div>
                        <field name="student_ids" readonly="1" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids"/>
                        </page>
                        <page string="Classes" name="classes">
                            <field name="class_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_major_search" model="ir.ui.view">
        <field name="name">school.major.search</field>
        <field name="model">school.major</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="department"/>
                <separator/>
                <filter string="Department" name="group_department" domain="[]" context="{'group_by':'department'}"/>
                <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- ======================= MAJOR ENROLLMENT VIEWS ======================= -->
    <record id="view_major_enrollment_tree" model="ir.ui.view">
        <field name="name">school.major.enrollment.list</field>
        <field name="model">school.major.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="major_id"/>
                <field name="academic_year"/>
                <field name="status" widget="badge"/>
                <field name="enrollment_date"/>
            </list>
        </field>
    </record>

    <record id="view_major_enrollment_form" model="ir.ui.view">
        <field name="name">school.major.enrollment.form</field>
        <field name="model">school.major.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_drop_student" string="Kick Out / Drop" type="object" class="oe_highlight btn-danger" invisible="status != 'enrolled'"/>
                    <button name="action_reenroll_student" string="Re-enroll" type="object" class="oe_highlight btn-success" invisible="status == 'enrolled'"/>
                    <field name="status" widget="statusbar" statusbar_visible="enrolled,completed,dropped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" placeholder="Student" readonly="status != 'enrolled'"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="major_id"/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Enrollment">
                            <field name="student_code" readonly="1"/>
                            <field name="major_id" readonly="status != 'enrolled'"/>
                            <field name="academic_year" readonly="status != 'enrolled'"/>
                            <field name="status" readonly="1"/>
                            <field name="enrollment_date" readonly="status != 'enrolled'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Enrollment notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_major_enrollment_search" model="ir.ui.view">
        <field name="name">school.major.enrollment.search</field>
        <field name="model">school.major.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="major_id"/>
                <field name="academic_year"/>
                <field name="status"/>
                <separator/>
                <filter string="Major" name="group_major" domain="[]" context="{'group_by':'major_id'}"/>
                <filter string="Status" name="group_status" domain="[]" context="{'group_by':'status'}"/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'academic_year'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= ACTIONS ======================= -->
    <record id="action_major" model="ir.actions.act_window">
        <field name="name">Majors</field>
        <field name="res_model">school.major</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_major_search"/>
    </record>

    <record id="action_major_enrollment" model="ir.actions.act_window">
        <field name="name">Major Enrollments</field>
        <field name="res_model">school.major.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_major_enrollment_search"/>
    </record>
</odoo>