<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_enrollment_list" model="ir.ui.view">
        <field name="name">school.enrollment.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments &amp; Weekly Subjects">
                <header>
                    <button name="%(action_enroll_students)d" type="action"
                            string="Enroll Student(s)" class="btn-primary" icon="fa-user-plus" display="always"/>
                    <button name="%(action_school_assign_student_enroll)d" type="action"
                            string="Enroll in Weekly Subjects" class="btn-outline-primary" icon="fa-book" display="always"/>
                </header>
                <field name="student_id"/>
                <field name="student_code" optional="show"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="semester" widget="badge"/>
                <field name="enrollment_date"/>
                <field name="subject_ids" widget="many2many_tags" optional="show"/>
                <field name="student_subject_count" string="Weekly Subjects" widget="badge"
                       decoration-success="student_subject_count &gt; 0"
                       decoration-warning="student_subject_count == 0"/>
                <field name="total_weekly_hours" widget="float_time" string="Target Hours" optional="show"/>
                <field name="scheduled_weekly_hours" widget="float_time" string="Sched Hours" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_enrollment_kanban" model="ir.ui.view">
        <field name="name">school.enrollment.kanban</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="class_id">
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="semester"/>
                <field name="enrollment_date"/>
                <field name="subject_ids"/>
                <field name="student_subject_count"/>
                <field name="total_weekly_hours"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <span class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter bg-primary">
                                        <i class="fa fa-user-plus" title="Enrollment"/>
                                    </span>
                                </span>
                                <strong class="o_kanban_record_title ms-2">
                                    <field name="student_id"/>
                                    <span class="d-block text-muted small">
                                        <field name="student_code"/>
                                    </span>
                                </strong>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/><field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-graduation-cap me-1" title="Academic year"/><field name="academic_year"/>
                                    <span class="ms-1">(<field name="semester"/>)</span>
                                </div>
                                <div t-if="record.subject_ids" class="text-muted mt-1">
                                    <i class="fa fa-book me-1" title="Subjects"/>
                                    <field name="subject_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <span class="badge rounded-pill bg-light text-dark border">
                                    <i class="fa fa-list me-1" title="Weekly Subjects"/> <field name="student_subject_count"/> Weekly Subjects
                                </span>
                                <span class="text-muted small">
                                    <i class="fa fa-clock-o me-1" title="Weekly Hours"/> <field name="total_weekly_hours" widget="float_time"/>/wk
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_enrollment_form" model="ir.ui.view">
        <field name="name">school.enrollment.form</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <form string="Enrollment &amp; Weekly Subjects">
                <header>
                    <button name="action_enroll_weekly_subjects" type="object"
                            string="Enroll in Weekly Subjects" class="btn-primary" icon="fa-plus-circle"/>
                    <button name="action_sync_weekly_subjects" type="object"
                            string="Auto-Sync Weekly Subjects" class="btn-outline-primary" icon="fa-refresh"
                            help="Automatically generate weekly study plans for all assigned subjects."/>
                    <button name="%(action_enroll_students)d" type="action"
                            string="Bulk Enroll Student(s)" class="btn-secondary" icon="fa-user-plus"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_student_subjects" type="object" class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="student_subject_count"/></span>
                                <span class="o_stat_text">Weekly Subjects</span>
                            </div>
                        </button>
                        <button name="action_view_timetable" type="object" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Class Timetable</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="student_id" string="Student Enrollment"/>
                        <h1>
                            <field name="student_id" placeholder="Select Student..."/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="class_id" placeholder="Class..."/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Student Information">
                            <field name="student_code"/>
                            <field name="student_email"/>
                            <field name="student_phone"/>
                        </group>
                        <group string="Academic Placement">
                            <field name="class_id"/>
                            <field name="academic_year"/>
                            <field name="semester" widget="radio"/>
                            <field name="enrollment_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Weekly Study Plan &amp; Subjects" name="weekly_subjects">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">
                                    <i class="fa fa-info-circle me-1" title="Information"/>
                                    Active weekly study subjects, teachers, and timetable scheduling status for this student:
                                </span>
                                <div>
                                    <button name="action_enroll_weekly_subjects" type="object"
                                            string="Configure Weekly Subjects" class="btn btn-sm btn-primary" icon="fa-pencil-square-o"/>
                                    <button name="action_sync_weekly_subjects" type="object"
                                            string="Sync from Curriculum" class="btn btn-sm btn-outline-secondary ms-1" icon="fa-magic"/>
                                </div>
                            </div>
                            <field name="student_subject_ids" readonly="1">
                                <list decoration-success="schedule_status == 'fully_scheduled'"
                                      decoration-warning="schedule_status == 'under_scheduled'"
                                      decoration-danger="schedule_status == 'over_scheduled'">
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="subject_type" widget="badge"
                                           decoration-info="subject_type == 'core'"
                                           decoration-warning="subject_type == 'elective'"
                                           decoration-muted="subject_type == 'extra'"/>
                                    <field name="weekly_hours" widget="float_time"/>
                                    <field name="weekly_sessions"/>
                                    <field name="scheduled_hours" widget="float_time"/>
                                    <field name="schedule_status" widget="badge"
                                           decoration-success="schedule_status == 'fully_scheduled'"
                                           decoration-warning="schedule_status == 'under_scheduled'"
                                           decoration-danger="schedule_status == 'over_scheduled'"
                                           decoration-muted="schedule_status == 'not_scheduled'"/>
                                    <field name="study_status" widget="badge"
                                           decoration-success="study_status == 'active'"
                                           decoration-warning="study_status == 'exempt'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Curriculum Subjects to Learn" name="curriculum">
                            <group>
                                <field name="subject_ids" widget="many2many_tags" placeholder="Choose the subjects this student will learn"/>
                            </group>
                        </page>
                        <page string="Enrollment Notes" name="notes">
                            <field name="notes" placeholder="Enrollment notes, accommodations, or remarks..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_enrollment_search" model="ir.ui.view">
        <field name="name">school.enrollment.search</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="semester"/>

                <separator/>
                <filter name="filter_with_subjects" string="With Subjects" domain="[('subject_ids', '!=', False)]"/>
                <filter name="filter_no_subjects" string="Without Subjects" domain="[('subject_ids', '=', False)]"/>
                <separator/>
                <filter name="filter_s1" string="Semester 1" domain="[('semester','=','1')]"/>
                <filter name="filter_s2" string="Semester 2" domain="[('semester','=','2')]"/>
                <filter name="filter_full" string="Full Year" domain="[('semester','=','full')]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Semester" name="group_semester" domain="[]" context="{'group_by':'semester'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'academic_year'}"/>
            </search>
        </field>
    </record>

    <record id="action_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments &amp; Weekly Subjects</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_enrollment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enroll students and manage their weekly subjects!
            </p>
            <p>
                Manage academic placement, semester curriculum, and weekly study plans in one unified page.
            </p>
        </field>
    </record>
</odoo>
