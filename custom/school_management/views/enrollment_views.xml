<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_enrollment_list" model="ir.ui.view">
        <field name="name">school.enrollment.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="%(action_enroll_students)d" type="action"
                            string="Enroll Student(s)" class="btn-primary" icon="fa-user-plus" display="always"/>
                </header>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="semester" widget="badge"/>
                <field name="enrollment_date"/>
                <field name="subject_ids" widget="many2many_tags"/>

            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_enrollment_kanban" model="ir.ui.view">
        <field name="name">school.enrollment.kanban</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="semester"/>
                <field name="enrollment_date"/>
                <field name="subject_ids"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <span class="o_kanban_avatar">
                                    <span class="o_kanban_avatar_letter bg-primary">
                                        <i class="fa fa-user-plus" title="Enrollment"/>
                                    </span>
                                </span>
                                <strong class="o_kanban_record_title">
                                    <field name="student_id"/>
                                    <span class="d-block text-muted small">
                                        <field name="student_code"/>
                                    </span>
                                </strong>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/><field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-graduation-cap me-1" title="Academic year"/><field name="academic_year"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar-check-o me-1" title="Semester"/><field name="semester"/>
                                </div>
                                <div t-if="record.subject_ids" class="text-muted">
                                    <i class="fa fa-book me-1" title="Subjects"/>
                                    <field name="subject_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <span class="text-muted">
                                    <i class="fa fa-calendar-o me-1" title="Enrollment date"/><field name="enrollment_date"/>
                                </span>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_enrollment_form" model="ir.ui.view">
        <field name="name">school.enrollment.form</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_enroll_students)d" type="action"
                            string="Enroll Student(s)" class="btn-outline-primary" icon="fa-user-plus"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="d-flex justify-content-between">
                            <h1>
                                <field name="student_id" placeholder="Student"/>
                            </h1>

                        </div>
                        <h4 class="text-muted">
                            <field name="class_id" string=""/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group string="Student Information">
                            <field name="student_code"/>
                            <field name="student_email"/>
                            <field name="student_phone"/>
                        </group>
                        <group string="Academic Placement">
                            <field name="class_id"/>
                            <field name="academic_year"/>
                            <field name="semester" widget="radio"/>
                            <field name="enrollment_date"/>
                        </group>
                        <group string="Subjects for this Semester">
                            <field name="subject_ids" widget="many2many_tags" placeholder="Choose the subjects this student will learn"/>
                        </group>
                    </group>
                    <group string="Notes" class="mt-3">
                        <field name="notes" placeholder="Enrollment notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_enrollment_search" model="ir.ui.view">
        <field name="name">school.enrollment.search</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="semester"/>

                <separator/>
                <filter name="filter_s1" string="Semester 1" domain="[('semester','=','1')]"/>
                <filter name="filter_s2" string="Semester 2" domain="[('semester','=','2')]"/>
                <filter name="filter_full" string="Full Year" domain="[('semester','=','full')]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>

                <filter string="Semester" name="group_semester" domain="[]" context="{'group_by':'semester'}"/>
                <filter string="Academic Year" name="group_year" domain="[]" context="{'group_by':'academic_year'}"/>
            </search>
        </field>
    </record>

    <record id="action_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_enrollment_search"/>
    </record>
</odoo>