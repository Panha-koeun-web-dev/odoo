<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================= CALENDAR VIEW ======================= -->
    <record id="view_school_timetable_calendar" model="ir.ui.view">
        <field name="name">school.timetable.calendar</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <calendar string="Timetable Calendar"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="color"
                      mode="week"
                      event_limit="8"
                      scales="day,week,month"
                      quick_create="0"
                      event_open_popup="1">
                <field name="display_name"/>
                <field name="room"/>
                <field name="teacher_id" filters="1"/>
                <field name="class_id" filters="1"/>
                <field name="schedule_status" filters="1"/>
                <field name="term_id" invisible="1"/>
                <field name="day_of_week" invisible="1"/>
                <field name="period" invisible="1"/>
                <field name="subject_id" invisible="1"/>
                <field name="student_id" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_school_timetable_tree" model="ir.ui.view">
        <field name="name">school.timetable.list</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <list string="Class &amp; Student Timetable" sample="1" multi_edit="1" default_order="day_of_week, start_time, class_id"
                  decoration-warning="is_holiday">
                <field name="schedule_status" widget="badge"
                       decoration-warning="schedule_status == 'holiday'"
                       decoration-success="schedule_status == 'regular'"/>
                <field name="is_holiday" widget="boolean_toggle" optional="hide" string="Holiday"/>
                <field name="holiday_name" optional="show" invisible="not is_holiday"/>
                <field name="term_id" widget="badge" optional="show"/>
                <field name="week_name" widget="badge" optional="show"/>
                <field name="day_of_week" widget="badge"
                       decoration-info="day_of_week in ('0', '1', '2')"
                       decoration-primary="day_of_week in ('3', '4')"
                       decoration-warning="day_of_week in ('5', '6')"/>
                <field name="period_short" widget="badge" string="Period"/>
                <field name="time_display" string="Time" decoration-bf="1"/>
                <field name="start_time" widget="float_time" optional="hide"/>
                <field name="end_time" widget="float_time" optional="hide"/>
                <field name="teacher_id" decoration-bf="1" invisible="is_holiday"/>
                <field name="subject_ids" widget="many2many_tags" decoration-bf="1" invisible="is_holiday"/>
                <field name="subject_id" optional="hide"/>
                <field name="class_id"/>
                <field name="student_id" optional="show"/>
                <field name="student_ids" widget="many2many_tags" optional="hide"/>
                <field name="room" optional="show"/>
                <field name="start_datetime" optional="hide"/>
                <field name="end_datetime" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_school_timetable_kanban" model="ir.ui.view">
        <field name="name">school.timetable.kanban</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <kanban class="o_school_timetable_kanban" default_group_by="day_of_week" sample="1">
                <field name="display_name"/>
                <field name="name"/>
                <field name="is_holiday"/>
                <field name="holiday_name"/>
                <field name="schedule_status"/>
                <field name="term_id"/>
                <field name="class_id"/>
                <field name="student_id"/>
                <field name="student_ids"/>
                <field name="subject_id"/>
                <field name="subject_ids"/>
                <field name="subjects_display"/>
                <field name="teacher_id"/>
                <field name="day_of_week"/>
                <field name="period"/>
                <field name="period_short"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="time_display"/>
                <field name="week_name"/>
                <field name="room"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="o_timetable_card flex-column">
                        <!-- Holiday Banner if Holiday -->
                        <div t-if="record.is_holiday.raw_value" role="status" class="alert alert-warning py-1 px-2 mb-2 d-flex align-items-center justify-content-between rounded">
                            <span class="fw-bold">HOLIDAY / NO CLASS</span>
                            <span class="badge bg-warning text-dark"><field name="holiday_name"/></span>
                        </div>

                        <!-- Top Header: Period Pill & Time Range -->
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <span class="badge rounded-pill o_period_badge">
                                <i class="fa fa-calendar-check-o me-1" title="Period"/>
                                <field name="period_short"/>
                            </span>
                            <span class="o_time_badge">
                                <i class="fa fa-clock-o me-1 text-primary" title="Time"/>
                                <field name="time_display"/>
                            </span>
                        </div>

                        <!-- Subject Name: Primary hero title -->
                        <div class="o_timetable_subject mb-2" t-if="!record.is_holiday.raw_value">
                            <i class="fa fa-book text-primary me-2 flex-shrink-0" title="Subject"/>
                            <field name="subjects_display"/>
                        </div>
                        <div class="o_timetable_subject mb-2 text-warning fw-bold" t-else="">
                            <i class="fa fa-sun-o text-warning me-2 flex-shrink-0" title="Holiday"/>
                            <field name="holiday_name"/>
                        </div>

                        <!-- Target Context: Student / Class & Classroom & Term -->
                        <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                            <span t-if="record.term_id.raw_value" class="badge rounded-pill text-bg-light border" title="Term">
                                <i class="fa fa-calendar me-1 text-info" title="Term"/>
                                <field name="term_id"/>
                            </span>
                            <span t-if="record.week_name.raw_value" class="badge rounded-pill text-bg-light border" title="Week">
                                <i class="fa fa-calendar-check-o me-1 text-primary" title="Week"/>
                                <field name="week_name"/>
                            </span>
                            <span t-if="record.student_id.raw_value" class="badge rounded-pill bg-info-subtle text-info border border-info-subtle" title="Student">
                                <i class="fa fa-user me-1" title="Student"/>
                                <field name="student_id"/>
                            </span>
                            <span t-elif="record.class_id.raw_value" class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle" title="Class">
                                <i class="fa fa-graduation-cap me-1" title="Class"/>
                                <field name="class_id"/>
                            </span>
                            <span t-if="record.room.raw_value" class="badge rounded-pill bg-light text-secondary border" title="Room">
                                <i class="fa fa-map-marker text-danger me-1" title="Room"/>
                                <field name="room"/>
                            </span>
                        </div>

                        <!-- Footer: Teacher info & Day Tag -->
                        <div class="o_timetable_footer pt-2 mt-auto d-flex align-items-center justify-content-between text-muted small">
                            <div class="d-flex align-items-center text-truncate me-2" title="Teacher">
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center me-1 flex-shrink-0" style="width: 20px; height: 20px;">
                                    <i class="fa fa-user text-secondary" style="font-size: 10px;" title="Teacher Icon"/>
                                </div>
                                <span class="fw-medium text-dark text-truncate"><field name="teacher_id"/></span>
                            </div>
                            <span class="badge bg-light text-muted border text-nowrap">
                                <field name="day_of_week"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_school_timetable_form" model="ir.ui.view">
        <field name="name">school.timetable.form</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <form string="Timetable Session" class="o_school_form">
                <header>
                    <button name="action_toggle_holiday" type="object"
                            string="Toggle Holiday" class="btn-warning" icon="fa-star"
                            groups="school_management.group_school_admin"/>
                    <button name="action_view_class_students" type="object"
                            string="View Assigned Students" class="btn-outline-primary" icon="fa-users" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_view_teaching_assignments" type="object"
                            string="Teaching Assignments &amp; Load" class="btn-outline-secondary" icon="fa-book"
                            invisible="is_holiday or not teacher_id" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_teacher_request_permission" type="object"
                            string="Request Absence for Session" class="btn-outline-warning" icon="fa-calendar-times-o"
                            invisible="is_holiday"
                            groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_anchor_to_current_week" type="object"
                            string="Re-anchor to Current Week" class="btn-secondary" icon="fa-calendar-check-o"
                            groups="school_management.group_school_admin"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Session / Lesson Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Mathematics - Algebra &amp; Trigonometry"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Session Type &amp; Holiday Status">
                            <field name="is_holiday" widget="boolean_toggle"/>
                            <field name="holiday_name" placeholder="e.g. Khmer New Year, Water Festival" invisible="not is_holiday" required="is_holiday"/>
                        </group>
                        <group string="Academic Assignment &amp; Term" invisible="is_holiday">
                            <field name="term_id" options="{'no_create': True}"/>
                            <field name="week_number"/>
                            <field name="teacher_id" options="{'no_create': True}" required="not is_holiday"/>
                            <field name="subject_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" placeholder="Select one or multiple subjects..." required="not is_holiday"/>
                            <field name="subject_id" invisible="1"/>
                            <field name="subjects_display" invisible="1"/>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="student_id" placeholder="Optional: Specific Student (1-on-1 tutoring / elective)" options="{'no_create': True}"/>
                            <field name="student_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select multiple students (for group study / electives)..."/>
                            <field name="room" placeholder="e.g. Room 101 / Science Lab"/>
                        </group>
                        <group string="Target Class / Scope" invisible="not is_holiday">
                            <field name="term_id" options="{'no_create': True}"/>
                            <field name="week_number"/>
                            <field name="class_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Schedule &amp; Timing">
                            <field name="day_of_week"/>
                            <field name="period"/>
                            <label for="start_time" string="Time Range"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="start_time" widget="float_time" class="oe_inline"/>
                                <span>to</span>
                                <field name="end_time" widget="float_time" class="oe_inline"/>
                            </div>
                            <field name="start_datetime" groups="base.group_no_one"/>
                            <field name="end_datetime" groups="base.group_no_one"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes &amp; Lesson Plan">
                            <field name="notes" placeholder="Add preparation notes, lesson objectives, homework or classroom guidelines here..."/>
                        </page>
                        <page name="students" string="Enrolled / Assigned Students">
                            <field name="student_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="class_id"/>
                                    <field name="study_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_school_timetable_search" model="ir.ui.view">
        <field name="name">school.timetable.search</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="term_id"/>
                <field name="teacher_id"/>
                <field name="student_id"/>
                <field name="student_ids"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="subject_ids"/>
                <field name="room"/>
                <separator/>
                <filter name="filter_active_term" string="Current Active Term" domain="[('term_id.state', '=', 'active')]"/>
                <filter name="filter_term_1" string="Term 1" domain="[('term_id.term_number', '=', 'term_1')]"/>
                <filter name="filter_term_2" string="Term 2" domain="[('term_id.term_number', '=', 'term_2')]"/>
                <filter name="filter_term_3" string="Term 3" domain="[('term_id.term_number', '=', 'term_3')]"/>
                <separator/>
                <filter name="filter_my_class" string="My Class Timetable"
                        domain="['|', ('class_id.student_ids.user_id', '=', uid), ('class_id.teacher_id.user_id', '=', uid)]"/>
                <filter name="filter_my_schedule" string="My Schedule &amp; Class"
                        domain="['|', ('is_holiday', '=', True), '|', '|', '|', '|', ('teacher_id.user_id', '=', uid), ('student_ids.user_id', '=', uid), ('student_id.user_id', '=', uid), ('class_id.teacher_id.user_id', '=', uid), '&amp;', ('class_id.student_ids.user_id', '=', uid), ('student_id', '=', False)]"/>
                <filter name="filter_my_teaching" string="My Teaching Schedule" domain="[('teacher_id.user_id', '=', uid)]"/>
                <filter name="filter_my_timetable" string="My Study Schedule"
                        domain="['|', ('is_holiday', '=', True), '|', '|', ('student_ids.user_id', '=', uid), ('student_id.user_id', '=', uid), '&amp;', ('class_id.student_ids.user_id', '=', uid), ('student_id', '=', False)]"/>
                <separator/>
                <filter name="filter_mon_fri" string="Monday - Friday (Weekdays)" domain="[('day_of_week', 'in', ('0', '1', '2', '3', '4'))]"/>
                <separator/>
                <filter name="filter_holidays" string="Holidays &amp; Days Off" domain="[('is_holiday', '=', True)]"/>
                <filter name="filter_my_holidays" string="My Class &amp; School Holidays"
                        domain="['&amp;', ('is_holiday', '=', True), '|', ('class_id', '=', False), '|', '|', ('class_id.student_ids.user_id', '=', uid), ('class_id.teacher_id.user_id', '=', uid), ('teacher_id.user_id', '=', uid)]"/>
                <filter name="filter_school_holidays" string="School-wide Holidays (All Classes)"
                        domain="[('is_holiday', '=', True), ('class_id', '=', False)]"/>
                <filter name="filter_class_holidays" string="Class-specific Holidays"
                        domain="[('is_holiday', '=', True), ('class_id', '!=', False)]"/>
                <filter name="filter_regular_classes" string="Regular Class Sessions" domain="[('is_holiday', '=', False)]"/>
                <separator/>
                <filter name="filter_week_1" string="Week 1" domain="[('week_number', '=', 1)]"/>
                <filter name="filter_week_2" string="Week 2" domain="[('week_number', '=', 2)]"/>
                <filter name="filter_week_3" string="Week 3" domain="[('week_number', '=', 3)]"/>
                <filter name="filter_week_4" string="Week 4" domain="[('week_number', '=', 4)]"/>
                <filter name="filter_monday" string="Monday" domain="[('day_of_week', '=', '0')]"/>
                <filter name="filter_tuesday" string="Tuesday" domain="[('day_of_week', '=', '1')]"/>
                <filter name="filter_wednesday" string="Wednesday" domain="[('day_of_week', '=', '2')]"/>
                <filter name="filter_thursday" string="Thursday" domain="[('day_of_week', '=', '3')]"/>
                <filter name="filter_friday" string="Friday" domain="[('day_of_week', '=', '4')]"/>
                <filter name="filter_weekend" string="Weekend" domain="[('day_of_week', 'in', ('5', '6'))]"/>
                <separator/>
                <filter name="filter_individual" string="1-on-1 Student Sessions" domain="[('student_id', '!=', False)]"/>
                <filter name="filter_class_sessions" string="Class-wide Sessions" domain="[('student_id', '=', False)]"/>
                <separator/>
                <filter name="filter_morning" string="Morning Sessions" domain="[('start_time', '&lt;', 12.0)]"/>
                <filter name="filter_afternoon" string="Afternoon Sessions" domain="[('start_time', '&gt;=', 12.0)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Academic Term" name="group_term" domain="[]" context="{'group_by': 'term_id'}"/>
                <filter string="Academic Week" name="group_week" domain="[]" context="{'group_by': 'week_name'}"/>
                <filter string="Teacher" name="group_teacher" domain="[]" context="{'group_by': 'teacher_id'}"/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by': 'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by': 'class_id'}"/>
                <filter string="Subject" name="group_subject" domain="[]" context="{'group_by': 'subject_id'}"/>
                <filter string="Session Type (Regular vs Holiday)" name="group_schedule_status" domain="[]" context="{'group_by': 'schedule_status'}"/>
                <filter string="Holiday Name" name="group_holiday_name" domain="[('is_holiday', '=', True)]" context="{'group_by': 'holiday_name'}"/>
                <filter string="Room / Hall" name="group_room" domain="[]" context="{'group_by': 'room'}"/>
                <filter string="Day of Week" name="group_day" domain="[]" context="{'group_by': 'day_of_week'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= ACTIONS ======================= -->
    <record id="action_school_timetable" model="ir.actions.act_window">
        <field name="name">Timetable &amp; Schedule</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_mon_fri': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Timetable session!
            </p>
            <p>
                Manage weekly teaching schedules for classes, subjects, and teachers.
            </p>
        </field>
    </record>

    <!-- Action for Current Student Schedule (My Schedule) -->
    <record id="action_school_my_timetable" model="ir.actions.act_window">
        <field name="name">My Schedule</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_my_schedule': 1, 'search_default_filter_mon_fri': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                View your personal class timetable and study schedule!
            </p>
        </field>
    </record>

    <!-- 1. Master Timetable (Calendar, List, Kanban, Form) -->
    <record id="action_timetable" model="ir.actions.act_window">
        <field name="name">Master Timetable &amp; Schedules</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_mon_fri': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the First Timetable Session!
            </p>
            <p>
                Organize weekly class timetables, teacher schedules, and individual or group study sessions.
            </p>
        </field>
    </record>

    <!-- 2. Teacher Teaching Schedules (Grouped by Teacher) -->
    <record id="action_timetable_teacher" model="ir.actions.act_window">
        <field name="name">Teacher Teaching Schedules</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_group_teacher': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Teacher Teaching Schedules!
            </p>
            <p>
                View and schedule teaching sessions assigned to teachers across all classes and individual students.
            </p>
        </field>
    </record>

    <!-- 3. Student Study Schedules (Grouped by Class) -->
    <record id="action_timetable_student" model="ir.actions.act_window">
        <field name="name">Student Study Schedules</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_mon_fri': 1, 'search_default_group_class': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Student Study Schedules!
            </p>
            <p>
                View and schedule studying sessions for individual students and enrolled classes.
            </p>
        </field>
    </record>

    <!-- 4. Teacher Personal Schedule (My Teaching Schedule) -->
    <record id="action_timetable_my_teaching" model="ir.actions.act_window">
        <field name="name">My Teaching Schedule</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_my_teaching': 1, 'search_default_filter_mon_fri': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                View your personal teaching timetable!
            </p>
        </field>
    </record>

    <!-- 5. My Class Timetable (Integrated for Student & Teacher) -->
    <record id="action_timetable_my_class" model="ir.actions.act_window">
        <field name="name">My Class Timetable &amp; Calendar</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_my_class': 1, 'search_default_filter_mon_fri': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                View your class timetable and weekly calendar!
            </p>
            <p>
                Displays all subjects, teachers, and classroom sessions specifically for your enrolled class.
            </p>
        </field>
    </record>

    <!-- 6. Class & School Holidays Calendar -->
    <record id="action_timetable_holidays" model="ir.actions.act_window">
        <field name="name">Class &amp; School Holidays</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="context">{'search_default_filter_holidays': 1, 'search_default_group_schedule_status': 1, 'default_is_holiday': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No holidays recorded yet!
            </p>
            <p>
                View and manage school-wide and class-specific holidays and days off.
            </p>
        </field>
    </record>

    <!-- 7. My Class & School Holidays -->
    <record id="action_timetable_my_holidays" model="ir.actions.act_window">
        <field name="name">My Class &amp; School Holidays</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
