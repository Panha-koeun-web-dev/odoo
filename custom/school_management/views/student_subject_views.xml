<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_school_student_subject_search" model="ir.ui.view">
        <field name="name">school.student.subject.search</field>
        <field name="model">school.student.subject</field>
        <field name="arch" type="xml">
            <search string="Search Student Weekly Study Subjects">
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Studying" name="status_studying" domain="[('study_status', '=', 'active')]"/>
                <filter string="Core Subjects" name="core" domain="[('subject_type', '=', 'core')]"/>
                <filter string="Elective Courses" name="elective" domain="[('subject_type', '=', 'elective')]"/>
                <filter string="Remedial / Extra" name="extra" domain="[('subject_type', '=', 'extra')]"/>
                <separator/>
                <filter string="Fully Scheduled" name="fully_scheduled" domain="[('schedule_status', '=', 'fully_scheduled')]"/>
                <filter string="Under Scheduled" name="under_scheduled" domain="[('schedule_status', '=', 'under_scheduled')]"/>
                <separator/>
                <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                <filter string="Subject Type" name="group_type" context="{'group_by': 'subject_type'}"/>
                <filter string="Schedule Status" name="group_sched_status" context="{'group_by': 'schedule_status'}"/>
            </search>
        </field>
    </record>

    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_school_student_subject_list" model="ir.ui.view">
        <field name="name">school.student.subject.list</field>
        <field name="model">school.student.subject</field>
        <field name="arch" type="xml">
            <list string="Student Weekly Study Subjects"
                  decoration-success="schedule_status == 'fully_scheduled'"
                  decoration-warning="schedule_status == 'under_scheduled'"
                  decoration-danger="schedule_status == 'over_scheduled'"
                  decoration-muted="study_status == 'exempt'">
                <field name="student_id"/>
                <field name="student_code" optional="show"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="subject_type" widget="badge"
                       decoration-info="subject_type == 'core'"
                       decoration-warning="subject_type == 'elective'"
                       decoration-muted="subject_type == 'extra'"/>
                <field name="weekly_hours" widget="float_time"/>
                <field name="weekly_sessions"/>
                <field name="scheduled_hours" widget="float_time"/>
                <field name="scheduled_sessions"/>
                <field name="schedule_status" widget="badge"
                       decoration-success="schedule_status == 'fully_scheduled'"
                       decoration-warning="schedule_status == 'under_scheduled'"
                       decoration-danger="schedule_status == 'over_scheduled'"
                       decoration-muted="schedule_status == 'not_scheduled'"/>
                <field name="study_status" widget="badge"
                       decoration-success="study_status == 'active'"
                       decoration-warning="study_status == 'exempt'"
                       decoration-info="study_status == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_school_student_subject_kanban" model="ir.ui.view">
        <field name="name">school.student.subject.kanban</field>
        <field name="model">school.student.subject</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="class_id">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="weekly_hours"/>
                <field name="scheduled_hours"/>
                <field name="schedule_status"/>
                <field name="study_status"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="o_kanban_record_title fs-6">
                                <field name="student_id"/>
                            </strong>
                            <field name="schedule_status" widget="badge"
                                   decoration-success="schedule_status == 'fully_scheduled'"
                                   decoration-warning="schedule_status == 'under_scheduled'"
                                   decoration-danger="schedule_status == 'over_scheduled'"
                                   decoration-muted="schedule_status == 'not_scheduled'"/>
                        </div>
                        <div class="text-primary fw-bold mb-1">
                            <i class="fa fa-book me-1" title="Subject"/> <field name="subject_id"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-user-circle-o me-1" title="Teacher"/> Teacher: <field name="teacher_id"/>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span><i class="fa fa-clock-o me-1" title="Study Hours"/> Study: <field name="weekly_hours"/>h/wk</span>
                            <span><i class="fa fa-calendar me-1" title="Scheduled Hours"/> Sched: <field name="scheduled_hours"/>h</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_school_student_subject_form" model="ir.ui.view">
        <field name="name">school.student.subject.form</field>
        <field name="model">school.student.subject</field>
        <field name="arch" type="xml">
            <form string="Student Weekly Study Subject">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_timetable" type="object" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="scheduled_sessions"/></span>
                                <span class="o_stat_text">Timetable Slots</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="display_name" string="Weekly Study Registration"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Student &amp; Subject Details">
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="student_code"/>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="subject_id" options="{'no_create': True}"/>
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="subject_type"/>
                            <field name="study_status" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Weekly Study Workload &amp; Schedule">
                            <field name="weekly_hours" widget="float_time"/>
                            <field name="weekly_sessions"/>
                            <field name="scheduled_hours" widget="float_time" readonly="1"/>
                            <field name="scheduled_sessions" readonly="1"/>
                            <field name="schedule_status" widget="badge"
                                   decoration-success="schedule_status == 'fully_scheduled'"
                                   decoration-warning="schedule_status == 'under_scheduled'"
                                   decoration-danger="schedule_status == 'over_scheduled'"
                                   decoration-muted="schedule_status == 'not_scheduled'"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Learning Goals &amp; Remarks" name="notes">
                            <field name="notes" placeholder="Individual study objectives, tutoring focus, or special requirements..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- ======================= ACTION ======================= -->
    <record id="action_school_student_subject" model="ir.actions.act_window">
        <field name="name">Student Weekly Subjects</field>
        <field name="res_model">school.student.subject</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_school_student_subject_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage weekly study subjects and workload for students!
            </p>
            <p>
                Each student has a weekly study plan specifying required subjects, weekly study hours, assigned teacher, and timetable scheduling status.
            </p>
        </field>
    </record>
</odoo>
