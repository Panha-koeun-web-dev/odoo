<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- SERVER ACTIONS: EXPORT TO XLSX (Contextual Action Menu)          -->
    <!-- ================================================================= -->

    <!-- 1. Fee Invoices: Export to XLSX -->
    <record id="action_server_export_fee_xlsx" model="ir.actions.server">
        <field name="name">Export to XLSX</field>
        <field name="model_id" ref="model_school_fee"/>
        <field name="binding_model_id" ref="model_school_fee"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_export_xlsx()
        </field>
    </record>

