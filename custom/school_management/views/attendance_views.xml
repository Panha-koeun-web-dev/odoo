<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">school.attendance.list</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1" default_order="date desc, student_id"
                  decoration-success="status == 'present'"
                  decoration-danger="status == 'absent'"
                  decoration-warning="status == 'late'"
                  decoration-muted="status == 'excused'">
                <header>
                    <button name="%(school_management.action_daily_attendance_wizard)d" type="action"
                            string="Take Daily Attendance" class="btn-primary" icon="fa-calendar-check-o" display="always" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" class="btn-outline-primary" icon="fa-file-excel-o" display="always" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                </header>
                <field name="date"/>
                <field name="student_code" optional="show"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-danger="status == 'absent'"
                       decoration-warning="status == 'late'"
                       decoration-muted="status == 'excused'"/>
                <field name="notes" placeholder="Remarks or reason..."/>
                <button name="action_set_present" string="Present" type="object" icon="fa-check" class="text-success" invisible="status == 'present'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                <button name="action_set_absent" string="Absent" type="object" icon="fa-times" class="text-danger" invisible="status == 'absent'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                <button name="action_set_late" string="Late" type="object" icon="fa-clock-o" class="text-warning" invisible="status == 'late'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_attendance_kanban" model="ir.ui.view">
        <field name="name">school.attendance.kanban</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <field name="status"/>
                <field name="notes"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="student_id"/></strong>
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/>
                                    <field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar me-1" title="Date"/>
                                    <field name="date"/>
                                </div>
                                <div t-if="record.notes.raw" class="text-muted small">
                                    <i class="fa fa-commenting-o me-1" title="Notes"/>
                                    <field name="notes"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <field name="status" widget="badge"
                                       decoration-success="status == 'present'"
                                       decoration-danger="status == 'absent'"
                                       decoration-warning="status == 'late'"
                                       decoration-muted="status == 'excused'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">school.attendance.form</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(school_management.action_daily_attendance_wizard)d" type="action"
                            string="Take Daily Attendance" class="btn-outline-primary" icon="fa-calendar-check-o" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" class="btn-outline-primary" icon="fa-file-excel-o" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_set_present" string="Set Present" type="object" class="btn-outline-success" invisible="status == 'present'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_set_absent" string="Set Absent" type="object" class="btn-outline-danger" invisible="status == 'absent'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_set_late" string="Set Late" type="object" class="btn-outline-warning" invisible="status == 'late'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <button name="action_set_excused" string="Set Excused" type="object" class="btn-outline-secondary" invisible="status == 'excused'" groups="school_management.group_school_admin,school_management.group_school_teacher"/>
                    <field name="status" widget="statusbar" statusbar_visible="present,absent,late,excused"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" placeholder="Student"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="date"/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group>
                            <field name="student_code"/>
                            <field name="class_id"/>
                        </group>
                        <group string="Notes / Reason">
                            <field name="notes" placeholder="Add any remarks or reason for absence..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_attendance_search" model="ir.ui.view">
        <field name="name">school.attendance.search</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="class_id"/>
                <field name="date"/>
                <filter name="filter_today" string="Today" domain="[('date','=',context_today().strftime('%Y-%m-%d'))]" help="Show today's attendance"/>
                <separator/>
                <filter name="filter_absent" string="Absent" domain="[('status','=','absent')]"/>
                <filter name="filter_present" string="Present" domain="[('status','=','present')]"/>
                <filter name="filter_late" string="Late" domain="[('status','=','late')]"/>
                <filter name="filter_excused" string="Excused" domain="[('status','=','excused')]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Status" name="group_status" domain="[]" context="{'group_by':'status'}"/>
                <filter string="Date" name="group_date" domain="[]" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Attendance Records</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_attendance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records yet!
            </p>
            <p>
                Click <b>Take Daily Attendance</b> to quickly record student attendance for today or any specific date.
            </p>
        </field>
    </record>
</odoo>
