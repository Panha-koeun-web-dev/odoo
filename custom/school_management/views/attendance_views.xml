<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">school.attendance.list</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'present'" decoration-danger="status == 'absent'"
                  decoration-info="status == 'late'" decoration-muted="status == 'excused'">
                <field name="date" optional="show"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="status" widget="badge"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_attendance_kanban" model="ir.ui.view">
        <field name="name">school.attendance.kanban</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <field name="status"/>
                <field name="notes"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="student_id"/></strong>
                                <div class="text-muted">
                                    <i class="fa fa-tags me-1" title="Class"/>
                                    <field name="class_id"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar me-1" title="Date"/>
                                    <field name="date"/>
                                </div>
                                <div t-if="record.notes.raw" class="text-muted small">
                                    <i class="fa fa-commenting-o me-1" title="Notes"/>
                                    <field name="notes"/>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                <field name="status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">school.attendance.form</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" placeholder="Student"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="date"/>
                        </h4>
                    </div>
                    <group class="mt-3">
                        <group>
                            <field name="class_id"/>
                            <field name="status" widget="badge" bg_color="status == 'present' ? 'bg-green-100 text-green-800' : status == 'absent' ? 'bg-red-100 text-red-800' : status == 'late' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-700'"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" placeholder="Add any remarks..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_attendance_search" model="ir.ui.view">
        <field name="name">school.attendance.search</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <filter name="filter_today" string="Today" domain="[('date','=',context_today().strftime('%Y-%m-%d'))]" help="Show today's attendance"/>
                <separator/>
                <filter name="filter_present" string="Present" domain="[('status','=','present')]"/>
                <filter name="filter_absent" string="Absent" domain="[('status','=','absent')]"/>
                <filter name="filter_late" string="Late" domain="[('status','=','late')]"/>
                <separator/>
                <filter string="Student" name="group_student" domain="[]" context="{'group_by':'student_id'}"/>
                <filter string="Class" name="group_class" domain="[]" context="{'group_by':'class_id'}"/>
                <filter string="Status" name="group_status" domain="[]" context="{'group_by':'status'}"/>
                <filter string="Date" name="group_date" domain="[]" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_attendance_search"/>
    </record>
</odoo>
