<odoo>
    <!-- ======================= LIST VIEW ======================= -->
    <record id="view_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="employee_id"/>
                <field name="photo" widget="image" class="o_image_64_cover" options="{'no_attachment_counter': True}"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gender" widget="badge"/>
                <field name="hire_date" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======================= KANBAN VIEW ======================= -->
    <record id="view_teacher_kanban" model="ir.ui.view">
        <field name="name">school.teacher.kanban</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <kanban class="o_school_kanban">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="photo"/>
                <field name="gender"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="hire_date"/>
                <field name="subject_ids"/>
                <field name="active"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <aside class="o_kanban_aside_full">
                            <t t-if="record.photo.raw_value">
                                <field name="photo" class="o_kanban_image_fill w-100 h-100" widget="image" options="{'zoom': true, 'zoom_delay': 1000, 'img_class': 'object-fit-cover w-100 h-100'}" alt="Teacher Photo"/>
                            </t>
                            <div t-else="" class="d-flex align-items-center justify-content-center bg-100 bg-gradient h-100 text-muted">
                                <svg class="w-50 h-50 opacity-50" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <g fill="currentColor">
                                        <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                        <circle cx="10" cy="5.5" r="4.5"/>
                                    </g>
                                </svg>
                            </div>
                        </aside>
                        <main class="ms-2 flex-grow-1 d-flex flex-column justify-content-between py-1">
                            <div>
                                <div class="d-flex align-items-start justify-content-between gap-1 mb-1">
                                    <field class="fw-bold fs-5 text-truncate mb-0" name="name" placeholder="Teacher's Name"/>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        <i class="fa fa-id-badge me-1" title="Employee ID"/>
                                        <field name="employee_id"/>
                                    </span>
                                </div>
                                <div class="text-muted d-flex align-items-center flex-wrap gap-1 mb-2">
                                    <field name="gender" widget="badge"
                                           decoration-info="gender == 'male'"
                                           decoration-danger="gender == 'female'"/>
                                </div>
                                <div t-if="record.email.raw_value" class="text-truncate text-muted small mb-1">
                                    <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                                    <field name="email"/>
                                </div>
                                <div t-if="record.phone.raw_value" class="text-truncate text-muted small mb-1">
                                    <i class="fa fa-fw me-2 fa-phone text-primary" title="Phone"/>
                                    <field name="phone"/>
                                </div>
                                <div t-if="record.hire_date.raw_value" class="text-truncate text-muted small mb-1">
                                    <i class="fa fa-fw me-2 fa-briefcase text-primary" title="Hire Date"/>
                                    <span>Hired: </span><field name="hire_date"/>
                                </div>
                            </div>
                            <footer class="pt-2 mt-2 border-top d-flex align-items-center justify-content-between gap-1">
                                <div class="d-flex flex-wrap align-items-center gap-1">
                                    <field name="subject_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================= FORM VIEW ======================= -->
    <record id="view_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form class="o_school_form">
                <header>
                    <button name="action_create_user" type="object"
                            string="Create Login Account" class="btn-primary" icon="fa-user-plus"
                            invisible="user_id"
                            groups="school_management.group_school_admin"/>
                    <button name="action_reset_user_password" type="object"
                            string="Reset Password" class="btn-secondary" icon="fa-key"
                            invisible="not user_id"
                            groups="school_management.group_school_admin"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_classes" type="object" class="oe_stat_button" icon="fa-university">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="class_count"/></span>
                                <span class="o_stat_text">Classes</span>
                            </div>
                        </button>
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="student_count"/></span>
                                <span class="o_stat_text">Students</span>
                            </div>
                        </button>
                    </div>

                    <!-- Hero Header Profile (Styled like Odoo Employee Form View) -->
                    <div class="d-flex flex-column flex-sm-row align-items-center mb-3">
                        <div class="o_school_avatar ms-2 p-0">
                            <field name="photo" widget="image" class="m-0" options="{'size': [128, 158], 'zoom': true, 'preview_image': 'photo', 'img_class': 'border rounded-3 h-100 object-fit-cover'}"/>
                        </div>
                        <div class="col-12 col-sm-6 col-md-7 col-lg-8 px-4 o_school_hero_title">
                            <div class="oe_title mw-100 ps-0 pe-sm-2">
                                <h1 class="d-flex flex-row align-items-center mb-1">
                                    <field name="name" placeholder="Teacher's Name" required="True" style="font-size: min(4vw, 2.4rem); font-weight: 700;"/>
                                </h1>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                        <i class="fa fa-id-badge me-1" title="Employee ID"/>ID: <field name="employee_id" class="d-inline fw-semibold"/>
                                    </span>
                                    <field name="gender" widget="badge"
                                           decoration-info="gender == 'male'"
                                           decoration-danger="gender == 'female'"/>
                                </div>
                                <h5 class="d-flex align-items-baseline mb-1 o_school_quick_info">
                                    <i class="fa fa-envelope fa-fw me-2 text-primary" title="Work Email"/>
                                    <field name="email" widget="email" placeholder="e.g. teacher@school.edu" class="w-100 w-sm-75"/>
                                </h5>
                                <h5 class="d-flex align-items-baseline mb-1 o_school_quick_info">
                                    <i class="fa fa-phone fa-fw me-2 text-primary" title="Phone"/>
                                    <field name="phone" widget="phone" placeholder="e.g. +1 555-0199" class="w-100 w-sm-75"/>
                                </h5>
                                <h5 class="d-flex align-items-baseline mb-0 o_school_quick_info" invisible="not hire_date">
                                    <i class="fa fa-calendar-check-o fa-fw me-2 text-primary" title="Hire Date"/>
                                    <span>Hired: </span><field name="hire_date" class="ms-1"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page name="teaching" string="Work &amp; Teaching">
                            <div class="row">
                                <div class="col-lg-6">
                                    <group string="Employment Details">
                                        <field name="employee_id" readonly="1"/>
                                        <field name="hire_date"/>
                                        <field name="subject_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        <field name="user_id" string="User Account" groups="school_management.group_school_admin"/>
                                        <field name="active"/>
                                    </group>
                                </div>
                                <div class="col-lg-6">
                                    <group string="Assigned Classes">
                                        <field name="class_ids" nolabel="1" readonly="1">
                                            <list>
                                                <field name="name"/>
                                                <field name="room"/>
                                                <field name="capacity"/>
                                                <field name="student_count"/>
                                            </list>
                                        </field>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <page name="personal" string="Personal Information">
                            <group string="Personal Details">
                                <group>
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                </group>
                                <group>
                                    <field name="phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                            </group>
                        </page>

                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional notes about teacher..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- ======================= SEARCH VIEW ======================= -->
    <record id="view_teacher_search" model="ir.ui.view">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="email"/>
                <filter name="filter_male" string="Male" domain="[('gender','=','male')]"/>
                <filter name="filter_female" string="Female" domain="[('gender','=','female')]"/>
                <separator/>
                <filter string="Gender" name="group_gender" domain="[]" context="{'group_by':'gender'}"/>
                <filter string="Hire Date" name="group_hire" domain="[]" context="{'group_by':'hire_date'}"/>
                <filter string="Subject" name="group_subject" domain="[]" context="{'group_by':'subject_ids'}"/>
            </search>
        </field>
    </record>

    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_teacher_search"/>
    </record>
</odoo>
