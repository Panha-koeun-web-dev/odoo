<odoo>
    <record id="view_material_assignment_wizard_form" model="ir.ui.view">
        <field name="name">school.material.assignment.wizard.form</field>
        <field name="model">school.material.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Books and Materials">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Select several books or materials for this student. Only materials linked to the student's active subjects are available.
                    </div>
                    <group>
                        <field name="student_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="subject_id"/>
                            <field name="product_id" domain="[('school_material', '=', True), ('school_subject_ids', 'in', subject_id)]"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_assignment" type="object" string="Create Assignment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
