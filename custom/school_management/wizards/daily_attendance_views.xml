<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_attendance_wizard_form" model="ir.ui.view">
        <field name="name">school.daily.attendance.wizard.form</field>
        <field name="model">school.daily.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Take Daily Attendance">
                <sheet>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <group>
                                <field name="date"/>
                                <field name="class_id" placeholder="All Classes"/>
                            </group>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-end gap-2 mt-3">
                                <button name="action_mark_all_present" type="object" string="Mark All Present" class="btn btn-outline-success btn-sm" icon="fa-check"/>
                                <button name="action_mark_all_absent" type="object" string="Mark All Absent" class="btn btn-outline-danger btn-sm" icon="fa-times"/>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <span class="badge bg-light text-dark border">Total: <field name="total_students"/></span>
                                <span class="badge bg-success text-white">Present: <field name="present_count"/></span>
                                <span class="badge bg-danger text-white">Absent: <field name="absent_count"/></span>
                                <span class="badge bg-warning text-dark">Late: <field name="late_count"/></span>
                                <span class="badge bg-secondary text-white">Excused: <field name="excused_count"/></span>
                            </div>
                        </div>
                    </div>

                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="status == 'present'"
                              decoration-danger="status == 'absent'"
                              decoration-warning="status == 'late'"
                              decoration-muted="status == 'excused'">
                            <field name="student_code" optional="show" readonly="1" force_save="1"/>
                            <field name="student_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                            <field name="class_id" optional="show" readonly="1" force_save="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'present'"
                                   decoration-danger="status == 'absent'"
                                   decoration-warning="status == 'late'"
                                   decoration-muted="status == 'excused'"/>
                            <field name="notes" placeholder="Notes (e.g. sick leave, late 15m)..."/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_attendance" string="Save Attendance" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Take Daily Attendance</field>
        <field name="res_model">school.daily.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
