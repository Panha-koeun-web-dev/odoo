<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_certificate_reject_wizard_form" model="ir.ui.view">
        <field name="name">school.certificate.reject.wizard.form</field>
        <field name="model">school.certificate.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Decline Print Request">
                <div class="alert alert-warning mb-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    You are declining this student's request to print their transcript or certificate. Please provide a clear explanation below.
                </div>
                <group>
                    <field name="certificate_id" invisible="1"/>
                    <field name="student_id" readonly="1"/>
                    <field name="certificate_type" readonly="1" widget="badge"/>
                </group>
                <group string="Reason for Refusal">
                    <field name="rejection_reason"
                           placeholder="Specify reason for refusal (e.g., Unsettled tuition fees, pending grade verification, teacher consultation required)..."
                           nolabel="1"
                           required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
