<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================= STOP STUDY WIZARD FORM ======================= -->
    <record id="view_school_student_stop_wizard_form" model="ir.ui.view">
        <field name="name">school.student.stop.wizard.form</field>
        <field name="model">school.student.stop.wizard</field>
        <field name="arch" type="xml">
            <form string="Stop Student Study">
                <div class="alert alert-warning mb-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                    Stopping this student will change their status to <strong>Stopped Studying</strong> and exclude them from daily attendance taking. You can resume their studies anytime using the <strong>Continue Study</strong> button.
                </div>
                <group>
                    <field name="student_id" readonly="1"/>
                    <field name="stop_date"/>
                    <field name="reason_type"/>
                    <field name="stop_reason" placeholder="Provide reason or remarks for stopping study / kicking student..."/>
                </group>
                <footer>
                    <button string="Confirm Stop Study" name="action_confirm_stop" type="object" class="btn-outline-danger" icon="fa-ban"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
