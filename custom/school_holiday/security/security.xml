<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_school_holiday_user" model="res.groups">
        <field name="name">School Holiday / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_school_holiday_manager" model="res.groups">
        <field name="name">School Holiday / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_school_holiday_user')), (4, ref('school_management.group_school_admin'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- MULTI-COMPANY RECORD RULES -->
    <record id="rule_school_public_holiday_multicompany" model="ir.rule">
        <field name="name">School Public Holiday Multi-Company</field>
        <field name="model_id" ref="model_school_public_holiday"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
