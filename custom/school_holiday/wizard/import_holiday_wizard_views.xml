<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_school_holiday_wizard" model="ir.ui.view">

        <field name="name">
            school.import.holiday.wizard.form
        </field>

        <field name="model">
            school.import.holiday.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Import Public Holidays">

                <group>

                    <field name="file"/>

                    <field name="filename"
                           invisible="1"/>

                    <field name="import_mode"/>

                </group>

                <separator string="CSV Format"/>

                <div class="alert alert-info">

                    <p>
                        Your CSV file should contain these columns:
                    </p>

                    <p>
                        <strong>
                            name,date,end_date,holiday_type,description
                        </strong>
                    </p>

                    <p>
                        Example:
                    </p>

                    <p>
                        Khmer New Year,2026-04-14,2026-04-16,national,Khmer New Year
                    </p>

                </div>

                <footer>

                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <record id="action_import_school_holiday_wizard"
            model="ir.actions.act_window">

        <field name="name">
            Import Public Holidays
        </field>

        <field name="res_model">
            school.import.holiday.wizard
        </field>

        <field name="view_mode">
            form
        </field>

        <field name="target">
            new
        </field>

    </record>


</odoo>