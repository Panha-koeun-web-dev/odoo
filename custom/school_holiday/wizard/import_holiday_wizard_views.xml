<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_school_holiday_wizard" model="ir.ui.view">
        <field name="name">school.import.holiday.wizard.form</field>
        <field name="model">school.import.holiday.wizard</field>
        <field name="arch" type="xml">
            <form string="Import School Public Holidays">
                <sheet>
                    <group>
                        <group>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="import_mode" widget="radio"/>
                        </group>
                        <group>
                            <field name="auto_reschedule"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_import"
                            string="Import &amp; Validate Schedules"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_school_holiday_wizard" model="ir.actions.act_window">
        <field name="name">Import Public Holidays</field>
        <field name="res_model">school.import.holiday.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
